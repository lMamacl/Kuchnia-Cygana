@using KuchniaUCygana.Domain.Constants
@model KuchniaUCygana.Web.Models.LoginViewModel
@{
    ViewData["Title"] = "Logowanie pracownika";
}

<style>
    .staff-dev-login {
        min-height: 70vh;
    }

    .staff-dev-card {
        border: 1px solid rgba(23, 33, 27, .12);
        border-radius: 18px;
        background: #fff;
        box-shadow: 0 20px 55px rgba(23, 33, 27, .12);
    }

    .staff-role-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
        gap: .75rem;
    }
</style>

<div class="staff-dev-login d-flex align-items-center py-4">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-8 col-xl-7">
                <div class="staff-dev-card p-4 p-md-5">
                    <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
                        <span class="badge text-bg-warning">DEV</span>
                        <span class="fw-semibold text-uppercase small text-muted">Panel pracowniczy</span>
                    </div>
                    <h1 class="h3 fw-bold mb-2">Logowanie testowe pracownika</h1>
                    <p class="text-muted mb-4">Ten ekran jest dostępny tylko w środowisku Development.</p>

                    <div class="staff-role-grid">
                        @foreach (var role in AppRoles.StaffRoleNames)
                        {
                            <form asp-action="DevLogin" method="post" asp-route-returnUrl="@Model.ReturnUrl">
                                <input type="hidden" name="role" value="@role" />
                                <button type="submit" class="btn btn-outline-dark w-100">@role</button>
                            </form>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
