@model KuchniaUCygana.Web.Models.LoginViewModel
@{
    ViewData["Title"] = "Logowanie pracownika";
}

<style>
    .staff-dev-login {
        min-height: 70vh;
    }

    .staff-dev-card {
        border: 1px solid rgba(23, 33, 27, .12);
        border-radius: 18px;
        background: #fff;
        box-shadow: 0 20px 55px rgba(23, 33, 27, .12);
    }
</style>

<div class="staff-dev-login d-flex align-items-center py-4">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-6 col-xl-5">
                <div class="staff-dev-card p-4 p-md-5">
                    <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
                        <span class="badge text-bg-warning">DEV</span>
                        <span class="fw-semibold text-uppercase small text-muted">Panel pracowniczy</span>
                    </div>
                    <h1 class="h3 fw-bold mb-2">Logowanie pracownika</h1>
                    <p class="text-muted mb-4">Uzyj seedowanego konta i hasla. Ten ekran nie omija weryfikacji.</p>

                    <form asp-action="Login" method="post" asp-route-returnUrl="@Model.ReturnUrl">
                        <input type="hidden" asp-for="ReturnUrl" />
                        <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="Email" class="form-label">Adres email</label>
                            <input asp-for="Email" class="form-control" placeholder="admin@kuchnia.local" autocomplete="username" required />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Password" class="form-label">Haslo</label>
                            <input asp-for="Password" class="form-control" type="password" placeholder="********" autocomplete="current-password" required />
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>

                        <button type="submit" class="btn btn-dark w-100 py-2">Zaloguj sie</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
