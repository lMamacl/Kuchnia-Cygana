@model KuchniaUCygana.Web.Models.RegisterViewModel
@{
    ViewData["Title"] = "Rejestracja";
}

<style>
    .register-shell {
        min-height: 74vh;
        color: #17211b;
    }

    .register-card {
        overflow: hidden;
        border: 1px solid rgba(23, 33, 27, .1);
        border-radius: 26px;
        background: #fff;
        box-shadow: 0 24px 70px rgba(23, 33, 27, .12);
    }

    .register-card .form-control {
        min-height: 48px;
        border-radius: 14px;
        border-color: rgba(23, 33, 27, .14);
    }

    .register-card .form-control:focus {
        border-color: #1f7a4d;
        box-shadow: 0 0 0 .2rem rgba(31, 122, 77, .12);
    }

    .register-aside {
        min-height: 100%;
        background:
            linear-gradient(145deg, rgba(31, 122, 77, .92), rgba(23, 33, 27, .92)),
            url('@Url.Content("~/img/blueberry_cheesecake.png")') center/cover;
        color: #fff;
    }

    .register-kicker {
        color: rgba(255, 255, 255, .72);
        font-size: .75rem;
        font-weight: 800;
        letter-spacing: .08em;
        text-transform: uppercase;
    }

    .btn-register {
        border: 0;
        border-radius: 14px;
        background: #1f7a4d;
        color: #fff;
        box-shadow: 0 14px 26px rgba(31, 122, 77, .22);
    }

    .btn-register:hover {
        background: #17623d;
        color: #fff;
    }
</style>

<div class="register-shell d-flex align-items-center py-4">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-xl-10">
                <div class="register-card">
                    <div class="row g-0">
                        <div class="col-lg-5 d-none d-lg-block">
                            <div class="register-aside p-5 h-100 d-flex flex-column justify-content-between">
                                <div>
                                    <div class="register-kicker mb-3">Nowe konto</div>
                                    <h1 class="display-6 fw-bold mb-3">Zamawianie zaczyna się od profilu.</h1>
                                    <p class="opacity-75 mb-0">
                                        Konto pozwoli zapisać adresy, wrócić do płatności i śledzić dostawy.
                                    </p>
                                </div>
                                <div class="border-top border-light border-opacity-25 pt-4 small opacity-75">
                                    Po rejestracji dodasz adres i przejdziesz przez koszyk oraz checkout.
                                </div>
                            </div>
                        </div>

                        <div class="col-lg-7">
                            <div class="p-4 p-md-5">
                                <div class="mb-4">
                                    <div class="text-success small fw-bold text-uppercase mb-2">Kuchnia u Cygana</div>
                                    <h2 class="fw-bold mb-1">Załóż konto</h2>
                                    <p class="text-muted mb-0">Wypełnij podstawowe dane, żeby zamawiać diety online.</p>
                                </div>

                                <form asp-action="Register" method="post">
                                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>

                                    <div class="row">
                                        <div class="col-md-6 mb-3">
                                            <label asp-for="FirstName" class="form-label fw-semibold">Imię</label>
                                            <input asp-for="FirstName" class="form-control" autocomplete="given-name" />
                                            <span asp-validation-for="FirstName" class="text-danger small"></span>
                                        </div>
                                        <div class="col-md-6 mb-3">
                                            <label asp-for="LastName" class="form-label fw-semibold">Nazwisko</label>
                                            <input asp-for="LastName" class="form-control" autocomplete="family-name" />
                                            <span asp-validation-for="LastName" class="text-danger small"></span>
                                        </div>
                                    </div>

                                    <div class="mb-3">
                                        <label asp-for="Email" class="form-label fw-semibold">Adres e-mail</label>
                                        <input asp-for="Email" class="form-control" autocomplete="email" placeholder="nazwa@example.com" />
                                        <span asp-validation-for="Email" class="text-danger small"></span>
                                    </div>

                                    <div class="mb-4">
                                        <label asp-for="Password" class="form-label fw-semibold">Hasło</label>
                                        <input asp-for="Password" type="password" class="form-control" autocomplete="new-password" placeholder="Minimum 6 znaków" />
                                        <span asp-validation-for="Password" class="text-danger small"></span>
                                    </div>

                                    <button type="submit" class="btn btn-register btn-lg w-100">Załóż konto</button>
                                </form>

                                <hr class="my-4" />
                                <p class="text-center mb-0 small">
                                    Masz już konto?
                                    <a asp-action="Login" class="fw-semibold text-success">Zaloguj się</a>
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
