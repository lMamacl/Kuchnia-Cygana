@model KuchniaUCygana.Web.Models.LoginViewModel
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment Env
@{
    ViewData["Title"] = "Zaloguj sie";
}

<div class="row justify-content-center align-items-center" style="min-height: 70vh;">
    <div class="col-md-6 col-lg-5">
        <div class="card shadow-sm border-0">
            <div class="card-body p-5">
                <div class="text-center mb-4">
                    <h2 class="fw-bold">Logowanie</h2>
                    <p class="text-muted">Wpisz dane konta, aby wejsc do systemu.</p>
                </div>

                <form asp-action="Login" method="post" asp-route-returnUrl="@Model.ReturnUrl">
                    <input type="hidden" asp-for="ReturnUrl" />
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label">Adres email</label>
                        <input asp-for="Email" class="form-control" placeholder="nazwa@kuchnia.local" autocomplete="username" required />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Password" class="form-label">Haslo</label>
                        <input asp-for="Password" class="form-control" type="password" placeholder="********" autocomplete="current-password" required />
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 py-2 mb-3">Zaloguj sie</button>
                </form>

                @if (Env.IsDevelopment())
                {
                    var devRoles = new[]
                    {
                        ("Admin", "Administrator"),
                        ("KitchenManager", "Szef kuchni"),
                        ("Kitchen", "Kucharz"),
                        ("WarehouseManager", "Kierownik magazynu"),
                        ("Warehouse", "Magazynier"),
                        ("PackingManager", "Kierownik kompletacji"),
                        ("Packing", "Pakowacz"),
                        ("Dietitian", "Dietetyk"),
                        ("LogisticsManager", "Kierownik logistyki"),
                        ("Logistics", "Logistyk"),
                        ("Driver", "Kierowca"),
                        ("HRManager", "Kierownik HR"),
                        ("HR", "HR"),
                        ("BOKManager", "Kierownik BOK"),
                        ("BOK", "BOK"),
                    };

                    <hr class="my-4" />
                    <div class="developer-bypass-panel text-center">
                        <h5 class="text-warning fw-bold mb-3">
                            <span class="badge bg-warning text-dark me-2">DEV</span> Logowanie testowe
                        </h5>
                        <div class="d-flex flex-wrap justify-content-center gap-2">
                            @foreach (var (role, label) in devRoles)
                            {
                                <form asp-action="DevLogin" method="post" asp-route-returnUrl="@Model.ReturnUrl">
                                    <input type="hidden" name="role" value="@role" />
                                    <button type="submit" class="btn btn-sm btn-outline-secondary">@label</button>
                                </form>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
