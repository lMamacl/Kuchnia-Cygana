@model AdminDashboardViewModel
@{
    Layout = "_LayoutStaff";

    var logs = Model.SystemLogs
        .OrderByDescending(x => x.Timestamp)
        .ToArray();
}

<div class="card">
    <div class="card-header">
        <h3 class="card-title">Logi systemowe</h3>
    </div>
    <div class="table-responsive">
        <table class="table table-vcenter card-table">
            <thead>
                <tr>
                    <th>Czas</th>
                    <th>Uzytkownik</th>
                    <th>Akcja</th>
                    <th>Obiekt</th>
                    <th>Stara wartosc</th>
                    <th>Nowa wartosc</th>
                    <th>IP</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var log in logs)
                {
                    var oldValue = string.IsNullOrWhiteSpace(log.OldValue) ? "-" : log.OldValue;
                    var newValue = string.IsNullOrWhiteSpace(log.NewValue) ? "-" : log.NewValue;
                    <tr>
                        <td>@log.Timestamp.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                        <td>@(log.UserFullName ?? $"#{log.UserId}")</td>
                        <td>@log.Action</td>
                        <td>@log.TargetEntity #@log.TargetId</td>
                        <td class="text-secondary">@oldValue</td>
                        <td class="text-secondary">@newValue</td>
                        <td class="text-secondary">@(log.IPAddress ?? "-")</td>
                    </tr>
                }
                @if (logs.Length == 0)
                {
                    <tr>
                        <td colspan="7" class="text-secondary text-center py-4">Brak zapisanych logow systemowych.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
