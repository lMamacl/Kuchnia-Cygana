@model AdminDashboardViewModel
@{
    Layout = "_LayoutStaff";

    var roles = Model.AvailableRoles.OrderBy(role => role).ToArray();
    var usersPage = Model.UsersPage;
    var users = usersPage.Items;

    string NameOrEmail(KuchniaUCygana.Application.DTOs.UserDto user)
    {
        return string.IsNullOrWhiteSpace(user.FullName) ? user.Email : user.FullName;
    }
}

<div class="row row-cards">
    <div class="col-12">
        <div class="card">
            <div class="card-header d-flex flex-wrap align-items-center justify-content-between gap-2">
                <h3 class="card-title">Uzytkownicy</h3>
                <div class="d-flex flex-wrap align-items-center gap-2">
                    <span class="text-secondary small">Pokazuje @usersPage.FirstItem-@usersPage.LastItem z @usersPage.TotalCount</span>
                    <a class="btn btn-primary btn-sm" asp-controller="Admin" asp-action="NewUser">Nowy uzytkownik</a>
                </div>
            </div>
            <div class="table-responsive">
                <table class="table table-vcenter card-table">
                    <thead>
                        <tr>
                            <th>Konto</th>
                            <th>Rola</th>
                            <th>Edycja</th>
                            <th>Haslo</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in users)
                        {
                            <tr>
                                <td>
                                    <div class="fw-semibold">@NameOrEmail(user)</div>
                                    <div class="text-secondary small">@user.Email</div>
                                </td>
                                <td>
                                    <span class="badge bg-blue-lt text-blue">@user.Role</span>
                                </td>
                                <td style="min-width: 360px;">
                                    <form class="row g-2 align-items-end" method="post" asp-controller="Admin" asp-action="UpdateUser" asp-route-id="@user.Id">
                                        <input type="hidden" name="Id" value="@user.Id" />
                                        <div class="col-md-6">
                                            <label class="form-label small" for="FirstName_@user.Id">Imie</label>
                                            <input class="form-control form-control-sm" id="FirstName_@user.Id" name="FirstName" value="@user.FirstName" />
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label small" for="LastName_@user.Id">Nazwisko</label>
                                            <input class="form-control form-control-sm" id="LastName_@user.Id" name="LastName" value="@user.LastName" />
                                        </div>
                                        <div class="col-md-7">
                                            <label class="form-label small" for="Email_@user.Id">Email</label>
                                            <input class="form-control form-control-sm" id="Email_@user.Id" name="Email" type="email" value="@user.Email" required />
                                        </div>
                                        <div class="col-md-5">
                                            <label class="form-label small" for="Role_@user.Id">Rola</label>
                                            <select class="form-select form-select-sm" id="Role_@user.Id" name="Role" required>
                                                @foreach (var role in roles)
                                                {
                                                    <option value="@role" selected="@(role == user.Role)">@role</option>
                                                }
                                            </select>
                                        </div>
                                        <div class="col-12 text-end">
                                            <button class="btn btn-sm btn-outline-primary" type="submit">Zapisz</button>
                                        </div>
                                    </form>
                                </td>
                                <td style="min-width: 210px;">
                                    <form class="d-flex gap-2" method="post" asp-controller="Admin" asp-action="ResetUserPassword" asp-route-id="@user.Id">
                                        <input type="hidden" name="Id" value="@user.Id" />
                                        <input class="form-control form-control-sm" name="NewPassword" type="password" minlength="6" autocomplete="new-password" placeholder="Nowe haslo" required />
                                        <button class="btn btn-sm btn-outline-secondary" type="submit">Reset</button>
                                    </form>
                                </td>
                                <td class="text-end">
                                    <form method="post" asp-controller="Admin" asp-action="DeleteUser" asp-route-id="@user.Id">
                                        <button class="btn btn-sm btn-outline-danger" type="submit" onclick="return confirm('Usunac to konto?');">Usun</button>
                                    </form>
                                </td>
                            </tr>
                        }
                        @if (usersPage.TotalCount == 0)
                        {
                            <tr>
                                <td colspan="5" class="text-secondary text-center py-4">
                                    Brak kont uzytkownikow. Seeder tworzy podstawowe konta dla HR, BOK, Admin i pozostalych rol.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            @if (usersPage.TotalCount > 0)
            {
                <div class="card-footer d-flex flex-wrap align-items-center justify-content-between gap-2">
                    <span class="text-secondary small">Strona @usersPage.Page / @usersPage.TotalPages, po @usersPage.PageSize rekordow</span>
                    <div class="btn-list">
                        <a class="btn btn-outline-secondary @(usersPage.HasPrevious ? string.Empty : "disabled")"
                           asp-controller="Admin"
                           asp-action="Users"
                           asp-route-page="@usersPage.PreviousPage"
                           asp-route-pageSize="@usersPage.PageSize">Poprzednia</a>
                        <a class="btn btn-outline-secondary @(usersPage.HasNext ? string.Empty : "disabled")"
                           asp-controller="Admin"
                           asp-action="Users"
                           asp-route-page="@usersPage.NextPage"
                           asp-route-pageSize="@usersPage.PageSize">Nastepna</a>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

