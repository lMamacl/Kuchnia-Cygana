@model KuchniaUCygana.Web.Models.PackingDeliveryViewModel
@{
    Layout = "_LayoutStaff";
    ViewData["Title"] = "Dostawa do auta";
    ViewData["Section"] = "Pakowanie";
    ViewData["Description"] = "Manifest, etykiety transportowe i załadunek całej dostawy.";

    var route = Model.Route;
    var selectedDate = Model.SelectedDate;
    var manifest = Model.Manifest;
    var manifestColor = route.IsManifestVerified ? "success" : route.HasManifest ? "warning" : "secondary";
    var manifestText = route.IsManifestVerified ? "Manifest zweryfikowany" : route.HasManifest ? "Manifest do weryfikacji" : "Brak manifestu";
}

<div class="row row-cards">
    <div class="col-12">
        <div class="card card-premium">
            <div class="card-body py-4">
                <div class="row align-items-center g-3">
                    <div class="col">
                        <div class="text-uppercase text-secondary small fw-bold">Dostawa #@route.RouteId</div>
                        <h2 class="h1 mb-1 text-dark">@route.RouteName</h2>
                        <div class="d-flex flex-wrap gap-3 mt-2 text-secondary small">
                            <span>Auto: <strong>@route.VehicleRegistration</strong></span>
                            <span>Torby: <strong>@route.TotalBags</strong></span>
                            <span>Gotowe: <strong>@route.PackedBags</strong></span>
                            <span>Załadowane: <strong>@route.LoadedBags</strong></span>
                            <span>Data: <strong>@selectedDate.ToString("dd.MM.yyyy")</strong></span>
                        </div>
                    </div>
                    <div class="col-auto">
                        <span class="badge bg-@manifestColor-lt text-@manifestColor">@manifestText</span>
                    </div>
                </div>
                @if (manifest is not null)
                {
                    <div class="text-secondary small mt-3">
                        Manifest: <strong>@manifest.ManifestNumber</strong>,
                        wygenerowany @manifest.GeneratedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                        @if (manifest.IsVerified && manifest.VerifiedAt.HasValue)
                        {
                            <span>, zweryfikowany @manifest.VerifiedAt.Value.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</span>
                        }
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="col-12">
        <div class="card card-premium">
            <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
                <h3 class="card-title">Operacje dostawy</h3>
                <div class="btn-list">
                    <form asp-action="GenerateManifest" asp-route-routeId="@route.RouteId" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="date" value="@selectedDate.ToString("yyyy-MM-dd")" />
                        <button type="submit" class="btn btn-outline-primary" disabled="@(!route.CanGenerateManifest ? "disabled" : null)">Generuj manifest dostawy</button>
                    </form>
                    <form asp-action="VerifyManifest" asp-route-routeId="@route.RouteId" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="date" value="@selectedDate.ToString("yyyy-MM-dd")" />
                        <button type="submit" class="btn btn-outline-success" disabled="@(!route.CanVerifyManifest ? "disabled" : null)">Zweryfikuj manifest</button>
                    </form>
                    @if (route.HasManifest)
                    {
                        <a asp-action="ManifestJson" asp-route-routeId="@route.RouteId" asp-route-date="@selectedDate.ToString("yyyy-MM-dd")" class="btn btn-outline-secondary">Otworz manifest JSON</a>
                        <a asp-action="DeliveryLabels" asp-route-routeId="@route.RouteId" asp-route-date="@selectedDate.ToString("yyyy-MM-dd")" class="btn btn-outline-secondary">Drukuj etykiety transportowe</a>
                    }
                    <form asp-action="DispatchDelivery" asp-route-routeId="@route.RouteId" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="date" value="@selectedDate.ToString("yyyy-MM-dd")" />
                        <button type="submit" class="btn btn-success" disabled="@(!route.CanDispatchDelivery ? "disabled" : null)">Wyślij całą dostawę</button>
                    </form>
                    <a asp-action="Loading" asp-route-date="@selectedDate.ToString("yyyy-MM-dd")" class="btn btn-outline-secondary">Wróć</a>
                </div>
            </div>
        </div>
    </div>

    <!-- Symulator skanowania etykiet transportowych (toreb) -->
    <div class="col-12">
        <div class="card card-premium bg-dark-lt text-dark">
            <div class="card-body">
                <form asp-action="ScanBag" asp-route-routeId="@route.RouteId" method="post" id="scan-bag-form">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="date" value="@selectedDate.ToString("yyyy-MM-dd")" />
                    <div class="row align-items-center g-3">
                        <div class="col-md-3">
                            <label for="transport-code-input" class="form-label fw-bold mb-0">Symulator skanera toreb (aut):</label>
                        </div>
                        <div class="col-md-7">
                            <div class="input-group">
                                <span class="input-group-text bg-white text-muted">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M4 7V5a2 2 0 0 1 2 -2h2" /><path d="M4 17v2a2 2 0 0 0 2 2h2" /><path d="M16 3h2a2 2 0 0 1 2 2v2" /><path d="M16 21h2a2 2 0 0 0 2 -2v-2" /><path d="M7 12h10" /><path d="M10 9v6" /><path d="M14 9v6" /></svg>
                                </span>
                                <input type="text" id="transport-code-input" name="transportCode" class="form-control form-control-lg bg-white" placeholder="Zeskanuj etykietę transportową torby (np. BAG-123456)..." autofocus />
                            </div>
                        </div>
                        <div class="col-md-2">
                            <button type="submit" class="btn btn-indigo btn-lg w-100" disabled="@(!route.CanLoadBags ? "disabled" : null)">Załaduj</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="col-12">
        <div class="card card-premium">
            <div class="card-header">
                <h3 class="card-title">Torby w dostawie</h3>
            </div>
            <div class="table-responsive">
                <table class="table table-vcenter card-table table-premium">
                    <thead>
                        <tr>
                            <th class="w-1">Stop</th>
                            <th>Zamówienie</th>
                            <th>Identyfikator</th>
                            <th>DeliveryCalendarId</th>
                            <th>Pudełka</th>
                            <th>Status</th>
                            <th>Manifest</th>
                            <th class="w-1 text-end">Akcja</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var bag in route.Bags)
                        {
                            var canLoad = route.CanLoadBags && bag.CanLoad;
                            <tr>
                                <td class="fw-bold text-dark">#@bag.StopNumber</td>
                                <td>
                                    <div class="fw-bold text-dark">#@bag.OrderId</div>
                                    <div class="text-secondary small">@bag.DeliveryWindow</div>
                                </td>
                                <td class="fw-bold text-dark">@(bag.ClientPublicId ?? "-")</td>
                                <td class="text-secondary small">@(bag.DeliveryCalendarId?.ToString() ?? "-")</td>
                                <td class="fw-bold text-dark">@bag.PackedBoxes/@bag.TotalBoxes</td>
                                <td>
                                    <span class="badge bg-@bag.StatusColor-lt text-@bag.StatusColor">@bag.StatusText</span>
                                </td>
                                <td>
                                    @if (bag.HasLabels)
                                    {
                                        <span class="badge bg-success-lt text-success">Etykieta gotowa</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-lt text-secondary">Brak etykiety</span>
                                    }
                                </td>
                                <td>
                                    <div class="btn-list flex-nowrap justify-content-end">
                                        <a asp-action="Session" asp-route-sessionId="@bag.PackingSessionId" class="btn btn-sm btn-outline-secondary">Torba</a>
                                        <form asp-action="LoadBag" asp-route-routeId="@route.RouteId" asp-route-sessionId="@bag.PackingSessionId" method="post">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="date" value="@selectedDate.ToString("yyyy-MM-dd")" />
                                            <button type="submit" class="btn btn-sm btn-indigo" disabled="@(!canLoad ? "disabled" : null)">Załaduj</button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const transportInput = document.getElementById("transport-code-input");
            if (transportInput) {
                transportInput.focus();
                
                // Automatycznie przywraca fokus po kliknięciu
                document.addEventListener("click", function () {
                    transportInput.focus();
                });
            }
        });
    </script>
}

