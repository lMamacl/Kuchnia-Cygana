@model KuchniaUCygana.Web.Models.PackingSessionViewModel
@{
    Layout = "_LayoutStaff";
    ViewData["Title"] = "Torba zamowienia";
    ViewData["Section"] = "Pakowanie";
    ViewData["Description"] = "Pakowanie pudelek do torby zamowienia.";

    var session = Model.Session;
    var bag = Model.Bag;
    var boxes = session.Items;
    var packedBoxes = boxes.Count(x => x.Status == "Packed");
    var progress = boxes.Count > 0 ? packedBoxes * 100 / boxes.Count : 0;
    var packedBy = User.Identity?.Name ?? "Packing";
    var statusColor = bag?.StatusColor ?? "secondary";
}

@functions {
    string TranslateBoxStatus(string status)
    {
        return status switch
        {
            "Pending" => "Czeka na kompletacje",
            "FoilPrinted" => "Folia dania gotowa",
            "Packed" => "Spakowane",
            "Damaged" => "Uszkodzone",
            "Missing" => "Brak",
            _ => status
        };
    }

    string BoxStatusColor(string status)
    {
        return status switch
        {
            "FoilPrinted" => "azure",
            "Packed" => "success",
            "Damaged" => "danger",
            "Missing" => "warning",
            _ => "secondary"
        };
    }
}

<div class="row row-cards">
    <div class="col-12">
        <div class="card card-premium">
            <div class="card-body py-4">
                <div class="row align-items-center g-3">
                    <div class="col">
                        <div class="text-uppercase text-secondary small fw-bold">Torba #@session.Id</div>
                        <h2 class="h1 mb-1 text-dark">Zamowienie #@session.OrderId</h2>
                        <div class="d-flex flex-wrap gap-3 mt-2 text-secondary small">
                            <span>Klient: <strong>@session.ClientName</strong></span>
                            <span>Auto: <strong>@(bag?.VehicleRegistration ?? "Brak")</strong></span>
                            <span>Stop: <strong>@(bag?.StopNumber.ToString() ?? "-")</strong></span>
                            <span>Data: <strong>@session.PackingDate.ToString("dd.MM.yyyy")</strong></span>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="d-flex align-items-center gap-2">
                            <div class="progress progress-sm flex-fill">
                                <div class="progress-bar bg-@statusColor" style="width: @progress%"></div>
                            </div>
                            <span class="fw-bold text-dark">@packedBoxes/@boxes.Count</span>
                        </div>
                    </div>
                    <div class="col-auto">
                        <span class="badge bg-@statusColor-lt text-@statusColor">@((bag?.StatusText) ?? session.Status)</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-12">
        <div class="card card-premium">
            <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
                <h3 class="card-title">Kompletacja torby</h3>
                <div class="btn-list">
                    <form asp-action="PrepareBoxes" asp-route-sessionId="@session.Id" method="post">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-outline-primary">Przygotuj pudelka</button>
                    </form>
                    <form asp-action="PackBag" asp-route-sessionId="@session.Id" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="packedBy" value="@packedBy" />
                        <button type="submit" class="btn btn-success" disabled="@(boxes.Count == 0 || packedBoxes != boxes.Count ? "disabled" : null)">Spakuj torbe</button>
                    </form>
                    @if (session.Status != "Pending")
                    {
                        <a asp-action="Labels" asp-route-sessionId="@session.Id" class="btn btn-indigo">
                            <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M17 17h2a2 2 0 0 0 2 -2v-4a2 2 0 0 0 -2 -2h-14a2 2 0 0 0 -2 2v4a2 2 0 0 0 2 2h2" /><path d="M17 9v-4a2 2 0 0 0 -2 -2h-6a2 2 0 0 0 -2 2v4" /><path d="M7 13m0 2a2 2 0 0 1 2 -2h6a2 2 0 0 1 2 2v4a2 2 0 0 1 -2 2h-6a2 2 0 0 1 -2 -2z" /></svg>
                            Drukuj etykietę transportową
                        </a>
                    }
                    else
                    {
                        <button class="btn btn-indigo" disabled="disabled" title="Spakuj najpierw wszystkie pudełka w torbie">
                            <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M17 17h2a2 2 0 0 0 2 -2v-4a2 2 0 0 0 -2 -2h-14a2 2 0 0 0 -2 2v4a2 2 0 0 0 2 2h2" /><path d="M17 9v-4a2 2 0 0 0 -2 -2h-6a2 2 0 0 0 -2 2v4" /><path d="M7 13m0 2a2 2 0 0 1 2 -2h6a2 2 0 0 1 2 2v4a2 2 0 0 1 -2 2h-6a2 2 0 0 1 -2 -2z" /></svg>
                            Drukuj etykietę transportową
                        </button>
                    }
                    <a asp-action="Index" asp-route-date="@session.PackingDate.ToString("yyyy-MM-dd")" class="btn btn-outline-secondary">Wroc</a>
                </div>
            </div>
        </div>
    </div>

    <!-- Symulator skanowania kodów QR pudełek -->
    <div class="col-12">
        <div class="card card-premium bg-dark-lt text-dark">
            <div class="card-body">
                <form asp-action="ScanBox" asp-route-sessionId="@session.Id" method="post" id="scan-form">
                    @Html.AntiForgeryToken()
                    <div class="row align-items-center g-3">
                        <div class="col-md-3">
                            <label for="barcode-input" class="form-label fw-bold mb-0">Symulator skanera kodów (dań):</label>
                        </div>
                        <div class="col-md-7">
                            <div class="input-group">
                                <span class="input-group-text bg-white text-muted">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M4 7V5a2 2 0 0 1 2 -2h2" /><path d="M4 17v2a2 2 0 0 0 2 2h2" /><path d="M16 3h2a2 2 0 0 1 2 2v2" /><path d="M16 21h2a2 2 0 0 0 2 -2v-2" /><path d="M7 12h10" /><path d="M10 9v6" /><path d="M14 9v6" /></svg>
                                </span>
                                <input type="text" id="barcode-input" name="barcode" class="form-control form-control-lg bg-white" placeholder="Zeskanuj kod QR z pudełka (np. BOX-000001)..." autofocus />
                            </div>
                        </div>
                        <div class="col-md-2">
                            <button type="submit" class="btn btn-indigo btn-lg w-100">Skanuj</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="col-12">
        <div class="card card-premium">
            <div class="card-header">
                <h3 class="card-title">Pudelka w torbie</h3>
            </div>

            <div class="table-responsive">
                <table class="table table-vcenter card-table table-premium">
                    <thead>
                        <tr>
                            <th>Kod</th>
                            <th>Posilek</th>
                            <th>Status</th>
                            <th>Operator</th>
                            <th class="w-1 text-end">Akcja</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (boxes.Count == 0)
                        {
                            <tr>
                                <td colspan="5" class="text-secondary">Brak pudełek w paczce. Użyj akcji przygotowania paczki.</td>
                            </tr>
                        }
                        @foreach (var box in boxes)
                        {
                            var color = BoxStatusColor(box.Status);
                            <tr>
                                <td class="fw-bold text-dark font-monospace">@(box.BoxCode ?? $"BOX-{box.Id}")</td>
                                <td>
                                    <div class="fw-bold text-dark">@box.MealName</div>
                                    <div class="text-secondary small">Wariant @box.DietVariantId</div>
                                </td>
                                <td>
                                    <span class="badge bg-@color-lt text-@color d-inline-flex align-items-center gap-1">
                                        <span class="status-dot bg-@color" style="width: 6px; height: 6px;"></span>
                                        @TranslateBoxStatus(box.Status)
                                    </span>
                                </td>
                                <td class="text-secondary small">
                                    @(box.PackedBy ?? "-")
                                    @if (box.PackedAt.HasValue)
                                    {
                                        <span>· @box.PackedAt.Value.ToLocalTime().ToString("HH:mm")</span>
                                    }
                                </td>
                                <td>
                                    <form asp-action="MarkBoxPacked" asp-route-packingItemId="@box.Id" method="post" class="text-end">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="sessionId" value="@session.Id" />
                                        <input type="hidden" name="packedBy" value="@packedBy" />
                                        @if (box.Status == "Packed")
                                        {
                                            <button type="button" class="btn btn-sm btn-outline-success" disabled>Spakowane</button>
                                        }
                                        else if (box.Status == "Pending")
                                        {
                                            <button type="button" class="btn btn-sm btn-outline-secondary" disabled title="Wymagane zafoliowanie w kuchni">Brak folii</button>
                                        }
                                        else
                                        {
                                            <button type="submit" class="btn btn-sm btn-success">Spakuj pudelko</button>
                                        }
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const barcodeInput = document.getElementById("barcode-input");
            if (barcodeInput) {
                barcodeInput.focus();
                
                // Automatycznie przywraca fokus na input po kliknięciu gdziekolwiek w dokumencie
                document.addEventListener("click", function () {
                    barcodeInput.focus();
                });
            }
        });
    </script>
}

