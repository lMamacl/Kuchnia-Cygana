@model IEnumerable<KuchniaUCygana.Application.DTOs.Packing.PackingLabelDto>
@{
    Layout = "_LayoutStaff";
    ViewData["Title"] = "Etykiety transportowe";
    ViewData["Section"] = "Pakowanie";
    ViewData["Description"] = "Audytowalne etykiety transportowe fizycznych toreb.";

    object sessionIdValue = ViewBag.SessionId;
    object routeIdValue = ViewBag.RouteId;
    object selectedDateValue = ViewBag.SelectedDate;
    object autoPrintValue = ViewBag.AutoPrint;
    int sessionId = sessionIdValue is int sessionValue ? sessionValue : 0;
    int routeId = routeIdValue is int routeValue ? routeValue : 0;
    DateOnly? selectedDate = selectedDateValue is DateOnly dateValue ? dateValue : null;
    var autoPrint = autoPrintValue is bool shouldAutoPrint && shouldAutoPrint;
    var labels = Model.ToList();
    var returnUrl = ViewContext.HttpContext.Request.Path + ViewContext.HttpContext.Request.QueryString;
}

@section Styles {
    <style>
        .transport-label {
            border: 2px solid #111827;
            border-radius: 6px;
            padding: 14px;
            background: #fff;
            color: #111827;
            min-height: 360px;
            page-break-inside: avoid;
        }

        .transport-label__qr {
            width: 3.2cm;
            height: 3.2cm;
            border: 1px solid #111827;
            padding: 4px;
            background: #fff;
        }

        .transport-label__code {
            font-size: 1.35rem;
            font-weight: 800;
            letter-spacing: 0;
        }

        .transport-label__meta {
            font-size: 0.78rem;
            line-height: 1.3;
        }

        .transport-label__meals {
            white-space: pre-line;
            font-size: 0.82rem;
            line-height: 1.35;
        }

        @@media print {
            body * {
                visibility: hidden;
            }

            .printable-area,
            .printable-area * {
                visibility: visible;
            }

            .printable-area {
                position: absolute;
                left: 0;
                top: 0;
                width: 100%;
            }

            .d-print-none {
                display: none !important;
            }
        }
    </style>
}

<div class="card card-premium d-print-none mb-4">
    <div class="card-body">
        <div class="row align-items-end g-3">
            <div class="col">
                <h3 class="mb-1 text-dark">Etykiety transportowe toreb</h3>
                <p class="text-secondary small mb-0">QR prowadzi do publicznego podglądu torby, a kod pod QR służy do skanowania przy załadunku.</p>
            </div>
            <div class="col-auto">
                <button class="btn btn-primary" onclick="window.print();">
                    <svg xmlns="http://www.w3.org/2000/svg" class="icon icon-tabler icon-tabler-printer" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M17 17h2a2 2 0 0 0 2 -2v-4a2 2 0 0 0 -2 -2h-14a2 2 0 0 0 -2 2v4a2 2 0 0 0 2 2h2" /><path d="M17 9v-4a2 2 0 0 0 -2 -2h-6a2 2 0 0 0 -2 2v4" /><rect x="7" y="13" width="10" height="8" rx="2" /></svg> Drukuj widoczne etykiety
                </button>
            </div>
            <div class="col-auto d-flex gap-2">
                @if (routeId > 0 && selectedDate.HasValue)
                {
                    <a asp-action="LabelsIndex" asp-route-routeId="@routeId" asp-route-date="@selectedDate.Value.ToString("yyyy-MM-dd")" class="btn btn-outline-secondary">
                        <svg xmlns="http://www.w3.org/2000/svg" class="icon icon-tabler icon-tabler-arrow-left" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><line x1="5" y1="12" x2="19" y2="12" /><line x1="5" y1="12" x2="11" y2="18" /><line x1="5" y1="12" x2="11" y2="6" /></svg> Wróć do etykiet
                    </a>
                    <a asp-controller="Loading" asp-action="Manifest" asp-route-routeId="@routeId" asp-route-date="@selectedDate.Value.ToString("yyyy-MM-dd")" class="btn btn-outline-primary">Manifest cyfrowy</a>
                }
                else if (sessionId > 0)
                {
                    <a asp-controller="Packing" asp-action="Session" asp-route-sessionId="@sessionId" class="btn btn-outline-secondary">
                        <svg xmlns="http://www.w3.org/2000/svg" class="icon icon-tabler icon-tabler-arrow-left" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><line x1="5" y1="12" x2="19" y2="12" /><line x1="5" y1="12" x2="11" y2="18" /><line x1="5" y1="12" x2="11" y2="6" /></svg> Wróć do torby
                    </a>
                }
                else
                {
                    <a asp-action="LabelsIndex" class="btn btn-outline-secondary">
                        <svg xmlns="http://www.w3.org/2000/svg" class="icon icon-tabler icon-tabler-arrow-left" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><line x1="5" y1="12" x2="19" y2="12" /><line x1="5" y1="12" x2="11" y2="18" /><line x1="5" y1="12" x2="11" y2="6" /></svg> Wróć
                    </a>
                }
            </div>
        </div>

        <div class="border-top mt-3 pt-3">
            @if (sessionId > 0)
            {
                <a asp-controller="Packing" asp-action="ReprintLabelForm" asp-route-sessionId="@sessionId" class="btn btn-outline-danger">Otwórz formularz redruku etykiety</a>
            }
            else if (routeId > 0 && selectedDate.HasValue)
            {
                <a asp-action="LabelsIndex" asp-route-routeId="@routeId" asp-route-date="@selectedDate.Value.ToString("yyyy-MM-dd")" class="btn btn-outline-danger">Redruk pojedynczej torby z listy etykiet</a>
            }
        </div>
    </div>
</div>

<div class="printable-area">
    <div class="row g-4">
        @foreach (var label in labels)
        {
            var publicId = string.IsNullOrWhiteSpace(label.ClientPublicId)
                ? "BRAK"
                : label.ClientPublicId.Length > 8 ? label.ClientPublicId.Substring(0, 8) : label.ClientPublicId;
            var isReprint = label.PrintNumber > 1;

            <div class="col-md-6">
                <section class="transport-label">
                    <div class="d-flex justify-content-between gap-3 border-bottom pb-2 mb-3">
                        <div>
                            <div class="text-uppercase fw-bold small">Kuchnia u Cygana</div>
                            <h2 class="h4 mb-0">Etykieta transportowa</h2>
                        </div>
                        <div class="text-end transport-label__meta">
                            <div>Wydruk: <strong>#@label.PrintNumber</strong></div>
                            <div>@(label.PrintedAt?.ToLocalTime().ToString("dd.MM.yyyy HH:mm") ?? "-")</div>
                            <div class="fw-bold">@(isReprint ? "REDRUK" : "ORYGINAŁ")</div>
                        </div>
                    </div>

                    <div class="row g-3">
                        <div class="col">
                            <div class="text-secondary small text-uppercase fw-bold">Public ID klienta</div>
                            <div class="h2 mb-2">@publicId</div>
                            <div class="transport-label__meta">
                                <div><strong>Adres:</strong> @(label.Address ?? "-")</div>
                                <div><strong>Okno:</strong> @(label.DeliveryWindow ?? "-")</div>
                                <div><strong>Pudełka:</strong> @label.PackedBoxes/@label.TotalBoxes</div>
                                <div><strong>DeliveryCalendarId:</strong> @(label.DeliveryCalendarId?.ToString() ?? "-")</div>
                            </div>
                        </div>
                        <div class="col-auto text-center">
                            <div class="transport-label__qr d-flex align-items-center justify-content-center text-center small fw-bold">
                                @label.BagCode
                            </div>
                            <div class="transport-label__code mt-2">@label.BagCode</div>
                        </div>
                    </div>

                    <div class="border-top mt-3 pt-2">
                        <div class="text-secondary small text-uppercase fw-bold">Posiłki w torbie</div>
                        <div class="transport-label__meals">@(string.IsNullOrWhiteSpace(label.MealsList) ? "-" : label.MealsList)</div>
                    </div>

                    <div class="border-top mt-3 pt-2 transport-label__meta">
                        <div><strong>Trasa:</strong> @(label.RouteInfo ?? "-")</div>
                        <div><strong>Auto:</strong> @(label.VehicleRegistration ?? "-") | <strong>Stop:</strong> @(label.StopNumber?.ToString() ?? "-")</div>
                        <div><strong>Przyklejenie:</strong> @(label.IsAttached ? $"potwierdzone {label.AttachedAt?.ToLocalTime().ToString("dd.MM.yyyy HH:mm")}" : "oczekuje na potwierdzenie")</div>
                        @if (isReprint)
                        {
                            <div><strong>Powód redruku:</strong> @label.ReprintReason</div>
                        }
                    </div>
                    <div class="border-top mt-3 pt-2 d-print-none">
                        @if (label.IsAttached)
                        {
                            <label class="form-check mb-0">
                                <input class="form-check-input" type="checkbox" checked disabled />
                                <span class="form-check-label">Etykieta została przyklejona</span>
                            </label>
                        }
                        else
                        {
                            <form asp-action="ConfirmLabelAttached" asp-route-labelId="@label.Id" method="post" class="d-flex flex-wrap align-items-center gap-2">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="returnUrl" value="@returnUrl" />
                                @if (selectedDate.HasValue)
                                {
                                    <input type="hidden" name="date" value="@selectedDate.Value.ToString("yyyy-MM-dd")" />
                                }
                                <label class="form-check mb-0">
                                    <input class="form-check-input" type="checkbox" required />
                                    <span class="form-check-label">Etykieta została przyklejona</span>
                                </label>
                                <button type="submit" class="btn btn-sm btn-outline-success">Potwierdź</button>
                            </form>
                        }
                    </div>
                </section>
            </div>
        }
    </div>
</div>

@section Scripts {
    @if (autoPrint)
    {
        <script>
            window.addEventListener('load', function () {
                setTimeout(function () {
                    window.print();
                }, 300);
            });
        </script>
    }
}
