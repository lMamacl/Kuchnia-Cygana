@model KuchniaUCygana.Application.DTOs.Packing.PackingBoardDto
@{
    Layout = "_LayoutStaff";
    ViewData["Title"] = "Zaladunek aut";
    ViewData["Section"] = "Pakowanie";
    ViewData["Description"] = "Dostawy per auto/trasa, manifesty i zaladunek gotowych toreb.";

    DateOnly selectedDate = ViewBag.SelectedDate ?? Model.PackingDate;
}

<div class="row row-cards">
    <div class="col-12">
        <div class="card card-premium">
            <div class="card-body py-4">
                <div class="row align-items-center g-3">
                    <div class="col">
                        <div class="text-uppercase text-secondary small fw-bold">Zaladunek aut</div>
                        <h2 class="h1 mb-1 text-dark">@selectedDate.ToString("dd.MM.yyyy")</h2>
                        <div class="d-flex flex-wrap gap-3 mt-2 text-secondary small">
                            <span>Dostawy: <strong>@Model.Routes.Count(r => r.TotalBags > 0)</strong></span>
                            <span>Torby: <strong>@Model.TotalBags</strong></span>
                            <span>Gotowe: <strong>@Model.PackedBags</strong></span>
                            <span>Zaladowane: <strong>@Model.LoadedBags</strong></span>
                        </div>
                    </div>
                    <div class="col-auto d-flex flex-wrap gap-2">
                        <input type="date"
                               class="form-control"
                               value="@selectedDate.ToString("yyyy-MM-dd")"
                               onchange="window.location.href='?date=' + this.value"
                               aria-label="Filtruj po dacie" />
                        <a asp-action="Index" asp-route-date="@selectedDate.ToString("yyyy-MM-dd")" class="btn btn-outline-secondary">Wroc do kompletacji</a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @foreach (var route in Model.Routes.Where(r => r.TotalBags > 0))
    {
        var manifestColor = route.IsManifestVerified ? "success" : route.HasManifest ? "warning" : "secondary";
        var manifestText = route.IsManifestVerified ? "Manifest zweryfikowany" : route.HasManifest ? "Manifest do weryfikacji" : "Brak manifestu";

        <div class="col-12">
            <div class="card card-premium">
                <div class="card-body">
                    <div class="row align-items-center g-3">
                        <div class="col">
                            <h3 class="card-title mb-1">@route.RouteName</h3>
                            <div class="text-secondary small">Auto @route.VehicleRegistration - @route.TotalBags torby</div>
                        </div>
                        <div class="col-md-5">
                            <div class="d-flex flex-wrap gap-2">
                                <span class="badge bg-success-lt text-success">@route.PackedBags/@route.TotalBags gotowe</span>
                                <span class="badge bg-indigo-lt text-indigo">@route.LoadedBags/@route.TotalBags zaladowane</span>
                                <span class="badge bg-@manifestColor-lt text-@manifestColor">@manifestText</span>
                            </div>
                        </div>
                        <div class="col-auto">
                            <a asp-action="Delivery" asp-route-routeId="@route.RouteId" asp-route-date="@selectedDate.ToString("yyyy-MM-dd")" class="btn btn-outline-primary">Otworz dostawe</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
