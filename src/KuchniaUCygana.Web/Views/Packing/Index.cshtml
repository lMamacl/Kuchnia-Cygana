@{
    Layout = "_LayoutStaff";
    ViewData["Title"] = "Sesje Kompletacji i Pakowania";
    ViewData["Section"] = "Pakowanie";
    ViewData["Description"] = "Zarządzanie procesem pakowania zestawów dietetycznych oraz generowanie etykiet wysyłkowych z kodami QR.";

    DateOnly selectedDate = ViewBag.SelectedDate;

    var mockSessions = new[]
    {
        new { Id = 301, Date = selectedDate, PackedBy = "Tomasz Nowak", Progress = "100%", Status = "Gotowe do wysyłki (Dispatched)", Color = "success", Qty = "120/120" },
        new { Id = 302, Date = selectedDate, PackedBy = "Anna Kowalska", Progress = "75%", Status = "W trakcie pakowania", Color = "warning", Qty = "90/120" }
    };
}

<div class="row row-cards">
    <!-- Formularz Rozpoczęcia Nowej Sesji -->
    <div class="col-md-5">
        <div class="card card-premium">
            <div class="card-status-top bg-azure"></div>
            <div class="card-header bg-transparent py-3">
                <h3 class="card-title d-flex align-items-center gap-2">
                    <svg xmlns="http://www.w3.org/2000/svg" class="icon text-azure" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M12 3l8 4.5l-8 4.5l-8 -4.5z" /><path d="M12 12l8 4.5l-8 4.5l-8 -4.5z" /><path d="M12 21l8 4.5l-8 4.5l-8 -4.5z" /><path d="M12 12v9" /><path d="M20 7.5v9" /><path d="M4 7.5v9" /></svg>
                    Nowa Sesja Pakowania
                </h3>
            </div>
            <div class="card-body">
                <form asp-action="Start" method="post" autocomplete="off">
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label class="form-label required">Data dostawy zestawów</label>
                        <input type="date" name="date" class="form-control" value="@selectedDate.ToString("yyyy-MM-dd")" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label required">Pakujący (Imię i Nazwisko)</label>
                        <input type="text" name="packedBy" class="form-control" placeholder="np. Jan Kowalski" required />
                    </div>

                    <button type="submit" class="btn btn-primary w-100">
                        Rozpocznij Sesję Pakowania
                    </button>
                </form>
            </div>
        </div>
    </div>

    <!-- Lista Sesji w Dniu -->
    <div class="col-md-7">
        <div class="card card-premium">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h3 class="card-title">Sesje Pakowania na @selectedDate.ToString("dd.MM.yyyy")</h3>
                <div class="input-icon">
                    <input type="date" class="form-control form-control-sm" value="@selectedDate.ToString("yyyy-MM-dd")" onchange="window.location.href='?date=' + this.value" aria-label="Filtruj po dacie" />
                </div>
            </div>
            
            <div class="table-responsive">
                <table class="table table-vcenter card-table table-premium">
                    <thead>
                        <tr>
                            <th class="w-1">Sesja</th>
                            <th>Pakujący</th>
                            <th>Postęp</th>
                            <th>Status</th>
                            <th class="w-1">Akcje</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var session in mockSessions)
                        {
                            <tr>
                                <td class="font-weight-medium fw-bold text-dark">#@session.Id</td>
                                <td>@session.PackedBy</td>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="fw-bold text-dark">@session.Qty</span>
                                        <div class="progress progress-xs w-50 d-none d-md-flex">
                                            <div class="progress-bar bg-@session.Color" style="width: @session.Progress"></div>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <span class="badge bg-@session.Color-lt text-@session.Color">
                                        @session.Status
                                    </span>
                                </td>
                                <td>
                                    <a asp-action="Session" asp-route-sessionId="@session.Id" class="btn btn-sm btn-outline-primary">
                                        Otwórz
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
