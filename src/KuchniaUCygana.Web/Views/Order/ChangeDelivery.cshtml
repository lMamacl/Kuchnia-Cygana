@model KuchniaUCygana.Web.Models.OrderChangeDeliveryViewModel
@{
    ViewData["Title"] = "Modyfikacja dostawy";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-6">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white fw-bold">
                🚚 Modyfikacja dostawy
            </div>
            <div class="card-body">
                <form asp-action="ChangeDelivery" method="post">
                    <input type="hidden" asp-for="DeliveryCalendarId" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>

                    <div class="mb-3">
                        <label class="form-label">Aktualna data dostawy</label>
                        <input type="text" class="form-control" value="@Model.CurrentDate.ToString("dd.MM.yyyy")" disabled />
                    </div>

                    <div class="mb-3">
                        <label asp-for="NewDate" class="form-label">Nowa data dostawy</label>
                        <input asp-for="NewDate" type="date" class="form-control"
                               min="@DateTime.Today.AddDays(1).ToString("yyyy-MM-dd")" />
                        <span asp-validation-for="NewDate" class="text-danger small"></span>
                        <div class="form-text">Dostawa może zostać przeniesiona najwcześniej na jutro.</div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="NewAddressId" class="form-label">Adres dostawy</label>
                        <select asp-for="NewAddressId" class="form-select">
                            <option value="">-- Pozostaw bez zmian --</option>
                            @foreach (var addr in Model.Addresses)
                            {
                                <option value="@addr.Id">@addr.Label (@addr.FullAddress)</option>
                            }
                        </select>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">Zapisz zmiany</button>
                        <a asp-action="Index" class="btn btn-outline-secondary">Anuluj</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}