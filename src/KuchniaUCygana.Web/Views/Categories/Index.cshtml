@model IEnumerable<KuchniaUCygana.Domain.Entities.Menu.Category>
@{
    Layout = "_LayoutStaff";
    ViewData["Title"] = "Kategorie posiłków";
    ViewData["Section"] = "Katalog Menu";
}

<div class="card card-premium">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h3 class="card-title">Kategorie</h3>
        <a asp-action="Create" class="btn btn-primary">Nowa kategoria</a>
    </div>
    <div class="table-responsive">
        <table class="table table-vcenter card-table">
            <thead>
                <tr>
                    <th>Nazwa</th>
                    <th>Opis</th>
                    <th>Kolejność</th>
                    <th class="text-end">Akcje</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var category in Model)
                {
                    <tr>
                        <td><strong>@category.Name</strong></td>
                        <td>@category.Description</td>
                        <td>@category.SortOrder</td>
                        <td class="text-end">
                            <a asp-action="Edit" asp-route-id="@category.Id" class="btn btn-sm btn-outline-primary">Edytuj</a>
                            <form asp-action="Delete" asp-route-id="@category.Id" method="post" class="d-inline" onsubmit="return confirm('Usunąć kategorię?');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-danger">Usuń</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
