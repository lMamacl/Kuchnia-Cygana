@{
    var description = ViewData["Description"]?.ToString() ?? "Mobilny ekran placeholder dla kierowcy.";
}
<div class="card">
    <div class="card-body">
        <h3 class="card-title">@ViewData["Title"]</h3>
        <p class="text-secondary">@description</p>
        <div class="progress progress-sm mb-3">
            <div class="progress-bar" style="width: 20%" role="progressbar" aria-valuenow="20" aria-valuemin="0" aria-valuemax="100"></div>
        </div>
        <div class="btn-list">
            <a asp-controller="DriverMobile" asp-action="Index" class="btn btn-primary">Moja trasa</a>
            <a asp-controller="DriverMobile" asp-action="Summary" class="btn btn-outline-secondary">Podsumowanie</a>
        </div>
    </div>
</div>

