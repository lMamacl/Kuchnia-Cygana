@{
    var title = ViewData["Title"]?.ToString() ?? "Panel pracowniczy";
    var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty;
    var section = StaffNavigationCatalog.FindSection(controller);
    var department = section?.Label ?? "Staff";
    var departmentDescription = section?.Description ?? "Centralny podglad wszystkich dzialow Sprint 4B.";
}
<div class="page-header d-print-none staff-page-header">
    <div class="container-xl">
        <div class="row g-2 align-items-center">
            <div class="col">
                <div class="staff-department-label">Aktywny dzial</div>
                <div class="d-flex flex-wrap align-items-center gap-2">
                    <h2 class="page-title mb-0">@title</h2>
                    <span class="badge bg-primary-lt text-primary staff-department-badge">
                        @if (section is not null)
                        {
                            <span class="staff-badge-icon">@Html.Raw(StaffIconCatalog.Get(section.Icon))</span>
                        }
                        @department
                    </span>
                </div>
                <div class="text-secondary mt-1">@departmentDescription</div>
            </div>
            <div class="col-auto ms-auto d-print-none">
                <div class="btn-list">
                    <span class="badge bg-yellow-lt text-yellow">Tryb podgladu</span>
                    <a class="btn btn-outline-primary btn-sm" asp-controller="Staff" asp-action="Index">Mapa dzialow</a>
                </div>
            </div>
        </div>
    </div>
</div>
