@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty;
    var action = ViewContext.RouteData.Values["action"]?.ToString() ?? string.Empty;

    var isDashboard = string.Equals(controller, "Staff", StringComparison.OrdinalIgnoreCase);
    var isKitchen = string.Equals(controller, "Production", StringComparison.OrdinalIgnoreCase);
    var isWarehouse = string.Equals(controller, "Warehouse", StringComparison.OrdinalIgnoreCase);
    var isIngredients = string.Equals(controller, "Ingredient", StringComparison.OrdinalIgnoreCase);
    var isPacking = string.Equals(controller, "Packing", StringComparison.OrdinalIgnoreCase);
    var isDiets = string.Equals(controller, "DietEditor", StringComparison.OrdinalIgnoreCase);
    var isLogistics = string.Equals(controller, "Logistics", StringComparison.OrdinalIgnoreCase) ||
        string.Equals(controller, "DriverMobile", StringComparison.OrdinalIgnoreCase);
    var isAdmin = string.Equals(controller, "Admin", StringComparison.OrdinalIgnoreCase);

    string ActiveLink(string targetController, string? targetAction = null)
    {
        var sameController = string.Equals(controller, targetController, StringComparison.OrdinalIgnoreCase);
        var sameAction = targetAction is null || string.Equals(action, targetAction, StringComparison.OrdinalIgnoreCase);
        return sameController && sameAction ? "active" : string.Empty;
    }

    string OpenGroup(bool isOpen) => isOpen ? "show" : string.Empty;
    string Expanded(bool isOpen) => isOpen ? "true" : "false";
    string ActiveGroup(bool isActive) => isActive ? "active" : string.Empty;
}

