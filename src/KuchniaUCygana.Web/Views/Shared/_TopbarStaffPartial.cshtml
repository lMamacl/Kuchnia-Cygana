@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty;

    string ActiveTop(string targetController)
    {
        return string.Equals(controller, targetController, StringComparison.OrdinalIgnoreCase) ? "active" : string.Empty;
    }
}

<header class="navbar navbar-expand-md d-print-none staff-topbar">
    <div class="container-xl">
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#staff-topbar-menu" aria-controls="staff-topbar-menu" aria-expanded="false" aria-label="Pokaz menu">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="navbar-brand d-md-none">
            <a asp-controller="Staff" asp-action="Index" class="navbar-brand-text">Kuchnia u Cygana</a>
        </div>

        <div class="collapse navbar-collapse" id="staff-topbar-menu">
            <div class="navbar-nav staff-top-sections">
                <a class="nav-link @ActiveTop("Staff")" asp-controller="Staff" asp-action="Index">
                    <span class="staff-top-icon" aria-hidden="true">ST</span>
                    <span>Home</span>
                </a>
                <a class="nav-link @ActiveTop("Production")" asp-controller="Production" asp-action="Index">
                    <span class="staff-top-icon" aria-hidden="true">KU</span>
                    <span>Kuchnia</span>
                </a>
                <a class="nav-link @ActiveTop("Warehouse")" asp-controller="Warehouse" asp-action="Index">
                    <span class="staff-top-icon" aria-hidden="true">MG</span>
                    <span>Magazyn</span>
                </a>
                <a class="nav-link @ActiveTop("Packing")" asp-controller="Packing" asp-action="Index">
                    <span class="staff-top-icon" aria-hidden="true">PK</span>
                    <span>Kompletacja</span>
                </a>
                <a class="nav-link @ActiveTop("Logistics")" asp-controller="Logistics" asp-action="Index">
                    <span class="staff-top-icon" aria-hidden="true">LG</span>
                    <span>Logistyka</span>
                </a>
            </div>
        </div>

        <div class="navbar-nav flex-row order-md-last ms-auto staff-top-actions">
            <button class="nav-link px-2 staff-icon-button" type="button" data-staff-theme-toggle title="Tryb ciemny" aria-label="Przelacz tryb ciemny">
                <svg class="icon" width="20" height="20" viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M18 15.6A7 7 0 0 1 8.4 6a7.6 7.6 0 1 0 9.6 9.6z" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
            </button>

            <div class="nav-item dropdown">
                <button class="nav-link px-2 staff-icon-button position-relative" type="button" data-bs-toggle="dropdown" aria-expanded="false" title="Powiadomienia" aria-label="Powiadomienia">
                    <svg class="icon" width="20" height="20" viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M15 17h5l-1.4-1.4A2 2 0 0 1 18 14.2V11a6 6 0 1 0-12 0v3.2a2 2 0 0 1-.6 1.4L4 17h5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                        <path d="M10 21h4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
                    </svg>
                    <span class="badge bg-red staff-notification-dot" aria-hidden="true"></span>
                </button>
                <div class="dropdown-menu dropdown-menu-end dropdown-menu-arrow staff-dropdown">
                    <div class="dropdown-header">Powiadomienia</div>
                    <div class="dropdown-item-text text-secondary">Brak nowych alarmow w trybie preview.</div>
                </div>
            </div>

            <div class="nav-item dropdown">
                <button class="nav-link px-2 staff-icon-button" type="button" data-bs-toggle="dropdown" aria-expanded="false" title="Szybkie przejscia" aria-label="Szybkie przejscia">
                    <svg class="icon" width="20" height="20" viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M4 4h6v6H4zM14 4h6v6h-6zM4 14h6v6H4zM14 14h6v6h-6z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" />
                    </svg>
                </button>
                <div class="dropdown-menu dropdown-menu-end dropdown-menu-arrow">
                    <a class="dropdown-item" asp-controller="Home" asp-action="Index">Strona klienta</a>
                    <a class="dropdown-item" asp-controller="Staff" asp-action="Index">Panel staff</a>
                    <a class="dropdown-item" asp-controller="DriverMobile" asp-action="Index">Panel kierowcy</a>
                </div>
            </div>

            <div class="nav-item dropdown">
                <button class="nav-link d-flex lh-1 text-reset p-0 staff-user-button" type="button" data-bs-toggle="dropdown" aria-expanded="false" title="Podglad uzytkownika" aria-label="Podglad uzytkownika">
                    <span class="avatar avatar-sm staff-avatar">PU</span>
                    <span class="d-none d-xl-block ps-2 text-start">
                        <span class="staff-user-name">Podglad uzytkownika</span>
                        <span class="staff-user-role">Brak roli</span>
                    </span>
                </button>
                <div class="dropdown-menu dropdown-menu-end dropdown-menu-arrow">
                    <div class="dropdown-header">Preview</div>
                    <a class="dropdown-item" asp-controller="Account" asp-action="Profile">Profil</a>
                    <a class="dropdown-item" asp-controller="Admin" asp-action="Settings">Ustawienia</a>
                </div>
            </div>
        </div>
    </div>
</header>
