@using System.Security.Claims
@{
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
    var userName = isAuthenticated
        ? User.Identity?.Name ?? "Uzytkownik"
        : "Podglad uzytkownika";
    var userRole = User.Claims
        .Where(claim => claim.Type == ClaimTypes.Role)
        .Select(claim => claim.Value)
        .Distinct()
        .FirstOrDefault() ?? "Brak roli";
    var avatarText = isAuthenticated
        ? new string(userName.Where(char.IsLetterOrDigit).Take(2).Select(char.ToUpperInvariant).ToArray())
        : "PU";
    if (string.IsNullOrWhiteSpace(avatarText))
    {
        avatarText = "PU";
    }

    var visibleSections = StaffNavigationCatalog.VisibleSections(User);
    var searchItems = visibleSections
        .SelectMany(section => section.Items.Select(item => new
        {
            title = item.Label,
            section = section.Label,
            description = item.Description,
            keywords = $"{item.Keywords} {section.Label}",
            href = Url.Action(item.Action, item.Controller) ?? "#",
            icon = item.Icon,
        }))
        .ToArray();
    var searchJson = System.Text.Json.JsonSerializer.Serialize(searchItems);
}

<header class="navbar navbar-expand-md d-print-none staff-topbar">
    <div class="container-xl staff-topbar-inner">
        <div class="staff-search staff-search-main" data-staff-search>
            <div class="input-icon">
                <span class="input-icon-addon">@Html.Raw(StaffIconCatalog.Get("search"))</span>
                <input class="form-control staff-search-input" type="search" placeholder="Szukaj widoku..." autocomplete="off" data-staff-search-input />
            </div>
            <div class="dropdown-menu staff-search-results" data-staff-search-results></div>
        </div>

        <div class="navbar-nav flex-row order-md-last ms-auto staff-top-actions">
            <button class="nav-link px-2 staff-icon-button" type="button" data-staff-theme-toggle title="Tryb ciemny" aria-label="Przelacz tryb ciemny">
                @Html.Raw(StaffIconCatalog.Get("moon"))
            </button>

            <div class="nav-item dropdown">
                <button class="nav-link px-2 staff-icon-button position-relative" type="button" data-bs-toggle="dropdown" aria-expanded="false" title="Powiadomienia" aria-label="Powiadomienia">
                    @Html.Raw(StaffIconCatalog.Get("bell"))
                    <span class="badge bg-red staff-notification-dot" aria-hidden="true"></span>
                </button>
                <div class="dropdown-menu dropdown-menu-end dropdown-menu-arrow staff-dropdown">
                    <div class="dropdown-header">Powiadomienia</div>
                    <div class="dropdown-item-text text-secondary">Brak nowych alarmow w trybie preview.</div>
                    <div class="dropdown-divider"></div>
                    @if (User.IsInRole("Warehouse") || User.IsInRole("WarehouseManager") || User.IsInRole("Admin"))
                    {
                        <a class="dropdown-item" asp-controller="Warehouse" asp-action="Temperatures">Temperatury HACCP</a>
                    }
                    @if (User.IsInRole("Kitchen") || User.IsInRole("KitchenManager") || User.IsInRole("Admin"))
                    {
                        <a class="dropdown-item" asp-controller="Production" asp-action="CookingCards">Karty gotowania</a>
                    }
                </div>
            </div>

            <div class="nav-item dropdown">
                <button class="nav-link px-2 staff-icon-button" type="button" data-bs-toggle="dropdown" aria-expanded="false" title="Szybkie przejscia" aria-label="Szybkie przejscia">
                    @Html.Raw(StaffIconCatalog.Get("grid"))
                </button>
                <div class="dropdown-menu dropdown-menu-end dropdown-menu-arrow">
                    <a class="dropdown-item" asp-controller="Home" asp-action="Index">Strona klienta</a>
                    <a class="dropdown-item" asp-controller="Staff" asp-action="Index">Panel staff</a>
                    @if (User.IsInRole("Driver") || User.IsInRole("DriverManager") || User.IsInRole("Admin"))
                    {
                        <a class="dropdown-item" asp-controller="DriverMobile" asp-action="Index">Panel kierowcy</a>
                    }
                    @if (User.IsInRole("Admin"))
                    {
                        <div class="dropdown-divider"></div>
                        <a class="dropdown-item" asp-controller="Admin" asp-action="Settings">Ustawienia preview</a>
                    }
                </div>
            </div>

            <div class="nav-item dropdown">
                <button class="nav-link d-flex lh-1 text-reset p-0 staff-user-button" type="button" data-bs-toggle="dropdown" aria-expanded="false" title="Podglad uzytkownika" aria-label="Podglad uzytkownika">
                    <span class="avatar avatar-sm staff-avatar">@avatarText</span>
                    <span class="d-none d-xl-block ps-2 text-start">
                        <span class="staff-user-name">@userName</span>
                        <span class="staff-user-role">@userRole</span>
                    </span>
                </button>
                <div class="dropdown-menu dropdown-menu-end dropdown-menu-arrow">
                    <div class="dropdown-header">Preview</div>
                    <a class="dropdown-item" asp-controller="Account" asp-action="Profile">Profil</a>
                    @if (User.IsInRole("Admin"))
                    {
                        <a class="dropdown-item" asp-controller="Admin" asp-action="Settings">Ustawienia</a>
                    }
                    <form asp-controller="Account" asp-action="Logout" method="post">
                        @Html.AntiForgeryToken()
                        <button class="dropdown-item" type="submit">Wyloguj</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
    <script type="application/json" id="staff-search-index">@Html.Raw(searchJson)</script>
</header>
