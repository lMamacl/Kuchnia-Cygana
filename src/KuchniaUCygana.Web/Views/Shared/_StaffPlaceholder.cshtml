@{
    var pageSection = ViewData["Section"]?.ToString() ?? "Sprint 4B";
    var description = ViewData["Description"]?.ToString() ?? "Widok szkieletowy gotowy do podpiecia komponentow.";
}
<div class="row row-cards">
    <div class="col-12">
        <div class="card">
            <div class="card-body">
                <div class="d-flex align-items-start justify-content-between gap-3">
                    <div>
                        <div class="text-secondary text-uppercase fw-bold small">@pageSection</div>
                        <h3 class="card-title mt-2">@ViewData["Title"]</h3>
                        <p class="text-secondary mb-0">@description</p>
                    </div>
                    <span class="badge bg-blue-lt text-blue">Preview</span>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card">
            <div class="card-body">
                <div class="text-secondary">Status</div>
                <div class="h2 mb-0">Gotowy shell</div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card">
            <div class="card-body">
                <div class="text-secondary">Dane</div>
                <div class="h2 mb-0">Do podpiecia</div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card">
            <div class="card-body">
                <div class="text-secondary">Nawigacja</div>
                <div class="h2 mb-0">Aktywna</div>
            </div>
        </div>
    </div>
</div>
