@model KuchniaUCygana.Application.DTOs.Orders.CartDto

@if (!Model.Items.Any())
{
    <div class="alert alert-info">
        Koszyk jest pusty.
        <a href="/" class="alert-link">Przejdz do katalogu diet</a>.
    </div>
}
else
{
    <div class="table-responsive mb-3">
        <table class="table table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>Dieta</th>
                    <th>Wariant</th>
                    <th class="text-center">kcal</th>
                    <th class="text-center">Dni</th>
                    <th class="text-end">Cena/dzien</th>
                    <th class="text-end">Razem</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td><strong>@item.DietName</strong></td>
                        <td>@item.VariantName</td>
                        <td class="text-center">@item.CaloriesPerDay</td>
                        <td class="text-center">@item.TotalDays</td>
                        <td class="text-end">@item.PricePerDay.ToString("C", new System.Globalization.CultureInfo("pl-PL"))</td>
                        <td class="text-end fw-semibold">@item.TotalPrice.ToString("C", new System.Globalization.CultureInfo("pl-PL"))</td>
                        <td class="text-end">
                            <button class="btn btn-sm btn-outline-danger"
                                    hx-post="/Cart/Remove/@item.DietVariantId"
                                    hx-target="#cart-contents"
                                    hx-swap="innerHTML">
                                Usun
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
            <tfoot class="table-light">
                <tr>
                    <td colspan="5" class="text-end fw-bold">Suma:</td>
                    <td class="text-end fw-bold fs-5">
                        @Model.TotalPrice.ToString("C", new System.Globalization.CultureInfo("pl-PL"))
                    </td>
                    <td></td>
                </tr>
            </tfoot>
        </table>
    </div>

    <div class="d-flex justify-content-between">
        <form asp-controller="Cart" asp-action="Clear" method="post">
            <button type="submit" class="btn btn-outline-secondary">Wyczysc koszyk</button>
        </form>

        <form asp-controller="Cart" asp-action="Checkout" method="post">
            <button type="submit" class="btn btn-primary btn-lg">
                Przejdz do realizacji zamowienia →
            </button>
        </form>
    </div>
}