@model KuchniaUCygana.Domain.Entities.Menu.Allergen
@{
    Layout = "_LayoutStaff";
    ViewData["Title"] = "Nowy Alergen";
    ViewData["Section"] = "Katalog Menu";
}

<div class="row justify-content-center">
    <div class="col-lg-8 col-xl-6">
        <div class="card card-premium">
            <div class="card-status-top bg-danger"></div>
            <div class="card-header bg-transparent py-3">
                <h3 class="card-title">Definiowanie Alergenu</h3>
            </div>
            <div class="card-body">
                <form asp-action="Create" method="post" autocomplete="off">
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label class="form-label required" asp-for="Code">Kod unikalny</label>
                        <input type="text" asp-for="Code" class="form-control" placeholder="np. GL" />
                        <span asp-validation-for="Code" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label required" asp-for="Name">Pełna nazwa</label>
                        <input type="text" asp-for="Name" class="form-control" placeholder="np. Gluten / Skorupiaki" />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <div class="card-footer bg-transparent p-0 pt-3 d-flex justify-content-between">
                        <a asp-action="Index" class="btn btn-outline-secondary">Anuluj</a>
                        <button type="submit" class="btn btn-danger">Dodaj Alergen</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}