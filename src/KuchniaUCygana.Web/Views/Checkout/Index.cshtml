@model KuchniaUCygana.Web.Models.CheckoutIndexViewModel
@{
    ViewData["Title"] = "Realizacja zamowienia";
}

<h2 class="mb-4">Realizacja zamowienia</h2>

<div class="row g-4">
    <div class="col-lg-7">
        <form asp-action="Index" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>

            {{!-- Wybor adresu --}}
            <div class="card mb-3">
                <div class="card-header fw-semibold">📍 Adres dostawy</div>
                <div class="card-body">
                    @if (!Model.Addresses.Any())
                    {
                        <div class="alert alert-warning mb-2">
                            Nie masz jeszcze zadnego adresu.
                            <a asp-controller="Address" asp-action="Create">Dodaj adres</a> przed zlozeniem zamowienia.
                        </div>
                    }
                    else
                    {
                        @foreach (var address in Model.Addresses)
                        {
                            <div class="form-check mb-2">
                                <input class="form-check-input" type="radio"
                                       name="SelectedAddressId"
                                       id="addr_@address.Id"
                                       value="@address.Id"
                                       @(Model.SelectedAddressId == address.Id ? "checked" : "") />
                                <label class="form-check-label" for="addr_@address.Id">
                                    <strong>@address.Label</strong>
                                    @if (address.IsDefault)
                                    {
                                        <span class="badge bg-primary ms-1">Domyslny</span>
                                    }
                                    <br />
                                    <small class="text-muted">@address.FullAddress</small>
                                </label>
                            </div>
                        }
                        <span asp-validation-for="SelectedAddressId" class="text-danger small"></span>
                        <a asp-controller="Address" asp-action="Create" class="btn btn-sm btn-outline-secondary mt-2">
                            + Dodaj nowy adres
                        </a>
                    }
                </div>
            </div>

            {{!-- Data i okno dostawy --}}
            <div class="card mb-3">
                <div class="card-header fw-semibold">📅 Data i godzina dostawy</div>
                <div class="card-body">
                    <div class="mb-3">
                        <label asp-for="StartDate" class="form-label">Data rozpoczecia</label>
                        <input asp-for="StartDate" type="date" class="form-control"
                               min="@DateTime.Today.AddDays(1).ToString("yyyy-MM-dd")"
                               value="@Model.StartDate.ToString("yyyy-MM-dd")" />
                        <span asp-validation-for="StartDate" class="text-danger small"></span>
                        <div class="form-text">Dostawa nie jest realizowana w niedziele.</div>
                    </div>

                    @if (Model.Windows.Any())
                    {
                        <div class="mb-3">
                            <label class="form-label">Okno czasowe dostawy (opcjonalnie)</label>
                            @foreach (var window in Model.Windows)
                            {
                                <div class="form-check">
                                    <input class="form-check-input" type="radio"
                                           name="SelectedWindowId"
                                           id="win_@window.Id"
                                           value="@window.Id"
                                           @(Model.SelectedWindowId == window.Id ? "checked" : "") />
                                    <label class="form-check-label" for="win_@window.Id">
                                        @window.Name
                                    </label>
                                </div>
                            }
                        </div>
                    }

                    <div class="mb-2">
                        <label asp-for="Notes" class="form-label">Uwagi do zamowienia (opcjonalnie)</label>
                        <textarea asp-for="Notes" class="form-control" rows="2"></textarea>
                    </div>
                </div>
            </div>

            <button type="submit" class="btn btn-primary btn-lg w-100"
                    @(!Model.Addresses.Any() ? "disabled" : "")>
                Przejdz do podsumowania →
            </button>
        </form>
    </div>

    {{!-- Podsumowanie koszyka --}}
    <div class="col-lg-5">
        <div class="card">
            <div class="card-header fw-semibold">🛒 Twoje diety</div>
            <div class="card-body p-0">
                <table class="table table-sm mb-0">
                    <tbody>
                        @foreach (var item in Model.Cart.Items)
                        {
                            <tr>
                                <td>
                                    <strong>@item.DietName</strong>
                                    <br />
                                    <small class="text-muted">@item.VariantName · @item.CaloriesPerDay kcal · @item.TotalDays dni</small>
                                </td>
                                <td class="text-end align-middle">
                                    @item.TotalPrice.ToString("C", new System.Globalization.CultureInfo("pl-PL"))
                                </td>
                            </tr>
                        }
                    </tbody>
                    <tfoot class="table-light">
                        <tr>
                            <td class="fw-bold">Razem</td>
                            <td class="text-end fw-bold">
                                @Model.Cart.TotalPrice.ToString("C", new System.Globalization.CultureInfo("pl-PL"))
                            </td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}