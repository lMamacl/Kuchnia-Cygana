@model KuchniaUCygana.Web.Models.DiscountPartialViewModel
@{
    var culture = new System.Globalization.CultureInfo("pl-PL");
}

<div id="discount-section">
    <div class="summary-card mb-3">
        <div class="card-body p-4">
            <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-3">
                <div>
                    <div class="text-success small fw-bold text-uppercase mb-2">Rabat</div>
                    <h2 class="h5 fw-bold mb-0">Kod rabatowy</h2>
                </div>
                @if (Model.WasApplied)
                {
                    <span class="badge text-bg-success rounded-pill">Zastosowany</span>
                }
            </div>

            @if (Model.WasApplied)
            {
                <div class="alert alert-success py-2 mb-3">
                    Kod został zastosowany. Rabat: <strong>-@Model.DiscountAmount.ToString("C", culture)</strong>
                </div>
            }

            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <div class="alert alert-danger py-2 mb-3">@Model.ErrorMessage</div>
            }

            <div class="input-group input-group-lg">
                <input type="text" name="Code" class="form-control"
                       placeholder="Wpisz kod rabatowy"
                       value="@(Model.WasApplied ? Model.AppliedCode : "")" />
                <input type="hidden" name="OrderId" value="@Model.OrderId" />
                <button class="btn btn-outline-success"
                        hx-post="/Checkout/ApplyDiscount"
                        hx-include="closest .card-body"
                        hx-target="#discount-section"
                        hx-swap="outerHTML">
                    Zastosuj
                </button>
            </div>
        </div>
    </div>
</div>
