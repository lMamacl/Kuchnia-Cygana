@model KuchniaUCygana.Domain.Entities.Orders.Order
@{
    ViewData["Title"] = "Zamówienie opłacone pomyślnie";
}

<div class="container my-5 text-center">
    <div class="row justify-content-center">
        <div class="col-lg-7">
            <div class="card shadow-lg border-0 rounded-3 p-5">
                <div class="mb-4">
                    <div class="display-1 text-success animate__animated animate__heartBeat">🎉</div>
                </div>
                <h2 class="fw-bold text-dark mb-2">Sukces! Płatność przyjęta!</h2>
                <p class="text-muted fs-5 mb-4">
                    Dziękujemy za skorzystanie z cateringu <strong>Kuchnia u Cygana</strong>. Twoje zamówienie zostało przekazane do działu produkcji.
                </p>

                <div class="bg-light rounded-3 p-4 text-start mb-4 border">
                    <h6 class="fw-bold text-uppercase text-secondary border-bottom pb-2 mb-3">Szczegóły Zamówienia</h6>
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Numer identyfikacyjny:</span>
                        <span class="fw-bold text-dark">@Model.OrderNumber</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Status zamówienia:</span>
                        <span class="badge bg-success">Opłacone (W Produkcji)</span>
                    </div>
                    <div class="d-flex justify-content-between border-top pt-2 mt-2">
                        <span class="fw-bold fs-5 text-dark">Suma pobrana:</span>
                        <span class="fw-bold fs-5 text-success">@Model.FinalPrice.ToString("C", new System.Globalization.CultureInfo("pl-PL"))</span>
                    </div>
                </div>

                <div class="d-grid gap-2 d-sm-flex justify-content-sm-center">
                    <a asp-controller="Order" asp-action="Index" class="btn btn-primary btn-lg px-4 fw-bold shadow-sm">
                        📦 Moje zamówienia
                    </a>
                    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary btn-lg px-4">
                        🏠 Strona główna
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>