@model HumanResourcesDashboardViewModel
@{
    Layout = "_LayoutStaff";
}

<div class="row row-cards">
    <div class="col-xl-4">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">Nowy pracownik</h3>
            </div>
            <form asp-action="CreateEmployee" method="post">
                @Html.AntiForgeryToken()
                <div class="card-body">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    <div class="mb-3">
                        <label class="form-label" for="employee-user">Uzytkownik</label>
                        <select id="employee-user" class="form-select" name="UserId" required>
                            <option value="">Wybierz konto</option>
                            @foreach (var user in Model.Users.OrderBy(x => x.FullName))
                            {
                                <option value="@user.Id">@user.FullName (@user.Email, @user.Role)</option>
                            }
                        </select>
                    </div>
                    <div class="row g-2">
                        <div class="col-sm-6">
                            <label class="form-label" for="employee-first-name">Imie</label>
                            <input id="employee-first-name" class="form-control" name="FirstName" value="@Model.NewEmployee.FirstName" maxlength="50" required />
                        </div>
                        <div class="col-sm-6">
                            <label class="form-label" for="employee-last-name">Nazwisko</label>
                            <input id="employee-last-name" class="form-control" name="LastName" value="@Model.NewEmployee.LastName" maxlength="50" required />
                        </div>
                    </div>
                    <div class="mt-3">
                        <label class="form-label" for="employee-email">Email</label>
                        <input id="employee-email" class="form-control" name="Email" type="email" value="@Model.NewEmployee.Email" maxlength="100" required />
                    </div>
                    <div class="mt-3">
                        <label class="form-label" for="employee-phone">Telefon</label>
                        <input id="employee-phone" class="form-control" name="PhoneNumber" value="@Model.NewEmployee.PhoneNumber" maxlength="15" />
                    </div>
                    <div class="row g-2 mt-1">
                        <div class="col-sm-6">
                            <label class="form-label" for="employee-hire">Data zatrudnienia</label>
                            <input id="employee-hire" class="form-control" name="HireDate" type="date" value="@Model.NewEmployee.HireDate.ToString("yyyy-MM-dd")" required />
                        </div>
                        <div class="col-sm-6">
                            <label class="form-label" for="employee-department">Dzial</label>
                            <select id="employee-department" class="form-select" name="DepartmentId" required>
                                <option value="">Wybierz dzial</option>
                                @foreach (var department in Model.Departments.OrderBy(x => x.Name))
                                {
                                    <option value="@department.Id">@department.Name</option>
                                }
                            </select>
                        </div>
                    </div>
                    <div class="mt-3">
                        <label class="form-label" for="employee-position">Stanowisko</label>
                        <input id="employee-position" class="form-control" name="Position" value="@Model.NewEmployee.Position" maxlength="100" required />
                    </div>
                    <input type="hidden" name="IsActive" value="true" />
                </div>
                <div class="card-footer text-end">
                    <button class="btn btn-primary" type="submit">Dodaj pracownika</button>
                </div>
            </form>
        </div>
    </div>
    <div class="col-xl-8">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">Pracownicy</h3>
            </div>
            <div class="table-responsive">
                <table class="table table-vcenter card-table">
                    <thead>
                        <tr>
                            <th>Pracownik</th>
                            <th>Dzial</th>
                            <th>Stanowisko</th>
                            <th>Status</th>
                            <th class="text-end">Akcje</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var employee in Model.Employees.OrderBy(x => x.LastName).ThenBy(x => x.FirstName))
                        {
                            <tr>
                                <td>
                                    <div class="fw-semibold">@employee.FullName</div>
                                    <div class="text-secondary small">@employee.Email</div>
                                </td>
                                <td>@(employee.DepartmentName ?? "-")</td>
                                <td>@employee.Position</td>
                                <td>
                                    <span class="badge @(employee.IsActive ? "bg-green-lt text-green" : "bg-secondary-lt text-secondary")">
                                        @(employee.IsActive ? "Aktywny" : "Nieaktywny")
                                    </span>
                                </td>
                                <td class="text-end">
                                    @if (employee.IsActive && (User.IsInRole("HRManager") || User.IsInRole("Admin")))
                                    {
                                        <form asp-action="DeactivateEmployee" asp-route-id="@employee.Id" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button class="btn btn-sm btn-outline-danger" type="submit">Dezaktywuj</button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                        @if (Model.Employees.Count == 0)
                        {
                            <tr>
                                <td colspan="5" class="text-secondary text-center py-4">Brak pracownikow.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
