@model HumanResourcesDashboardViewModel
@{
    Layout = "_LayoutStaff";
    var workSchedulesPage = Model.WorkSchedulesPage;
    var filter = Model.WorkSchedulesFilter;
    var roles = Model.AvailableRoles
        .OrderBy(role => role)
        .ToArray();
}

<div class="row row-cards">
    <div class="col-12">
        <div class="card">
            <div class="card-header d-flex flex-wrap align-items-center justify-content-between gap-2">
                <h3 class="card-title">Grafik</h3>
                <a class="btn btn-primary btn-sm" asp-controller="HumanResources" asp-action="NewWorkSchedule">Nowa zmiana</a>
            </div>
            <div class="card-body border-bottom">
                <form method="get" asp-controller="HumanResources" asp-action="Schedules">
                    <input type="hidden" name="Page" value="1" />
                    <div class="row g-2 align-items-end">
                        <div class="col-md-3">
                            <label class="form-label" for="Search">Szukaj</label>
                            <input class="form-control" id="Search" name="Search" type="search" value="@filter.Search" placeholder="Pracownik, rola, konto..." />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label" for="From">Od</label>
                            <input class="form-control" id="From" name="From" type="date" value="@filter.From?.ToString("yyyy-MM-dd")" />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label" for="To">Do</label>
                            <input class="form-control" id="To" name="To" type="date" value="@filter.To?.ToString("yyyy-MM-dd")" />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label" for="Shift">Zmiana</label>
                            <select class="form-select" id="Shift" name="Shift">
                                <option value="">Wszystkie</option>
                                @foreach (var shift in Enum.GetValues<WorkShift>())
                                {
                                    <option value="@shift" selected="@(string.Equals(filter.Shift, shift.ToString(), StringComparison.OrdinalIgnoreCase))">@EnumDisplayNames.DisplayName(shift)</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-2">
                            <label class="form-label" for="Role">Rola konta</label>
                            <select class="form-select" id="Role" name="Role">
                                <option value="">Wszystkie</option>
                                @foreach (var role in roles)
                                {
                                    <option value="@role" selected="@(string.Equals(filter.Role, role, StringComparison.OrdinalIgnoreCase))">@role</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-1">
                            <label class="form-label" for="PageSize">Na stronie</label>
                            <select class="form-select" id="PageSize" name="PageSize">
                                @foreach (var size in new[] { 10, 25, 50, 100 })
                                {
                                    <option value="@size" selected="@(filter.PageSize == size)">@size</option>
                                }
                            </select>
                        </div>
                        <div class="col-12 d-flex justify-content-end gap-2">
                            <a class="btn btn-outline-secondary" asp-controller="HumanResources" asp-action="Schedules">Wyczysc</a>
                            <button class="btn btn-primary" type="submit">Filtruj</button>
                        </div>
                    </div>
                </form>
            </div>
            <div class="table-responsive">
                <table class="table table-vcenter card-table">
                    <thead>
                        <tr>
                            <th>Data</th>
                            <th>Zmiana</th>
                            <th>Pracownik</th>
                            <th>Konto</th>
                            <th>Rola na zmianie</th>
                            <th>Edycja</th>
                            <th class="text-end">Akcje</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var schedule in workSchedulesPage.Items)
                        {
                            var accountRole = string.IsNullOrWhiteSpace(schedule.UserRole) ? "-" : schedule.UserRole;
                            <tr>
                                <td class="text-nowrap">@schedule.ShiftDate.ToString("dd.MM.yyyy")</td>
                                <td>@EnumDisplayNames.WorkShiftName(schedule.Shift)</td>
                                <td>@(schedule.EmployeeFullName ?? $"Uzytkownik #{schedule.UserId}")</td>
                                <td><span class="badge bg-blue-lt text-blue">@accountRole</span></td>
                                <td>@(schedule.RoleAtShift ?? "-")</td>
                                <td style="min-width: 520px;">
                                    <form asp-action="UpdateWorkSchedule" asp-route-id="@schedule.Id" method="post" class="row g-2 align-items-end justify-content-end">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="Id" value="@schedule.Id" />
                                        <div class="col-md-3">
                                            <label class="form-label small" for="schedule-date-@schedule.Id">Data</label>
                                            <input id="schedule-date-@schedule.Id" class="form-control form-control-sm" name="ShiftDate" type="date" value="@schedule.ShiftDate.ToString("yyyy-MM-dd")" required />
                                        </div>
                                        <div class="col-md-3">
                                            <label class="form-label small" for="schedule-user-@schedule.Id">Uzytkownik</label>
                                            <input type="hidden" name="UserId" value="@schedule.UserId" />
                                            <input id="schedule-user-@schedule.Id" class="form-control form-control-sm" value="@(schedule.EmployeeFullName ?? $"Uzytkownik #{schedule.UserId}")" disabled />
                                        </div>
                                        <div class="col-md-2">
                                            <label class="form-label small" for="schedule-shift-@schedule.Id">Zmiana</label>
                                            <select id="schedule-shift-@schedule.Id" class="form-select form-select-sm" name="Shift" required>
                                                @foreach (var shift in Enum.GetValues<WorkShift>())
                                                {
                                                    <option value="@shift" selected="@(string.Equals(schedule.Shift, shift.ToString(), StringComparison.Ordinal))">@EnumDisplayNames.DisplayName(shift)</option>
                                                }
                                            </select>
                                        </div>
                                        <div class="col-md-2">
                                            <label class="form-label small" for="schedule-role-@schedule.Id">Rola</label>
                                            <input id="schedule-role-@schedule.Id" class="form-control form-control-sm" name="RoleAtShift" value="@schedule.RoleAtShift" maxlength="50" />
                                        </div>
                                        <div class="col-md-2 text-end">
                                            <button class="btn btn-sm btn-outline-primary" type="submit">Zmien</button>
                                        </div>
                                    </form>
                                </td>
                                <td class="text-end">
                                    @if (User.IsInRole("HRManager") || User.IsInRole("Admin"))
                                    {
                                        <form asp-action="DeleteWorkSchedule" asp-route-id="@schedule.Id" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button class="btn btn-sm btn-outline-danger" type="submit">Usun</button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                        @if (workSchedulesPage.TotalCount == 0)
                        {
                            <tr>
                                <td colspan="7" class="text-secondary text-center py-4">
                                    @(filter.HasActiveCriteria
                                        ? "Brak zmian w grafiku dla wybranych filtrow."
                                        : "Brak zmian w grafiku. Seeder dodaje startowy grafik dla podstawowych rol.")
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            @await Html.PartialAsync("_StaffPagination", StaffPaginationViewModel.FromPagedList(
                workSchedulesPage,
                "HumanResources",
                "Schedules",
                filter.ToRouteValues()))
        </div>
    </div>
</div>
