@model HumanResourcesDashboardViewModel
@{
    Layout = "_LayoutStaff";
    var leaveRequestsPage = Model.LeaveRequestsPage;

    string LeaveTypeName(int value) => value switch
    {
        0 => "Wypoczynkowy",
        1 => "Chorobowy",
        2 => "Okolicznosciowy",
        _ => $"Typ {value}",
    };

    string LeaveStatusName(int value) => value switch
    {
        0 => "Oczekuje",
        1 => "Zaakceptowany",
        2 => "Odrzucony",
        _ => $"Status {value}",
    };

    string LeaveStatusClass(int value) => value switch
    {
        1 => "bg-green-lt text-green",
        2 => "bg-red-lt text-red",
        _ => "bg-blue-lt text-blue",
    };
}

<div class="row row-cards">
    <div class="col-12">
        <div class="card">
            <div class="card-header d-flex flex-wrap align-items-center justify-content-between gap-2">
                <h3 class="card-title">Wnioski urlopowe</h3>
                <div class="d-flex flex-wrap align-items-center gap-2">
                    <span class="text-secondary small">Pokazuje @leaveRequestsPage.FirstItem-@leaveRequestsPage.LastItem z @leaveRequestsPage.TotalCount</span>
                    <a class="btn btn-primary btn-sm" asp-controller="HumanResources" asp-action="NewLeaveRequest">Nowy wniosek</a>
                </div>
            </div>
            <div class="table-responsive">
                <table class="table table-vcenter card-table">
                    <thead>
                        <tr>
                            <th>Pracownik</th>
                            <th>Zakres</th>
                            <th>Typ</th>
                            <th>Status</th>
                            <th>Decyzja</th>
                            <th class="text-end">Akcja</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var leave in leaveRequestsPage.Items)
                        {
                            <tr>
                                <td>@(leave.EmployeeFullName ?? $"#{leave.EmployeeId}")</td>
                                <td class="text-nowrap">@leave.StartDate.ToString("dd.MM.yyyy") - @leave.EndDate.ToString("dd.MM.yyyy")</td>
                                <td>@LeaveTypeName(leave.LeaveType)</td>
                                <td><span class="badge @LeaveStatusClass(leave.Status)">@LeaveStatusName(leave.Status)</span></td>
                                <td>
                                    @if (leave.ApprovedByEmployeeId.HasValue)
                                    {
                                        <span>@(leave.ApprovedByEmployeeFullName ?? $"#{leave.ApprovedByEmployeeId}")</span>
                                    }
                                    else if (!string.IsNullOrWhiteSpace(leave.RejectionReason))
                                    {
                                        <span class="text-secondary">@leave.RejectionReason</span>
                                    }
                                    else
                                    {
                                        <span class="text-secondary">-</span>
                                    }
                                </td>
                                <td class="text-end">
                                    @if (User.IsInRole("HRManager") || User.IsInRole("Admin"))
                                    {
                                        <form asp-action="ReviewLeaveRequest" asp-route-id="@leave.Id" method="post" class="d-inline-flex gap-2 justify-content-end">
                                            @Html.AntiForgeryToken()
                                            <select class="form-select form-select-sm" name="approvedByEmployeeId">
                                                <option value="">Bez osoby</option>
                                                @foreach (var employee in Model.Employees.Where(x => x.IsActive).OrderBy(x => x.FullName))
                                                {
                                                    <option value="@employee.Id">@employee.FullName</option>
                                                }
                                            </select>
                                            <button class="btn btn-sm btn-outline-success" name="status" value="1" type="submit">Akceptuj</button>
                                            <button class="btn btn-sm btn-outline-danger" name="status" value="2" type="submit">Odrzuc</button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                        @if (leaveRequestsPage.TotalCount == 0)
                        {
                            <tr>
                                <td colspan="6" class="text-secondary text-center py-4">
                                    Brak wnioskow urlopowych. Seeder dodaje przykladowe pozycje, gdy baza jest pusta.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            @if (leaveRequestsPage.TotalCount > 0)
            {
                <div class="card-footer d-flex flex-wrap align-items-center justify-content-between gap-2">
                    <span class="text-secondary small">Strona @leaveRequestsPage.Page / @leaveRequestsPage.TotalPages, po @leaveRequestsPage.PageSize rekordow</span>
                    <div class="btn-list">
                        <a class="btn btn-outline-secondary @(leaveRequestsPage.HasPrevious ? string.Empty : "disabled")"
                           asp-controller="HumanResources"
                           asp-action="Leaves"
                           asp-route-page="@leaveRequestsPage.PreviousPage"
                           asp-route-pageSize="@leaveRequestsPage.PageSize">Poprzednia</a>
                        <a class="btn btn-outline-secondary @(leaveRequestsPage.HasNext ? string.Empty : "disabled")"
                           asp-controller="HumanResources"
                           asp-action="Leaves"
                           asp-route-page="@leaveRequestsPage.NextPage"
                           asp-route-pageSize="@leaveRequestsPage.PageSize">Nastepna</a>
                    </div>
                </div>
            }
        </div>
    </div>
</div>
