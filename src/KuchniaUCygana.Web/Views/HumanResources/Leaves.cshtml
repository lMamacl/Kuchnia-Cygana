@model HumanResourcesDashboardViewModel
@{
    Layout = "_LayoutStaff";
}

<div class="row row-cards">
    <div class="col-lg-4">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">Nowy wniosek</h3>
            </div>
            <form asp-action="CreateLeaveRequest" method="post">
                @Html.AntiForgeryToken()
                <div class="card-body">
                    <div class="mb-3">
                        <label class="form-label" for="leave-employee">Pracownik</label>
                        <select id="leave-employee" class="form-select" name="EmployeeId" required>
                            <option value="">Wybierz pracownika</option>
                            @foreach (var employee in Model.Employees.Where(x => x.IsActive).OrderBy(x => x.FullName))
                            {
                                <option value="@employee.Id">@employee.FullName</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="leave-type">Typ urlopu</label>
                        <select id="leave-type" class="form-select" name="LeaveType">
                            <option value="0">Wypoczynkowy</option>
                            <option value="1">Chorobowy</option>
                            <option value="2">Okolicznosciowy</option>
                        </select>
                    </div>
                    <div class="row g-2">
                        <div class="col-sm-6">
                            <label class="form-label" for="leave-start">Od</label>
                            <input id="leave-start" class="form-control" name="StartDate" type="date" value="@Model.NewLeaveRequest.StartDate.ToString("yyyy-MM-dd")" required />
                        </div>
                        <div class="col-sm-6">
                            <label class="form-label" for="leave-end">Do</label>
                            <input id="leave-end" class="form-control" name="EndDate" type="date" value="@Model.NewLeaveRequest.EndDate.ToString("yyyy-MM-dd")" required />
                        </div>
                    </div>
                </div>
                <div class="card-footer text-end">
                    <button class="btn btn-primary" type="submit">Dodaj wniosek</button>
                </div>
            </form>
        </div>
    </div>
    <div class="col-lg-8">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">Wnioski urlopowe</h3>
            </div>
            <div class="table-responsive">
                <table class="table table-vcenter card-table">
                    <thead>
                        <tr>
                            <th>Pracownik</th>
                            <th>Zakres</th>
                            <th>Typ</th>
                            <th>Status</th>
                            <th class="text-end">Decyzja</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var leave in Model.LeaveRequests.OrderByDescending(x => x.CreatedAt))
                        {
                            <tr>
                                <td>@(leave.EmployeeFullName ?? $"#{leave.EmployeeId}")</td>
                                <td>@leave.StartDate.ToString("dd.MM.yyyy") - @leave.EndDate.ToString("dd.MM.yyyy")</td>
                                <td>@leave.LeaveType</td>
                                <td><span class="badge bg-blue-lt text-blue">@leave.Status</span></td>
                                <td class="text-end">
                                    @if (User.IsInRole("HRManager") || User.IsInRole("Admin"))
                                    {
                                        <form asp-action="ReviewLeaveRequest" asp-route-id="@leave.Id" method="post" class="d-inline-flex gap-2 justify-content-end">
                                            @Html.AntiForgeryToken()
                                            <select class="form-select form-select-sm" name="approvedByEmployeeId">
                                                <option value="">Bez osoby</option>
                                                @foreach (var employee in Model.Employees.Where(x => x.IsActive).OrderBy(x => x.FullName))
                                                {
                                                    <option value="@employee.Id">@employee.FullName</option>
                                                }
                                            </select>
                                            <button class="btn btn-sm btn-outline-success" name="status" value="1" type="submit">Akceptuj</button>
                                            <button class="btn btn-sm btn-outline-danger" name="status" value="2" type="submit">Odrzuc</button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                        @if (Model.LeaveRequests.Count == 0)
                        {
                            <tr>
                                <td colspan="5" class="text-secondary text-center py-4">Brak wnioskow.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
