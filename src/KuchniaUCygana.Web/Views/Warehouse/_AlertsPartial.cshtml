@model IEnumerable<KuchniaUCygana.Application.DTOs.Warehouse.InventoryAlertDto>

<div class="row g-3 my-1">
    @if (!Model.Any())
    {
        <div class="col-12">
            <div class="alert alert-premium-smart alert-success d-flex align-items-center gap-3 p-3 mb-0">
                <span class="status-dot bg-success"></span>
                <div class="text-dark fw-bold">Wszystkie zapasy w normie. Brak alertów.</div>
            </div>
        </div>
    }
    else
    {
        foreach (var alert in Model)
        {
            var isDanger = alert.AlertType == "LOW_STOCK" || (alert.DaysUntilExpiry.HasValue && alert.DaysUntilExpiry <= 3);
            <div class="col-md-6">
                <div class="alert alert-premium-smart @(isDanger ? "alert-danger" : "alert-warning") d-flex align-items-start gap-3 p-3 mb-0">
                    <span class="status-dot-pulse @(isDanger ? "bg-danger" : "bg-warning") mt-2"></span>
                    <div class="flex-fill">
                        <div class="font-weight-bold fw-bold mb-1 text-dark">
                            @alert.StockItemName
                        </div>
                        <div class="text-secondary small">
                            @alert.Message
                        </div>
                    </div>
                    <span class="badge bg-secondary-lt">@alert.AlertType</span>
                </div>
            </div>
        }
    }
</div>
