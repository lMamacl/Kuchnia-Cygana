@model KuchniaUCygana.Application.DTOs.Warehouse.LogTemperatureRequest
@{
    Layout = "_LayoutStaff";
    ViewData["Title"] = "Temperatury i Kontrola HACCP";
    ViewData["Section"] = "Magazyn";
    ViewData["Description"] = "Monitorowanie i rejestracja temperatur urządzeń chłodniczych zgodnie z procedurami sanitarnymi.";

    var devices = new[]
    {
        "Lodówka #1 - Nabiał (Limit: 2°C do 6°C)",
        "Chłodnia #2 - Mięso (Limit: 0°C do 4°C)",
        "Zamrażarka #3 - Ryby (Limit: -22°C do -18°C)",
        "Lodówka #4 - Warzywa (Limit: 4°C do 8°C)",
        "Witryna Wydawcza (Limit: 2°C do 8°C)"
    };

    var recentLogs = ViewBag.RecentLogs as IEnumerable<KuchniaUCygana.Application.DTOs.Warehouse.TemperatureLogDto>
                     ?? Array.Empty<KuchniaUCygana.Application.DTOs.Warehouse.TemperatureLogDto>();

    string FormatRecordedAt(DateTimeOffset dto)
    {
        var localTime = dto.ToLocalTime();
        var today = DateTime.Today;
        var yesterday = today.AddDays(-1);

        if (localTime.Date == today)
        {
            return $"Dzisiaj, {localTime:HH:mm}";
        }
        if (localTime.Date == yesterday)
        {
            return $"Wczoraj, {localTime:HH:mm}";
        }
        return localTime.ToString("yyyy-MM-dd, HH:mm");
    }
}

<div class="row g-4">
    <!-- Rejestracja temperatury -->
    <div class="col-lg-5">
        <div class="card card-premium">
            <div class="card-status-top bg-azure"></div>
            <div class="card-header bg-transparent py-3">
                <h3 class="card-title d-flex align-items-center gap-2">
                    <svg xmlns="http://www.w3.org/2000/svg" class="icon text-azure" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M10 13.5a2.5 2.5 0 1 0 4 0v-8.5a2 2 0 0 0 -4 0v8.5z" /><path d="M10 9l4 0" /><path d="M6.5 17h11" /></svg>
                    Zarejestruj odczyt
                </h3>
            </div>
            <div class="card-body">
                <form asp-action="LogTemperature" method="post" autocomplete="off">
                    @Html.AntiForgeryToken()

                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger" role="alert">
                            <div class="text-secondary">Wykryto błędy formularza. Proszę poprawić pola poniżej.</div>
                        </div>
                    }

                    <div class="mb-3">
                        <label class="form-label required">Urządzenie / Lokalizacja</label>
                        <select asp-for="DeviceNameOrLocation" class="form-select" required aria-label="Wybierz urządzenie">
                            <option value="">-- Wybierz lokalizację --</option>
                            @foreach (var dev in devices)
                            {
                                <option value="@dev.Split(" (")[0]">@dev</option>
                            }
                        </select>
                        <span asp-validation-for="DeviceNameOrLocation" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label required">Odczytana temperatura (°C)</label>
                        <div class="input-icon">
                            <input type="number" step="0.1" asp-for="TemperatureCelsius" class="form-control" placeholder="0.0" required />
                            <span class="input-icon-addon">
                                °C
                            </span>
                        </div>
                        <span asp-validation-for="TemperatureCelsius" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Uwagi / Działania korygujące</label>
                        <textarea asp-for="Remarks" class="form-control" rows="3" placeholder="np. Drzwi niedomknięte, włączono odszranianie..."></textarea>
                        <span asp-validation-for="Remarks" class="text-danger small"></span>
                    </div>

                    <div class="row g-2">
                        <div class="col-md-6">
                            <button type="submit" name="actionType" value="addAnother" class="btn btn-outline-primary w-100">Zapisz i dodaj kolejny</button>
                        </div>
                        <div class="col-md-6">
                            <button type="submit" name="actionType" value="save" class="btn btn-primary w-100">Zapisz i zamknij</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Ostatnie pomiary i Raportowanie -->
    <div class="col-lg-7">
        <div class="card card-premium">
            <div class="card-header bg-transparent d-flex justify-content-between align-items-center">
                <h3 class="card-title">Dziennik Pomiarów HACCP (Ostatnie 24h)</h3>
                <a asp-action="HaccpReport" class="btn btn-sm btn-outline-secondary">
                    <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M14 3v4a1 1 0 0 0 1 1h4" /><path d="M17 21h-10a2 2 0 0 1 -2 -2v-14a2 2 0 0 1 2 -2h7l5 5v11a2 2 0 0 1 -2 2z" /><path d="M9 17h6" /><path d="M9 13h6" /></svg>
                    Pełny raport HACCP
                </a>
            </div>
            <div class="table-responsive">
                <table class="table table-vcenter card-table table-premium">
                    <thead>
                        <tr>
                            <th>Godzina odczytu</th>
                            <th>Urządzenie</th>
                            <th class="text-end">Temperatura</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var log in recentLogs)
                        {
                            var color = log.IsOutOfRange ? "danger" : "success";
                            var statusText = log.IsOutOfRange ? "Ostrzeżenie (Poza normą)" : "OK";
                            <tr>
                                <td class="text-secondary small">@FormatRecordedAt(log.RecordedAt)</td>
                                <td class="font-weight-medium fw-bold text-dark">
                                    @log.DeviceNameOrLocation
                                    @if (!string.IsNullOrEmpty(log.Remarks))
                                    {
                                        <div class="text-secondary small fw-normal text-muted mt-1">@log.Remarks</div>
                                    }
                                </td>
                                <td class="text-end font-weight-bold fw-bold text-@color">
                                    @log.RecordedTemperatureCelsius.ToString("F1")°C
                                </td>
                                <td>
                                    <span class="badge bg-@color-lt text-@color">
                                        @statusText
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<div class="row g-4 mt-3">
    <div class="col-12">
        <div class="card card-premium">
            <div class="card-header d-flex justify-content-between align-items-center bg-transparent py-3">
                <h3 class="card-title">Wykres Temperatur (Ostatnie 7 dni)</h3>
                <div class="d-flex align-items-center gap-2">
                    <select id="ChartDeviceSelect" class="form-select form-select-sm w-auto" onchange="loadTemperatureChart()">
                        <option value="">Wszystkie urządzenia</option>
                        @foreach (var dev in devices)
                        {
                            <option value="@dev.Split(" (")[0]">@dev.Split(" (")[0]</option>
                        }
                    </select>
                </div>
            </div>
            <div class="card-body">
                <div style="height: 300px;">
                    <canvas id="tempChart"></canvas>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        let tempChart = null;

        async function loadTemperatureChart() {
            const device = document.getElementById("ChartDeviceSelect").value;
            const response = await fetch(`/warehouse/temperature-chart-data?device=${encodeURIComponent(device)}&days=7`);
            const data = await response.json();

            const labels = data.map(d => new Date(d.recordedAt).toLocaleString('pl-PL', { day: '2-digit', month: '2-digit', hour: '2-digit', minute: '2-digit' }));
            const temps = data.map(d => d.temperature);
            const alertColors = data.map(d => d.isAlert ? '#ef4444' : '#3b82f6');

            const ctx = document.getElementById('tempChart').getContext('2d');

            if (tempChart) {
                tempChart.destroy();
            }

            tempChart = new Chart(ctx, {
                type: 'line',
                data: {
                    labels: labels,
                    datasets: [{
                        label: 'Temperatura (°C)',
                        data: temps,
                        borderColor: '#206bc4',
                        backgroundColor: 'rgba(32, 107, 196, 0.1)',
                        pointBackgroundColor: alertColors,
                        pointBorderColor: alertColors,
                        pointRadius: 4,
                        pointHoverRadius: 6,
                        tension: 0.2,
                        fill: true
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: {
                        y: {
                            ticks: {
                                callback: function(value) {
                                    return value + '°C';
                                }
                            },
                            suggestedMin: -25,
                            suggestedMax: 10
                        }
                    },
                    plugins: {
                        legend: {
                            display: false
                        }
                    }
                }
            });
        }

        window.addEventListener('DOMContentLoaded', () => {
            loadTemperatureChart();
        });
    </script>
}
