@model KuchniaUCygana.Application.DTOs.Warehouse.ReceiveDeliveryRequest
@{
    Layout = "_LayoutStaff";
    ViewData["Title"] = "Przyjmij Dostawę";
    ViewData["Section"] = "Magazyn";
    ViewData["Description"] = "Wprowadź dane nowej partii składnika dostarczonej do magazynu w celu rejestracji.";

    var mockItemsList = new[]
    {
        new { Id = 1, Name = "Mąka pszenna typ 500 (kg)" },
        new { Id = 2, Name = "Pierś z kurczaka świeża (kg)" },
        new { Id = 3, Name = "Śmietanka UHT 30% (l)" },
        new { Id = 4, Name = "Pomidory krojone puszka (szt)" },
        new { Id = 5, Name = "Masło Extra 82% (kg)" }
    };
}

<div class="row justify-content-center">
    <div class="col-lg-8 col-xl-6">
        <div class="card card-premium">
            <div class="card-status-top bg-success"></div>
            <div class="card-header bg-transparent py-3">
                <h3 class="card-title d-flex align-items-center gap-2">
                    <svg xmlns="http://www.w3.org/2000/svg" class="icon text-success" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M12 3l8 4.5l-8 4.5l-8 -4.5z" /><path d="M12 12l8 4.5l-8 4.5l-8 -4.5z" /><path d="M12 12v9" /><path d="M12 3v9" /><path d="M20 7.5v9" /><path d="M4 7.5v9" /></svg>
                    Nowa partia magazynowa
                </h3>
            </div>
            <div class="card-body">
                <form asp-action="Receive" method="post" autocomplete="off">
                    @Html.AntiForgeryToken()
                    
                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger" role="alert">
                            <div class="d-flex">
                                <div>
                                    <svg xmlns="http://www.w3.org/2000/svg" class="icon alert-icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M3 12a9 9 0 1 0 18 0a9 9 0 0 0 -18 0" /><path d="M12 8v4" /><path d="M12 16h.01" /></svg>
                                </div>
                                <div>
                                    <h4 class="alert-title">Wykryto błędy formularza</h4>
                                    <div class="text-secondary">Proszę poprawić poniższe pola, aby zapisać przyjęcie.</div>
                                </div>
                            </div>
                        </div>
                    }

                    <div class="mb-3">
                        <label class="form-label required">Składnik magazynowy</label>
                        <select asp-for="StockItemId" class="form-select" aria-label="Wybierz składnik">
                            <option value="">-- Wybierz z listy --</option>
                            @foreach (var item in mockItemsList)
                            {
                                <option value="@item.Id">@item.Name</option>
                            }
                        </select>
                        <span asp-validation-for="StockItemId" class="text-danger small"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label required">Numer partii dostawcy</label>
                            <input type="text" asp-for="SupplierBatchNumber" class="form-control" placeholder="np. BAT-2026-098" />
                            <span asp-validation-for="SupplierBatchNumber" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label required">Ilość dostarczona</label>
                            <input type="number" step="0.01" asp-for="Quantity" class="form-control" placeholder="0.00" />
                            <span asp-validation-for="Quantity" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Data ważności</label>
                            <div class="input-icon">
                                <span class="input-icon-addon">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M4 7a2 2 0 0 1 2 -2h12a2 2 0 0 1 2 2v12a2 2 0 0 1 -2 2h-12a2 2 0 0 1 -2 -2v-12z" /><path d="M16 3v4" /><path d="M8 3v4" /><path d="M4 11h16" /><path d="M11 15h1" /><path d="M12 15v3" /></svg>
                                </span>
                                <input type="date" asp-for="ExpiryDate" class="form-control" />
                            </div>
                            <span asp-validation-for="ExpiryDate" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Uwagi / Informacje dodatkowe</label>
                        <textarea asp-for="Notes" class="form-control" rows="3" placeholder="Stan opakowań, temperatura transportu lub inne zastrzeżenia..."></textarea>
                        <span asp-validation-for="Notes" class="text-danger small"></span>
                    </div>

                    <div class="card-footer bg-transparent p-0 pt-3 d-flex justify-content-between">
                        <a asp-action="Index" class="btn btn-outline-secondary">Anuluj</a>
                        <button type="submit" class="btn btn-success">Zapisz Przyjęcie</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
