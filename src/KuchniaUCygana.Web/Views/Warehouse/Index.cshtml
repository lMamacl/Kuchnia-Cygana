@model KuchniaUCygana.Web.Models.WarehouseDashboardViewModel
@{
    Layout = "_LayoutStaff";
    ViewData["Title"] = "Pulpit Magazynu";
    ViewData["Section"] = "Magazyn";
    ViewData["Description"] = "Inteligentne zarządzanie zapasami, kontrola FEFO oraz alerty o przeterminowaniu składników.";

    var alerts = Model.Alerts.ToList();
}

<div class="row row-cards">
    <!-- Statystyki górne -->
    <div class="col-sm-6 col-lg-3">
        <div class="card card-premium card-premium-hoverable">
            <div class="card-body">
                <div class="d-flex align-items-center">
                    <div class="subheader">Stan ogólny</div>
                    <div class="ms-auto lh-1">
                        <span class="status-dot-pulse bg-success"></span>
                    </div>
                </div>
                <div class="h1 mb-2 mt-1">Aktywny</div>
                <div class="text-secondary small">Wszystkie lodówki w normie</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="card card-premium card-premium-hoverable">
            <div class="card-body">
                <div class="d-flex align-items-center">
                    <div class="subheader">Pozycje asortymentu</div>
                    <div class="ms-auto">
                        <span class="text-blue">
                            <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M12 3l8 4.5l-8 4.5l-8 -4.5z" /><path d="M12 12l8 4.5l-8 4.5l-8 -4.5z" /><path d="M12 21l8 4.5l-8 4.5l-8 -4.5z" /><path d="M12 12v9" /><path d="M20 7.5v9" /><path d="M4 7.5v9" /></svg>
                        </span>
                    </div>
                </div>
                <div class="h1 mb-2 mt-1">@Model.StockItems.Count()</div>
                <div class="text-secondary small">Składników w bazie danych</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="card card-premium card-premium-hoverable">
            <div class="card-body">
                <div class="d-flex align-items-center">
                    <div class="subheader">Krytyczne alerty</div>
                    <div class="ms-auto lh-1">
                        <span class="status-dot-pulse bg-danger"></span>
                    </div>
                </div>
                <div class="h1 mb-2 mt-1 text-danger">@alerts.Count</div>
                <div class="text-secondary small">Wymaga natychmiastowej reakcji</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="card card-premium card-premium-hoverable">
            <div class="card-body">
                <div class="d-flex align-items-center">
                    <div class="subheader">Wydajność FEFO</div>
                    <div class="ms-auto">
                        <span class="text-green">
                            <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M5 12l5 5l10 -10" /></svg>
                        </span>
                    </div>
                </div>
                <div class="h1 mb-2 mt-1">98.4%</div>
                <div class="text-secondary small">Brak strat z przeterminowania</div>
            </div>
        </div>
    </div>

    <!-- Panel Smart Alertów -->
    <div class="col-12">
        <div class="card card-premium">
            <div class="card-status-top bg-danger"></div>
            <div class="card-header bg-transparent py-3">
                <h3 class="card-title text-danger d-flex align-items-center gap-2">
                    <svg xmlns="http://www.w3.org/2000/svg" class="icon text-danger" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M12 9v4" /><path d="M12 17h.01" /><path d="M5 3h14a2 2 0 0 1 2 2v14a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2v-14a2 2 0 0 1 2 -2z" /></svg>
                    Inteligentne Alerty Magazynowe (Smart Analyzer)
                </h3>
            </div>
            <div class="card-body py-2" id="alerts-container">
                @await Html.PartialAsync("_AlertsPartial", Model.Alerts)
            </div>
        </div>
    </div>

    <!-- Tabela Stanów i Wyszukiwarka -->
    <div class="col-12">
        <div class="card card-premium">
            <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-3 py-3">
                <h3 class="card-title">Aktualne Stany Magazynowe</h3>
                <div class="btn-list">
                    <a asp-action="Issue" class="btn btn-primary">
                        <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M12 5l0 14" /><path d="M5 12l14 0" /></svg>
                        Wydanie ręczne
                    </a>
                    <a asp-action="FefoReport" class="btn btn-outline-secondary">Raport FEFO</a>
                    <a asp-action="TransactionHistory" class="btn btn-outline-secondary">Historia transakcji</a>
                </div>
            </div>
            
            <div class="card-body border-bottom py-3">
                <form id="filter-form" 
                      hx-get="/warehouse/stock-table" 
                      hx-target="#stock-table-container" 
                      hx-trigger="change, keyup changed delay:300ms from:#SearchInput">
                    <div class="row g-3 align-items-center">
                        <div class="col-md-4">
                            <div class="input-icon">
                                <span class="input-icon-addon">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M10 10m-7 0a7 7 0 1 0 14 0a7 7 0 1 0 -14 0" /><path d="M21 21l-6 -6" /></svg>
                                </span>
                                <input type="text" id="SearchInput" name="Search" class="form-control" placeholder="Szukaj składnika..." aria-label="Wyszukiwarka składników">
                            </div>
                        </div>
                        <div class="col-md-3">
                            <select name="Category" class="form-select">
                                <option value="">Wszystkie kategorie</option>
                                <option value="Mięso/Ryby">Mięso / Ryby</option>
                                <option value="Nabiał">Nabiał</option>
                                <option value="Warzywa i owoce">Warzywa i owoce</option>
                                <option value="Suche">Suche</option>
                            </select>
                        </div>
                        <div class="col-md-5 d-flex gap-4">
                            <label class="form-check form-check-inline m-0">
                                <input type="checkbox" name="ShowLowStockOnly" value="true" class="form-check-input">
                                <span class="form-check-label text-danger fw-bold">Tylko niskie stany</span>
                            </label>
                            <label class="form-check form-check-inline m-0">
                                <input type="checkbox" name="ShowExpiredOnly" value="true" class="form-check-input">
                                <span class="form-check-label text-warning fw-bold">Tylko przeterminowane</span>
                            </label>
                        </div>
                    </div>
                </form>
            </div>

            <div id="stock-table-container">
                @await Html.PartialAsync("_StockTablePartial", Model.StockItems)
            </div>
        </div>
    </div>
</div>
