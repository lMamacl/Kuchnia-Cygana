@model KuchniaUCygana.Application.DTOs.Warehouse.PagedResultDto<KuchniaUCygana.Application.DTOs.Warehouse.BatchInventoryItemDto>
@{
    var items = Model.Items?.ToList() ?? new List<KuchniaUCygana.Application.DTOs.Warehouse.BatchInventoryItemDto>();
    var currentPage = Model.Page;
    var pageSize = Model.PageSize;
    var totalCount = Model.TotalCount;
    var totalPages = Model.TotalPages;
    var firstItem = totalCount == 0 ? 0 : ((currentPage - 1) * pageSize) + 1;
    var lastItem = totalCount == 0 ? 0 : Math.Min(currentPage * pageSize, totalCount);
    var startPage = Math.Max(1, currentPage - 2);
    var endPage = Math.Min(totalPages, currentPage + 2);
    var hasPrevious = currentPage > 1;
    var hasNext = currentPage < totalPages;
}

<div class="table-responsive">
    <table class="table table-vcenter card-table table-premium">
        <thead>
            <tr>
                <th class="w-1">ID</th>
                <th>Składnik</th>
                <th>Kategoria</th>
                <th>Ważność</th>
                <th class="text-end">Stan partii w systemie</th>
                <th class="w-25 text-center">Fizyczny stan partii</th>
                <th class="text-end">Różnica</th>
                <th>Powód korekty (w razie różnic)</th>
            </tr>
        </thead>
        <tbody>
            @if (!items.Any())
            {
                <tr>
                    <td colspan="8" class="text-center text-secondary py-4">
                        Brak partii spełniających kryteria wyszukiwania.
                    </td>
                </tr>
            }
            else
            {
                @for (int i = 0; i < items.Count; i++)
                {
                    var item = items[i];
                    <tr data-category="@item.Category" data-row-index="@i">
                        <td class="text-secondary font-weight-medium">#@item.BatchId</td>
                        <td>
                            <div class="font-weight-bold text-dark stock-item-name">@item.StockItemName</div>
                            <div class="text-secondary small stock-item-batch">@item.BatchNumber</div>
                        </td>
                        <td>
                            <span class="badge bg-secondary-lt">@item.Category</span>
                        </td>
                        <td>
                            <span class="text-secondary">@(item.ExpiryDate?.ToString("dd.MM.yyyy") ?? "Bez terminu")</span>
                        </td>
                        <td class="text-end font-weight-bold fw-bold text-dark">
                            @item.CurrentQuantity.ToString("F2") @item.UnitSymbol
                        </td>
                        <td>
                            <input type="hidden" name="adjustments.Index" value="@i" class="inventory-field" />
                            <input type="hidden" name="adjustments[@i].BatchId" value="@item.BatchId" class="inventory-field" />
                            <div class="input-group">
                                <input type="number" step="0.01" name="adjustments[@i].ActualQuantity" id="actual-@i" class="form-control text-end fw-bold inventory-field" placeholder="0.00" data-system-qty="@item.CurrentQuantity.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)" oninput="calculateDiff(@i)" />
                                <span class="input-group-text bg-transparent text-secondary">@item.UnitSymbol</span>
                            </div>
                        </td>
                        <td class="text-end fw-bold text-dark">
                            <span id="diff-@i">0.00</span>
                        </td>
                        <td>
                            <input type="text" name="adjustments[@i].Reason" class="form-control form-control-sm inventory-field" placeholder="np. Inwentaryzacja okresowa" value="Spis z natury" />
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>
<div class="card-footer bg-transparent d-flex align-items-center border-top">
    <p class="m-0 text-secondary">Pokazano <strong>@firstItem-@lastItem</strong> z łącznie <strong>@totalCount</strong> wyników</p>

    @if (totalPages > 1)
    {
        <ul class="pagination m-0 ms-auto">
            <li class="page-item @(hasPrevious ? "" : "disabled")">
                <a class="page-link"
                   href="javascript:void(0)"
                   @if (hasPrevious)
                   {
                       <text>hx-get="/warehouse/inventory-table?Page=@(currentPage - 1)&PageSize=@pageSize" hx-target="#inventory-table-container" hx-include="#SearchInput,#CategoryFilter"</text>
                   }
                   tabindex="-1"
                   aria-disabled="@(!hasPrevious)">
                    Poprzednia
                </a>
            </li>

            @if (startPage > 1)
            {
                <li class="page-item">
                    <a class="page-link"
                       href="javascript:void(0)"
                       hx-get="/warehouse/inventory-table?Page=1&PageSize=@pageSize"
                       hx-target="#inventory-table-container"
                       hx-include="#SearchInput,#CategoryFilter">1</a>
                </li>
                @if (startPage > 2)
                {
                    <li class="page-item disabled"><span class="page-link">…</span></li>
                }
            }

            @for (int p = startPage; p <= endPage; p++)
            {
                <li class="page-item @(p == currentPage ? "active" : "")">
                    <a class="page-link"
                       href="javascript:void(0)"
                       hx-get="/warehouse/inventory-table?Page=@p&PageSize=@pageSize"
                       hx-target="#inventory-table-container"
                       hx-include="#SearchInput,#CategoryFilter">
                        @p
                    </a>
                </li>
            }

            @if (endPage < totalPages)
            {
                @if (endPage < totalPages - 1)
                {
                    <li class="page-item disabled"><span class="page-link">…</span></li>
                }
                <li class="page-item">
                    <a class="page-link"
                       href="javascript:void(0)"
                       hx-get="/warehouse/inventory-table?Page=@totalPages&PageSize=@pageSize"
                       hx-target="#inventory-table-container"
                       hx-include="#SearchInput,#CategoryFilter">@totalPages</a>
                </li>
            }

            <li class="page-item @(hasNext ? "" : "disabled")">
                <a class="page-link"
                   href="javascript:void(0)"
                   @if (hasNext)
                   {
                       <text>hx-get="/warehouse/inventory-table?Page=@(currentPage + 1)&PageSize=@pageSize" hx-target="#inventory-table-container" hx-include="#SearchInput,#CategoryFilter"</text>
                   }
                   aria-disabled="@(!hasNext)">
                    Następna
                </a>
            </li>
        </ul>
    }
</div>
