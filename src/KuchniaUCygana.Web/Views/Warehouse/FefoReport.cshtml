@model IEnumerable<KuchniaUCygana.Application.DTOs.Warehouse.FefoReportItemDto>
@{
    Layout = "_LayoutStaff";
    ViewData["Title"] = "Raport FEFO";
    ViewData["Section"] = "Magazyn";
    ViewData["Description"] = "Raport stanów magazynowych uporządkowany zgodnie z zasadą First Expired, First Out (FEFO).";
}

<div class="container-xl">
    <!-- Nagłówek raportu d-print-none -->
    <div class="page-header d-print-none mb-3">
        <div class="row align-items-center">
            <div class="col">
                <div class="mb-1">
                    <ol class="breadcrumb" aria-label="breadcrumbs">
                        <li class="breadcrumb-item"><a asp-action="Index">Pulpit Magazynu</a></li>
                        <li class="breadcrumb-item active" aria-current="page">Raport FEFO</li>
                    </ol>
                </div>
                <h2 class="page-title text-dark">
                    Raport Kontroli Ważności (FEFO)
                </h2>
            </div>
            <div class="col-auto ms-auto">
                <div class="btn-list">
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M9 14l-4 -4l4 -4" /><path d="M5 10h11a4 4 0 1 1 0 8h-1" /></svg>
                        Pulpit
                    </a>
                    <a asp-action="ExportFefoCsv" class="btn btn-outline-secondary">CSV</a>
                    <a asp-action="ExportFefoPdf" class="btn btn-outline-secondary">PDF</a>
                    <button onclick="window.print()" class="btn btn-primary">
                        <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M17 17h2a2 2 0 0 0 2 -2v-4a2 2 0 0 0 -2 -2h-14a2 2 0 0 0 -2 2v4a2 2 0 0 0 2 2h2" /><path d="M17 9v-4a2 2 0 0 0 -2 -2h-6a2 2 0 0 0 -2 2v4" /><path d="M7 13m0 2a2 2 0 0 1 2 -2h6a2 2 0 0 1 2 2v4a2 2 0 0 1 -2 2h-6a2 2 0 0 1 -2 -2z" /></svg>
                        Drukuj Raport (A4)
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Nagłówek do druku (widoczny tylko podczas window.print) -->
    <div class="d-none d-print-block mb-4">
        <div class="row align-items-center text-center">
            <div class="col-12">
                <h1 class="h1 fw-bold text-dark mb-1">Kuchnia U Cygana</h1>
                <h3 class="h3 text-secondary">Raport Kontroli Ważności Partii (FEFO)</h3>
                <p class="small text-muted">Wygenerowano dnia: @DateTime.Now.ToString("dd.MM.yyyy HH:mm")</p>
                <hr />
            </div>
        </div>
    </div>

    <!-- Opcje Filtrowania d-print-none -->
    <div class="card card-premium d-print-none mb-4">
        <div class="card-body py-3">
            <div class="row g-3 align-items-center">
                <div class="col-md-5">
                    <div class="input-icon">
                        <span class="input-icon-addon">
                            <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M10 10m-7 0a7 7 0 1 0 14 0a7 7 0 1 0 -14 0" /><path d="M21 21l-6 -6" /></svg>
                        </span>
                        <input type="text" id="FefoSearch" class="form-control" placeholder="Filtruj składnik lub partię..." onkeyup="filterFefoTable()">
                    </div>
                </div>
                <div class="col-md-4">
                    <select id="StatusFilter" class="form-select" onchange="filterFefoTable()">
                        <option value="">Wszystkie statusy ważności</option>
                        <option value="Expired">Przeterminowane</option>
                        <option value="Critical">Pilna ważność (≤ 3 dni)</option>
                        <option value="Warning">Krótka ważność (≤ 7 dni)</option>
                        <option value="Safe">Bezpieczne (> 7 dni)</option>
                    </select>
                </div>
                <div class="col-md-3 text-end text-secondary small">
                    Razem pozycji: <strong id="fefo-count">@Model.Count()</strong>
                </div>
            </div>
        </div>
    </div>

    <!-- Tabela Raportu -->
    <div class="card card-premium card-print-plain">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-vcenter table-bordered card-table table-premium" id="FefoTable">
                    <thead>
                        <tr>
                            <th>Składnik</th>
                            <th>Partia Magazynowa</th>
                            <th class="text-end">Ilość</th>
                            <th>Data Ważności</th>
                            <th>Dni do końca</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="6" class="text-center text-secondary py-4">
                                    Brak aktywnych partii w magazynie.
                                </td>
                            </tr>
                        }
                        else
                        {
                            foreach (var item in Model)
                            {
                                var statusColor = item.Status switch
                                {
                                    "Expired" => "danger",
                                    "Critical" => "danger",
                                    "Warning" => "warning",
                                    "Safe" => "success",
                                    _ => "secondary"
                                };

                                var statusName = item.Status switch
                                {
                                    "Expired" => "Przeterminowana",
                                    "Critical" => "Pilna ważność",
                                    "Warning" => "Krótka ważność",
                                    "Safe" => "Bezpieczna",
                                    _ => item.Status
                                };

                                var rowClass = item.Status switch
                                {
                                    "Expired" => "table-danger fw-bold",
                                    "Critical" => "table-warning fw-bold",
                                    _ => ""
                                };

                                <tr class="@rowClass" data-status="@item.Status">
                                    <td class="fw-bold text-dark">
                                        <a asp-action="BatchDetails" asp-route-stockItemId="@item.StockItemId" class="text-reset d-print-none">@item.StockItemName</a>
                                        <span class="d-none d-print-inline">@item.StockItemName</span>
                                    </td>
                                    <td class="font-weight-medium">Partia #@item.BatchId (@(string.IsNullOrEmpty(item.BatchNumber) ? "BRAK" : item.BatchNumber))</td>
                                    <td class="text-end fw-bold text-dark">@item.Quantity.ToString("F2")</td>
                                    <td>@(item.ExpiryDate?.ToString("dd.MM.yyyy") ?? "Bezterminowo")</td>
                                    <td>
                                        @if (item.DaysToExpiry.HasValue)
                                        {
                                            if (item.DaysToExpiry.Value < 0)
                                            {
                                                <span class="text-danger fw-bold">Przeterminowana (@Math.Abs(item.DaysToExpiry.Value) dni)</span>
                                            }
                                            else
                                            {
                                                <span>@item.DaysToExpiry.Value dni</span>
                                            }
                                        }
                                        else
                                        {
                                            <span class="text-muted">Brak</span>
                                        }
                                    </td>
                                    <td>
                                        <span class="badge bg-@statusColor-lt text-@statusColor">@statusName</span>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<script>
    function filterFefoTable() {
        var input = document.getElementById("FefoSearch");
        var filter = input.value.toLowerCase();
        var statusFilter = document.getElementById("StatusFilter").value;
        var table = document.getElementById("FefoTable");
        var tr = table.getElementsByTagName("tr");
        var visibleCount = 0;

        for (var i = 1; i < tr.length; i++) {
            var showRow = true;
            var textContent = tr[i].innerText.toLowerCase();
            var status = tr[i].getAttribute("data-status");

            if (filter && textContent.indexOf(filter) === -1) {
                showRow = false;
            }

            if (statusFilter && status !== statusFilter) {
                showRow = false;
            }

            if (showRow) {
                tr[i].style.display = "";
                visibleCount++;
            } else {
                tr[i].style.display = "none";
            }
        }
        document.getElementById("fefo-count").innerText = visibleCount;
    }
</script>
