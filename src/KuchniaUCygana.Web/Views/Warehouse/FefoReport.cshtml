@model KuchniaUCygana.Application.DTOs.Warehouse.PagedResultDto<KuchniaUCygana.Application.DTOs.Warehouse.FefoReportItemDto>
@{
    Layout = "_LayoutStaff";
    ViewData["Title"] = "Raport FEFO";
    ViewData["Section"] = "Magazyn";
    ViewData["Description"] = "Raport stanów magazynowych uporządkowany zgodnie z zasadą First Expired, First Out (FEFO).";

    var filter = ViewBag.Filter as KuchniaUCygana.Application.DTOs.Warehouse.FefoReportFilterDto
                 ?? new KuchniaUCygana.Application.DTOs.Warehouse.FefoReportFilterDto();
}

<div class="container-xl">
    <!-- Nagłówek raportu d-print-none -->
    <div class="page-header d-print-none mb-3">
        <div class="row align-items-center">
            <div class="col">
                <div class="mb-1">
                    <ol class="breadcrumb" aria-label="breadcrumbs">
                        <li class="breadcrumb-item"><a asp-action="Index">Pulpit Magazynu</a></li>
                        <li class="breadcrumb-item active" aria-current="page">Raport FEFO</li>
                    </ol>
                </div>
                <h2 class="page-title text-dark">
                    Raport Kontroli Ważności (FEFO)
                </h2>
            </div>
            <div class="col-auto ms-auto">
                <div class="btn-list">
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M9 14l-4 -4l4 -4" /><path d="M5 10h11a4 4 0 1 1 0 8h-1" /></svg>
                        Pulpit
                    </a>
                    <a asp-action="ExportFefoCsv" asp-route-search="@filter.Search" asp-route-status="@filter.Status" class="btn btn-outline-secondary">CSV</a>
                    <a asp-action="ExportFefoPdf" asp-route-search="@filter.Search" asp-route-status="@filter.Status" class="btn btn-outline-secondary">PDF</a>
                    <button onclick="window.print()" class="btn btn-primary">
                        <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M17 17h2a2 2 0 0 0 2 -2v-4a2 2 0 0 0 -2 -2h-14a2 2 0 0 0 -2 2v4a2 2 0 0 0 2 2h2" /><path d="M17 9v-4a2 2 0 0 0 -2 -2h-6a2 2 0 0 0 -2 2v4" /><path d="M7 13m0 2a2 2 0 0 1 2 -2h6a2 2 0 0 1 2 2v4a2 2 0 0 1 -2 2h-6a2 2 0 0 1 -2 -2z" /></svg>
                        Drukuj Raport (A4)
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Nagłówek do druku (widoczny tylko podczas window.print) -->
    <div class="d-none d-print-block mb-4">
        <div class="row align-items-center text-center">
            <div class="col-12">
                <h1 class="h1 fw-bold text-dark mb-1">Kuchnia U Cygana</h1>
                <h3 class="h3 text-secondary">Raport Kontroli Ważności Partii (FEFO)</h3>
                <p class="small text-muted">Wygenerowano dnia: @DateTime.Now.ToString("dd.MM.yyyy HH:mm")</p>
                <hr />
            </div>
        </div>
    </div>

    <!-- Opcje Filtrowania d-print-none -->
    <div class="card card-premium d-print-none mb-4">
        <div class="card-body py-3">
            <form id="fefo-filter-form"
                  hx-get="/warehouse/fefo-report"
                  hx-target="#fefo-table-container"
                  hx-trigger="keyup changed delay:300ms from:#FefoSearch, change from:#StatusFilter">
                <div class="row g-3 align-items-center">
                    <div class="col-md-5">
                        <div class="input-icon">
                            <span class="input-icon-addon">
                                <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M10 10m-7 0a7 7 0 1 0 14 0a7 7 0 1 0 -14 0" /><path d="M21 21l-6 -6" /></svg>
                            </span>
                            <input type="text" id="FefoSearch" name="Search" class="form-control" placeholder="Filtruj składnik lub partię..." value="@filter.Search">
                        </div>
                    </div>
                    <div class="col-md-4">
                        <select id="StatusFilter" name="Status" class="form-select">
                            <option value="">Wszystkie statusy ważności</option>
                            <option value="Expired" selected="@(filter.Status == "Expired" ? "selected" : null)">Przeterminowane</option>
                            <option value="Critical" selected="@(filter.Status == "Critical" ? "selected" : null)">Pilna ważność (≤ 3 dni)</option>
                            <option value="Warning" selected="@(filter.Status == "Warning" ? "selected" : null)">Krótka ważność (≤ 7 dni)</option>
                            <option value="Safe" selected="@(filter.Status == "Safe" ? "selected" : null)">Bezpieczne (&gt; 7 dni)</option>
                        </select>
                    </div>
                    <div class="col-md-3 text-end text-secondary small">
                        Razem pozycji: <strong id="fefo-count">@Model.TotalCount</strong>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <div id="fefo-table-container">
        @await Html.PartialAsync("_FefoReportTablePartial", Model)
    </div>
</div>
