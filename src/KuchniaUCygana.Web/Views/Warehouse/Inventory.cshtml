@model IEnumerable<KuchniaUCygana.Application.DTOs.Warehouse.StockItemDto>
@{
    Layout = "_LayoutStaff";
    ViewData["Title"] = "Inwentaryzacja Magazynu";
    ViewData["Section"] = "Magazyn";
    ViewData["Description"] = "Formularz rozliczenia inwentaryzacyjnego. Wprowadź rzeczywiste stany fizyczne składników.";

    var stockItemsList = Model?.ToList() ?? new List<KuchniaUCygana.Application.DTOs.Warehouse.StockItemDto>();
}

<div class="row justify-content-center">
    <div class="col-12 col-xl-10">
        <form asp-action="Inventory" method="post" autocomplete="off">
            @Html.AntiForgeryToken()

            <div class="card card-premium">
                <div class="card-status-top bg-azure"></div>
                <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-3">
                    <h3 class="card-title d-flex align-items-center gap-2">
                        <svg xmlns="http://www.w3.org/2000/svg" class="icon text-azure" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M9 5h10a2 2 0 0 1 2 2v10a2 2 0 0 1 -2 2h-10a2 2 0 0 1 -2 -2v-10a2 2 0 0 1 2 -2z" /><path d="M13 13h4" /><path d="M13 9h4" /><path d="M9 9h.01" /><path d="M9 13h.01" /><path d="M3 5h2v14h-2z" /></svg>
                        Arkusz Inwentaryzacyjny
                    </h3>
                    <div class="btn-list">
                        <button type="button" class="btn btn-sm btn-outline-secondary" onclick="fillSystemValues()">Kopiuj stany systemowe</button>
                    </div>
                </div>
                
                <div class="table-responsive">
                    <table class="table table-vcenter card-table table-premium">
                        <thead>
                            <tr>
                                <th class="w-1">ID</th>
                                <th>Składnik</th>
                                <th>Kategoria</th>
                                <th class="text-end">Stan w systemie</th>
                                <th class="w-25 text-center">Fizyczny stan rzeczywisty</th>
                                <th>Powód korekty (w razie różnic)</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < stockItemsList.Count; i++)
                            {
                                var item = stockItemsList[i];
                                <tr>
                                    <td class="text-secondary font-weight-medium">#@item.Id</td>
                                    <td>
                                        <div class="font-weight-bold text-dark">@item.Name</div>
                                    </td>
                                    <td>
                                        <span class="badge bg-secondary-lt">@item.Category</span>
                                    </td>
                                    <td class="text-end font-weight-bold fw-bold text-dark">
                                        @item.CurrentStock.ToString("F2") @item.UnitSymbol
                                    </td>
                                    <td>
                                        <input type="hidden" name="adjustments[@i].StockItemId" value="@item.Id" />
                                        <div class="input-group">
                                            <input type="number" step="0.01" name="adjustments[@i].ActualQuantity" id="actual-@i" class="form-control text-end fw-bold" placeholder="0.00" required data-system-qty="@item.CurrentStock.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)" />
                                            <span class="input-group-text bg-transparent text-secondary">@item.UnitSymbol</span>
                                        </div>
                                    </td>
                                    <td>
                                        <input type="text" name="adjustments[@i].Reason" class="form-control form-control-sm" placeholder="np. Inwentaryzacja okresowa" value="Spis z natury" />
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="card-footer bg-transparent d-flex justify-content-between">
                    <a asp-action="Index" class="btn btn-outline-secondary">Anuluj</a>
                    <button type="submit" class="btn btn-primary">
                        <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M5 12l5 5l10 -10" /></svg>
                        Zatwierdź Inwentaryzację
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        function fillSystemValues() {
            const inputs = document.querySelectorAll('input[id^="actual-"]');
            inputs.forEach(input => {
                input.value = input.getAttribute('data-system-qty');
            });
        }
    </script>
}
