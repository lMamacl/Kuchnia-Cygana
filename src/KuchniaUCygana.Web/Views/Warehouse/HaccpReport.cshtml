@model KuchniaUCygana.Application.DTOs.Warehouse.HaccpReportDto
@{
    Layout = "_LayoutStaff";
    ViewData["Title"] = "Raport Zgodności HACCP";
    ViewData["Section"] = "Magazyn";
    ViewData["Description"] = "Urzędowy raport rejestracji temperatur dla organów kontroli sanitarnej (Sanepid).";

    DateOnly dateFrom = ViewBag.DateFrom;
    DateOnly dateTo = ViewBag.DateTo;

    // Grupowanie pomiarów i obliczanie limitów dla urządzeń
    var reportRows = Model.Readings
        .GroupBy(r => r.DeviceNameOrLocation)
        .Select(g =>
        {
            decimal minLimit = -25.0m;
            decimal maxLimit = 8.0m;
            
            var name = g.Key.ToLower();
            if (name.Contains("zamrażarka") || name.Contains("freezer"))
            {
                minLimit = -22.0m;
                maxLimit = -18.0m;
            }
            else if (name.Contains("mięso"))
            {
                minLimit = 0.0m;
                maxLimit = 4.0m;
            }
            else if (name.Contains("nabiał"))
            {
                minLimit = 2.0m;
                maxLimit = 6.0m;
            }
            else if (name.Contains("warzywa"))
            {
                minLimit = 4.0m;
                maxLimit = 8.0m;
            }
            else if (name.Contains("chłodnia"))
            {
                minLimit = 2.0m;
                maxLimit = 8.0m;
            }
            else if (name.Contains("witryna"))
            {
                minLimit = 2.0m;
                maxLimit = 8.0m;
            }
            else if (name.Contains("suchy"))
            {
                minLimit = 15.0m;
                maxLimit = 25.0m;
            }

            var temps = g.Select(x => x.RecordedTemperatureCelsius).ToList();
            var avgTemp = temps.Any() ? temps.Average() : 0m;
            var minRecorded = temps.Any() ? temps.Min() : 0m;
            var maxRecorded = temps.Any() ? temps.Max() : 0m;
            var violations = g.Count(x => x.RecordedTemperatureCelsius < minLimit || x.RecordedTemperatureCelsius > maxLimit);

            return new
            {
                Device = g.Key,
                MinLimit = minLimit,
                MaxLimit = maxLimit,
                AvgTemp = avgTemp,
                MinRecorded = minRecorded,
                MaxRecorded = maxRecorded,
                Violations = violations
            };
        })
        .ToList();
}

<div class="card card-premium d-print-none mb-4">
    <div class="card-body">
        <form method="get" asp-action="HaccpReport" class="row align-items-end g-3">
            <div class="col-md-4">
                <label class="form-label text-secondary small">Data początkowa</label>
                <input type="date" name="from" class="form-control" value="@dateFrom.ToString("yyyy-MM-dd")" />
            </div>
            <div class="col-md-4">
                <label class="form-label text-secondary small">Data końcowa</label>
                <input type="date" name="to" class="form-control" value="@dateTo.ToString("yyyy-MM-dd")" />
            </div>
            <div class="col-md-4 d-flex gap-2">
                <button type="submit" class="btn btn-primary flex-fill">Filtruj</button>
                <a href="/warehouse/haccp-report/csv?from=@dateFrom.ToString("yyyy-MM-dd")&to=@dateTo.ToString("yyyy-MM-dd")" class="btn btn-outline-secondary">CSV</a>
                <a href="/warehouse/haccp-report/pdf?from=@dateFrom.ToString("yyyy-MM-dd")&to=@dateTo.ToString("yyyy-MM-dd")" class="btn btn-outline-secondary">PDF</a>
                <button type="button" class="btn btn-outline-secondary" onclick="window.print();">Drukuj</button>
            </div>
        </form>
    </div>
</div>



<div class="card card-premium">
    <div class="card-body p-5">
        <!-- Nagłówek raportu do wydruku -->
        <div class="row align-items-center mb-4">
            <div class="col">
                <h1 class="h2 mb-1 text-dark">RAPORT KONTROLI TEMPERATUR (HACCP)</h1>
                <div class="text-secondary small">
                    Okres sprawozdawczy: <strong id="date-from-text" class="text-azure cursor-pointer" style="cursor: pointer;" title="Podwójne kliknięcie otwiera kalendarz">@dateFrom.ToString("dd.MM.yyyy")</strong> do <strong id="date-to-text" class="text-azure cursor-pointer" style="cursor: pointer;" title="Podwójne kliknięcie otwiera kalendarz">@dateTo.ToString("dd.MM.yyyy")</strong>
                </div>
            </div>
            <div class="col-auto text-end">
                <div class="h3 mb-0 text-dark">Kuchnia u Cygana</div>
                <div class="text-secondary small">Dział Kontroli Jakości</div>
            </div>
        </div>

        <hr class="my-4" />

        <div class="table-responsive">
            <table class="table table-vcenter table-premium table-bordered">
                <thead>
                    <tr class="bg-light">
                        <th>Nazwa Urządzenia / Lokalizacja</th>
                        <th class="text-center">Limit min.</th>
                        <th class="text-center">Limit max.</th>
                        <th class="text-center">Średnia temp.</th>
                        <th class="text-center">Min. odczyt</th>
                        <th class="text-center">Max. odczyt</th>
                        <th class="text-center">Przekroczenia limitu</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!reportRows.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center py-4 text-secondary">
                                Brak zarejestrowanych pomiarów w podanym zakresie dat.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var row in reportRows)
                        {
                            <tr>
                                <td class="font-weight-medium fw-bold text-dark">@row.Device</td>
                                <td class="text-center text-secondary">@row.MinLimit.ToString("F1")°C</td>
                                <td class="text-center text-secondary">@row.MaxLimit.ToString("F1")°C</td>
                                <td class="text-center font-weight-bold fw-bold text-dark">@row.AvgTemp.ToString("F1")°C</td>
                                <td class="text-center text-success">@row.MinRecorded.ToString("F1")°C</td>
                                <td class="text-center text-warning">@row.MaxRecorded.ToString("F1")°C</td>
                                <td class="text-center">
                                    @if (row.Violations > 0)
                                    {
                                        <span class="badge bg-danger-lt text-danger fw-bold">@row.Violations razy</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success-lt text-success">Zgodny</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <!-- Podpisy -->
        <div class="row mt-5 pt-5 justify-content-between">
            <div class="col-4 text-center">
                <div class="border-bottom border-secondary pb-4" style="border-bottom-style: dotted !important;"></div>
                <div class="text-secondary small mt-2">Sporządził (Weryfikator HACCP)</div>
            </div>
            <div class="col-4 text-center">
                <div class="border-bottom border-secondary pb-4" style="border-bottom-style: dotted !important;"></div>
                <div class="text-secondary small mt-2">Zatwierdził (Kierownik Magazynu)</div>
            </div>
        <!-- Sekcja Wykresu (Ekran i Druk na nowej stronie) -->
        <div class="page-break-before mt-5">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h3 class="card-title text-azure mb-0">Analiza Zgodności HACCP (Wykres Temperatur)</h3>
                <div class="d-print-none">
                    <select id="ChartDeviceSelect" class="form-select form-select-sm w-auto" onchange="updateHaccpChart()">
                        <option value="">Wszystkie urządzenia</option>
                        @foreach (var row in reportRows)
                        {
                            <option value="@row.Device">@row.Device</option>
                        }
                    </select>
                </div>
            </div>
            <div style="height: 320px; position: relative;">
                <canvas id="haccpChart"></canvas>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        let haccpChart = null;
        const rawData = @Html.Raw(Json.Serialize(Model.Readings.OrderBy(r => r.RecordedAt)));

        function getDeviceLimits(deviceName) {
            const name = deviceName.toLowerCase();
            let minLimit = -25.0;
            let maxLimit = 8.0;
            
            if (name.includes("zamrażarka") || name.includes("freezer")) {
                minLimit = -22.0;
                maxLimit = -18.0;
            } else if (name.includes("mięso")) {
                minLimit = 0.0;
                maxLimit = 4.0;
            } else if (name.includes("nabiał")) {
                minLimit = 2.0;
                maxLimit = 6.0;
            } else if (name.includes("warzywa")) {
                minLimit = 4.0;
                maxLimit = 8.0;
            } else if (name.includes("chłodnia")) {
                minLimit = 2.0;
                maxLimit = 8.0;
            } else if (name.includes("witryna")) {
                minLimit = 2.0;
                maxLimit = 8.0;
            } else if (name.includes("suchy")) {
                minLimit = 15.0;
                maxLimit = 25.0;
            }
            return { min: minLimit, max: maxLimit };
        }

        function updateHaccpChart() {
            const selectedDevice = document.getElementById("ChartDeviceSelect").value;
            
            // Group readings by device
            const deviceGroups = {};
            rawData.forEach(item => {
                const deviceName = item.deviceNameOrLocation;
                
                // Filter by selected device if specified
                if (selectedDevice && deviceName !== selectedDevice) {
                    return;
                }
                
                if (!deviceGroups[deviceName]) {
                    deviceGroups[deviceName] = {
                        label: deviceName,
                        data: [],
                        borderColor: getRandomColor(deviceName),
                        backgroundColor: getRandomColor(deviceName) + '11',
                        tension: 0.2,
                        fill: false,
                        spanGaps: false
                    };
                }
                deviceGroups[deviceName].data.push({
                    x: new Date(item.recordedAt).getTime(),
                    y: item.recordedTemperatureCelsius
                });
            });

            let datasets = Object.values(deviceGroups);

            // If a specific device is selected, add its red limit lines
            if (selectedDevice && datasets.length > 0) {
                const limits = getDeviceLimits(selectedDevice);
                const timestamps = rawData.filter(r => r.deviceNameOrLocation === selectedDevice).map(r => new Date(r.recordedAt).getTime());
                if (timestamps.length > 0) {
                    const minX = Math.min(...timestamps);
                    const maxX = Math.max(...timestamps);
                    
                    // Min limit line dataset
                    datasets.push({
                        label: `Limit min (${limits.min}°C)`,
                        data: [{ x: minX, y: limits.min }, { x: maxX, y: limits.min }],
                        borderColor: '#ef4444',
                        borderDash: [5, 5],
                        borderWidth: 2,
                        pointRadius: 0,
                        fill: false,
                        showLine: true
                    });
                    
                    // Max limit line dataset
                    datasets.push({
                        label: `Limit max (${limits.max}°C)`,
                        data: [{ x: minX, y: limits.max }, { x: maxX, y: limits.max }],
                        borderColor: '#ef4444',
                        borderDash: [5, 5],
                        borderWidth: 2,
                        pointRadius: 0,
                        fill: false,
                        showLine: true
                    });
                }
            }

            const ctx = document.getElementById('haccpChart').getContext('2d');
            
            if (haccpChart) {
                haccpChart.destroy();
            }

            haccpChart = new Chart(ctx, {
                type: 'line',
                data: {
                    datasets: datasets
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: {
                        x: {
                            type: 'linear',
                            ticks: {
                                callback: function(value) {
                                    const date = new Date(value);
                                    return date.toLocaleDateString('pl-PL', { day: '2-digit', month: '2-digit' }) + ' ' + 
                                           date.toLocaleTimeString('pl-PL', { hour: '2-digit', minute: '2-digit' });
                                }
                            },
                            title: {
                                display: true,
                                text: 'Czas pomiaru'
                            }
                        },
                        y: {
                            ticks: {
                                callback: function(value) {
                                    return value + '°C';
                                }
                            },
                            title: {
                                display: true,
                                text: 'Temperatura'
                            }
                        }
                    },
                    plugins: {
                        tooltip: {
                            callbacks: {
                                label: function(context) {
                                    const label = context.dataset.label || '';
                                    if (label.includes('Limit')) {
                                        return label;
                                    }
                                    const val = context.parsed.y;
                                    const device = context.dataset.label;
                                    const limits = getDeviceLimits(device);
                                    return `${device}: ${val}°C (Norma: ${limits.min}°C do ${limits.max}°C)`;
                                }
                            }
                        }
                    }
                }
            });
        }

        function getRandomColor(str) {
            let hash = 0;
            for (let i = 0; i < str.length; i++) {
                hash = str.charCodeAt(i) + ((hash << 5) - hash);
            }
            const c = (hash & 0x00FFFFFF).toString(16).toUpperCase();
            return "#" + "00000".substring(0, 6 - c.length) + c;
        }

        window.addEventListener('DOMContentLoaded', () => {
            // Double click date triggers
            document.getElementById('date-from-text').addEventListener('dblclick', function() {
                const input = document.querySelector('input[name="from"]');
                if (input) {
                    input.focus();
                    try {
                        input.showPicker();
                    } catch(e) {
                        input.click();
                    }
                }
            });
            document.getElementById('date-to-text').addEventListener('dblclick', function() {
                const input = document.querySelector('input[name="to"]');
                if (input) {
                    input.focus();
                    try {
                        input.showPicker();
                    } catch(e) {
                        input.click();
                    }
                }
            });

            updateHaccpChart();
        });
    </script>
}
