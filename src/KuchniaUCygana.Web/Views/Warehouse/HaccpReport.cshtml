@model KuchniaUCygana.Application.DTOs.Warehouse.HaccpReportDto
@{
    Layout = "_LayoutStaff";
    ViewData["Title"] = "Raport Zgodności HACCP";
    ViewData["Section"] = "Magazyn";
    ViewData["Description"] = "Urzędowy raport rejestracji temperatur dla organów kontroli sanitarnej (Sanepid).";

    DateOnly dateFrom = ViewBag.DateFrom;
    DateOnly dateTo = ViewBag.DateTo;

    // Grupowanie pomiarów i obliczanie limitów dla urządzeń
    var reportRows = Model.Readings
        .GroupBy(r => r.DeviceNameOrLocation)
        .Select(g =>
        {
            decimal minLimit = -25.0m;
            decimal maxLimit = 8.0m;
            
            var name = g.Key.ToLower();
            if (name.Contains("zamrażarka") || name.Contains("freezer"))
            {
                minLimit = -22.0m;
                maxLimit = -18.0m;
            }
            else if (name.Contains("mięso"))
            {
                minLimit = 0.0m;
                maxLimit = 4.0m;
            }
            else if (name.Contains("nabiał"))
            {
                minLimit = 2.0m;
                maxLimit = 6.0m;
            }
            else if (name.Contains("warzywa"))
            {
                minLimit = 4.0m;
                maxLimit = 8.0m;
            }
            else if (name.Contains("chłodnia"))
            {
                minLimit = 2.0m;
                maxLimit = 8.0m;
            }
            else if (name.Contains("witryna"))
            {
                minLimit = 2.0m;
                maxLimit = 8.0m;
            }
            else if (name.Contains("suchy"))
            {
                minLimit = 15.0m;
                maxLimit = 25.0m;
            }

            var temps = g.Select(x => x.RecordedTemperatureCelsius).ToList();
            var avgTemp = temps.Any() ? temps.Average() : 0m;
            var minRecorded = temps.Any() ? temps.Min() : 0m;
            var maxRecorded = temps.Any() ? temps.Max() : 0m;
            var violations = g.Count(x => x.RecordedTemperatureCelsius < minLimit || x.RecordedTemperatureCelsius > maxLimit);

            return new
            {
                Device = g.Key,
                MinLimit = minLimit,
                MaxLimit = maxLimit,
                AvgTemp = avgTemp,
                MinRecorded = minRecorded,
                MaxRecorded = maxRecorded,
                Violations = violations
            };
        })
        .ToList();
}

<div class="card card-premium d-print-none mb-4">
    <div class="card-body">
        <form method="get" asp-action="HaccpReport" class="row align-items-end g-3">
            <div class="col-md-4">
                <label class="form-label text-secondary small">Data początkowa</label>
                <input type="date" name="from" class="form-control" value="@dateFrom.ToString("yyyy-MM-dd")" />
            </div>
            <div class="col-md-4">
                <label class="form-label text-secondary small">Data końcowa</label>
                <input type="date" name="to" class="form-control" value="@dateTo.ToString("yyyy-MM-dd")" />
            </div>
            <div class="col-md-4 d-flex gap-2">
                <button type="submit" class="btn btn-primary flex-fill">Filtruj</button>
                <a href="/warehouse/haccp-report/csv?from=@dateFrom.ToString("yyyy-MM-dd")&to=@dateTo.ToString("yyyy-MM-dd")" class="btn btn-outline-secondary">CSV</a>
                <a href="/warehouse/haccp-report/pdf?from=@dateFrom.ToString("yyyy-MM-dd")&to=@dateTo.ToString("yyyy-MM-dd")" class="btn btn-outline-secondary">PDF</a>
                <button type="button" class="btn btn-outline-secondary" onclick="window.print();">Drukuj</button>
            </div>
        </form>
    </div>
</div>

<!-- Podsumowanie statystyczne -->
<div class="row g-3 mb-4 d-print-none">
    <div class="col-sm-6 col-lg-3">
        <div class="card card-sm">
            <div class="card-body">
                <div class="row align-items-center">
                    <div class="col-auto">
                        <span class="bg-primary text-white avatar">
                            <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M10 13.5a2.5 2.5 0 1 0 4 0v-8.5a2 2 0 0 0 -4 0v8.5z" /><path d="M10 9l4 0" /><path d="M6.5 17h11" /></span>
                    </div>
                    <div class="col">
                        <div class="font-weight-medium fw-bold">
                            @Model.TotalReadings
                        </div>
                        <div class="text-secondary small">
                            Wszystkie odczyty
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="card card-sm">
            <div class="card-body">
                <div class="row align-items-center">
                    <div class="col-auto">
                        <span class="bg-danger text-white avatar">
                            <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M12 9v4" /><path d="M12 17h.01" /><path d="M5 19h14a2 2 0 0 0 1.84 -2.75l-7.1 -12.25a2 2 0 0 0 -3.5 0l-7.1 12.25a2 2 0 0 0 1.75 2.75" /></span>
                    </div>
                    <div class="col">
                        <div class="font-weight-medium fw-bold text-danger">
                            @Model.OutOfRangeReadings
                        </div>
                        <div class="text-secondary small">
                            Przekroczenia HACCP
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="card card-sm">
            <div class="card-body">
                <div class="row align-items-center">
                    <div class="col-auto">
                        <span class="bg-success text-white avatar">
                            <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M5 12l5 5l10 -10" /></span>
                    </div>
                    <div class="col">
                        <div class="font-weight-medium fw-bold text-success">
                            @(Model.TotalReadings - Model.OutOfRangeReadings)
                        </div>
                        <div class="text-secondary small">
                            Odczyty w normie
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="card card-sm">
            <div class="card-body">
                <div class="row align-items-center">
                    <div class="col-auto">
                        <span class="bg-info text-white avatar">
                            <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M3 12h1M20 12h1M5.6 5.6l.7 .7M17.7 5.6l-.7 .7M9 16a5 5 0 1 1 6 0a3.5 3.5 0 0 0 -1 3a2 2 0 0 1 -4 0a3.5 3.5 0 0 0 -1 -3" /><path d="M9.7 17l4.6 0" /></span>
                    </div>
                    <div class="col">
                        <div class="font-weight-medium fw-bold">
                            @reportRows.Count
                        </div>
                        <div class="text-secondary small">
                            Monitorowane urządzenia
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Wykres temperatur d-print-none -->
<div class="row g-3 mb-4 d-print-none">
    <div class="col-12">
        <div class="card card-premium">
            <div class="card-header bg-transparent py-3">
                <h3 class="card-title text-azure">Analiza Zgodności HACCP (Wykresy Urządzeń)</h3>
            </div>
            <div class="card-body">
                <div style="height: 300px;">
                    <canvas id="haccpChart"></canvas>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="card card-premium">
    <div class="card-body p-5">
        <!-- Nagłówek raportu do wydruku -->
        <div class="row align-items-center mb-4">
            <div class="col">
                <h1 class="h2 mb-1 text-dark">RAPORT KONTROLI TEMPERATUR (HACCP)</h1>
                <div class="text-secondary small">
                    Okres sprawozdawczy: <strong>@dateFrom.ToString("dd.MM.yyyy")</strong> do <strong>@dateTo.ToString("dd.MM.yyyy")</strong>
                </div>
            </div>
            <div class="col-auto text-end">
                <div class="h3 mb-0 text-dark">Kuchnia u Cygana</div>
                <div class="text-secondary small">Dział Kontroli Jakości</div>
            </div>
        </div>

        <hr class="my-4" />

        <div class="table-responsive">
            <table class="table table-vcenter table-premium table-bordered">
                <thead>
                    <tr class="bg-light">
                        <th>Nazwa Urządzenia / Lokalizacja</th>
                        <th class="text-center">Limit min.</th>
                        <th class="text-center">Limit max.</th>
                        <th class="text-center">Średnia temp.</th>
                        <th class="text-center">Min. odczyt</th>
                        <th class="text-center">Max. odczyt</th>
                        <th class="text-center">Przekroczenia limitu</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!reportRows.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center py-4 text-secondary">
                                Brak zarejestrowanych pomiarów w podanym zakresie dat.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var row in reportRows)
                        {
                            <tr>
                                <td class="font-weight-medium fw-bold text-dark">@row.Device</td>
                                <td class="text-center text-secondary">@row.MinLimit.ToString("F1")°C</td>
                                <td class="text-center text-secondary">@row.MaxLimit.ToString("F1")°C</td>
                                <td class="text-center font-weight-bold fw-bold text-dark">@row.AvgTemp.ToString("F1")°C</td>
                                <td class="text-center text-success">@row.MinRecorded.ToString("F1")°C</td>
                                <td class="text-center text-warning">@row.MaxRecorded.ToString("F1")°C</td>
                                <td class="text-center">
                                    @if (row.Violations > 0)
                                    {
                                        <span class="badge bg-danger-lt text-danger fw-bold">@row.Violations razy</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success-lt text-success">Zgodny</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <!-- Podpisy -->
        <div class="row mt-5 pt-5 justify-content-between">
            <div class="col-4 text-center">
                <div class="border-bottom border-secondary pb-4" style="border-bottom-style: dotted !important;"></div>
                <div class="text-secondary small mt-2">Sporządził (Weryfikator HACCP)</div>
            </div>
            <div class="col-4 text-center">
                <div class="border-bottom border-secondary pb-4" style="border-bottom-style: dotted !important;"></div>
                <div class="text-secondary small mt-2">Zatwierdził (Kierownik Magazynu)</div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        window.addEventListener('DOMContentLoaded', () => {
            const rawData = @Html.Raw(Json.Serialize(Model.Readings.OrderBy(r => r.RecordedAt)));
            
            // Group readings by device
            const deviceGroups = {};
            rawData.forEach(item => {
                const deviceName = item.deviceNameOrLocation;
                if (!deviceGroups[deviceName]) {
                    deviceGroups[deviceName] = {
                        label: deviceName,
                        data: [],
                        borderColor: getRandomColor(deviceName),
                        tension: 0.2,
                        fill: false
                    };
                }
                deviceGroups[deviceName].data.push({
                    x: new Date(item.recordedAt).toLocaleString('pl-PL', { day: '2-digit', month: '2-digit', hour: '2-digit', minute: '2-digit' }),
                    y: item.recordedTemperatureCelsius
                });
            });

            const datasets = Object.values(deviceGroups);
            const uniqueLabels = [...new Set(rawData.map(d => new Date(d.recordedAt).toLocaleString('pl-PL', { day: '2-digit', month: '2-digit', hour: '2-digit', minute: '2-digit' })))];

            datasets.forEach(dataset => {
                dataset.data = uniqueLabels.map(label => {
                    const match = dataset.data.find(d => d.x === label);
                    return match ? match.y : null;
                });
            });

            function getRandomColor(str) {
                let hash = 0;
                for (let i = 0; i < str.length; i++) {
                    hash = str.charCodeAt(i) + ((hash << 5) - hash);
                }
                const c = (hash & 0x00FFFFFF).toString(16).toUpperCase();
                return "#" + "00000".substring(0, 6 - c.length) + c;
            }

            const ctx = document.getElementById('haccpChart').getContext('2d');
            new Chart(ctx, {
                type: 'line',
                data: {
                    labels: uniqueLabels,
                    datasets: datasets
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: {
                        y: {
                            ticks: {
                                callback: function(value) {
                                    return value + '°C';
                                }
                            }
                        }
                    }
                }
            });
        });
    </script>
}
