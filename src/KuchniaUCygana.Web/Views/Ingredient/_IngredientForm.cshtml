@using KuchniaUCygana.Application.DTOs.Menu
@using Microsoft.AspNetCore.Mvc.Rendering
@model KuchniaUCygana.Application.DTOs.Menu.IngredientDto
@{
    var allergens = ViewBag.Allergens as IEnumerable<AllergenDto> ?? Enumerable.Empty<AllergenDto>();
    var selectedAllergens = Model.SelectedAllergenIds.ToHashSet();
    var traceAllergens = Model.TraceAllergenIds.ToHashSet();
    var foodCategories = ViewBag.FoodCategories as IEnumerable<SelectListItem> ?? Enumerable.Empty<SelectListItem>();
    var warehouseCategories = ViewBag.WarehouseCategories as IEnumerable<SelectListItem> ?? Enumerable.Empty<SelectListItem>();
}

<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

<h4 class="mb-3">Dane podstawowe</h4>
<div class="mb-3">
    <label asp-for="Name" class="form-label required">Nazwa</label>
    <input asp-for="Name" class="form-control" />
    <span asp-validation-for="Name" class="text-danger small"></span>
</div>
<div class="row">
    <div class="col-md-6 mb-3">
        <label asp-for="ResourceType" class="form-label">Typ zasobu</label>
        <select asp-for="ResourceType" class="form-select">
            <option value="Food">Skladnik spozywczy</option>
            <option value="Spice">Przyprawa</option>
            <option value="Packaging">Opakowanie</option>
            <option value="Container">Pojemnik</option>
            <option value="Other">Inny</option>
        </select>
    </div>
    <div class="col-md-6 mb-3">
        <label asp-for="FoodCategoryId" class="form-label">Kategoria zywnosciowa</label>
        <select asp-for="FoodCategoryId" class="form-select" asp-items="foodCategories">
            <option value="">Brak</option>
        </select>
    </div>
</div>
<div class="mb-3">
    <label asp-for="Description" class="form-label">Opis</label>
    <textarea asp-for="Description" class="form-control" rows="2"></textarea>
</div>
<div class="mb-3">
    <label asp-for="ProductComposition" class="form-label">Sklad opisowy produktu</label>
    <textarea asp-for="ProductComposition" class="form-control" rows="2"></textarea>
</div>
<div class="mb-3">
    <label asp-for="ImageUrl" class="form-label">Zdjecie URL</label>
    <input asp-for="ImageUrl" class="form-control" />
</div>
<div class="row">
    <div class="col-md-4 mb-3">
        <label asp-for="Unit" class="form-label required">Jednostka</label>
        <input asp-for="Unit" class="form-control" placeholder="g, kg, szt." />
    </div>
    <div class="col-md-4 mb-3">
        <label asp-for="CostPerUnit" class="form-label">Koszt jednostkowy</label>
        <input asp-for="CostPerUnit" type="number" step="0.01" class="form-control" />
    </div>
    <div class="col-md-4 mb-3">
        <label asp-for="YieldFactor" class="form-label">Yield factor</label>
        <input asp-for="YieldFactor" type="number" step="0.001" class="form-control" />
    </div>
</div>
<div class="mb-3">
    <label asp-for="Notes" class="form-label">Notatki</label>
    <textarea asp-for="Notes" class="form-control" rows="3"></textarea>
</div>

<h4 class="mb-3 mt-4">Mapowanie magazynowe</h4>
<div class="row">
    <div class="col-md-6 mb-3">
        <label asp-for="StockItemId" class="form-label">StockItemId</label>
        <input asp-for="StockItemId" type="number" class="form-control" />
    </div>
    <div class="col-md-6 mb-3">
        <label asp-for="WarehouseCategoryId" class="form-label">Kategoria magazynowa</label>
        <select asp-for="WarehouseCategoryId" class="form-select" asp-items="warehouseCategories">
            <option value="">Brak</option>
        </select>
    </div>
</div>
<label class="form-check form-switch mb-3">
    <input class="form-check-input" type="checkbox" asp-for="WarehouseCategoryFefoApproved" />
    <span class="form-check-label">Kategoria magazynowa zatwierdzona dla FEFO bez StockItemId</span>
</label>

<h4 class="mb-3 mt-4">Nutrition / 100 g</h4>
<input type="hidden" asp-for="Nutrition.Id" />
<div class="row">
    <div class="col-md-4 mb-3">
        <label asp-for="Nutrition.CaloriesPer100g" class="form-label">Kalorie</label>
        <input asp-for="Nutrition.CaloriesPer100g" type="number" step="0.01" class="form-control" />
    </div>
    <div class="col-md-4 mb-3">
        <label asp-for="Nutrition.ProteinPer100g" class="form-label">Bialko</label>
        <input asp-for="Nutrition.ProteinPer100g" type="number" step="0.01" class="form-control" />
    </div>
    <div class="col-md-4 mb-3">
        <label asp-for="Nutrition.CarbohydratesPer100g" class="form-label">Weglowodany</label>
        <input asp-for="Nutrition.CarbohydratesPer100g" type="number" step="0.01" class="form-control" />
    </div>
    <div class="col-md-4 mb-3">
        <label asp-for="Nutrition.FatPer100g" class="form-label">Tluszcz</label>
        <input asp-for="Nutrition.FatPer100g" type="number" step="0.01" class="form-control" />
    </div>
    <div class="col-md-4 mb-3">
        <label asp-for="Nutrition.FiberPer100g" class="form-label">Blonnik</label>
        <input asp-for="Nutrition.FiberPer100g" type="number" step="0.01" class="form-control" />
    </div>
</div>

<h4 class="mb-3 mt-4">Alergeny skladnika</h4>
@if (!allergens.Any())
{
    <p class="text-secondary">Brak zdefiniowanych alergenow.</p>
}
else
{
    <div class="row">
        @foreach (var allergen in allergens)
        {
            var isSelected = selectedAllergens.Contains(allergen.Id);
            var isTrace = traceAllergens.Contains(allergen.Id);
            <div class="col-md-6 mb-2">
                <div class="d-flex justify-content-between align-items-center border rounded px-3 py-2">
                    <label class="form-check mb-0">
                        <input class="form-check-input" type="checkbox" name="SelectedAllergenIds" value="@allergen.Id" checked="@isSelected" />
                        <span class="form-check-label">@allergen.Name</span>
                    </label>
                    <label class="form-check mb-0">
                        <input class="form-check-input" type="checkbox" name="TraceAllergenIds" value="@allergen.Id" checked="@isTrace" />
                        <span class="form-check-label small">Sladowo</span>
                    </label>
                </div>
            </div>
        }
    </div>
}

<h4 class="mb-3 mt-4">Kontrola produkcyjna</h4>
<label class="form-check form-switch mb-3">
    <input class="form-check-input" type="checkbox" asp-for="RequiresCoreTemperatureCheck" />
    <span class="form-check-label">Wymaga kontroli temperatury rdzenia</span>
</label>
<div class="mb-3">
    <label asp-for="MinimumCoreTemperatureCelsius" class="form-label">Minimalna temperatura rdzenia C</label>
    <input asp-for="MinimumCoreTemperatureCelsius" type="number" step="0.1" class="form-control" />
</div>
<label class="form-check form-switch mb-4">
    <input class="form-check-input" type="checkbox" asp-for="IsActive" />
    <span class="form-check-label">Skladnik aktywny</span>
</label>
