@model KuchniaUCygana.Application.DTOs.Menu.IngredientDto

<div class="mb-3">
    <label asp-for="Name" class="form-label required">Nazwa</label>
    <input asp-for="Name" class="form-control" />
    <span asp-validation-for="Name" class="text-danger small"></span>
</div>
<div class="row">
    <div class="col-md-6 mb-3">
        <label asp-for="Unit" class="form-label required">Jednostka</label>
        <input asp-for="Unit" class="form-control" placeholder="g, kg, szt." />
    </div>
    <div class="col-md-6 mb-3">
        <label asp-for="CostPerUnit" class="form-label">Koszt jednostkowy</label>
        <input asp-for="CostPerUnit" type="number" step="0.01" class="form-control" />
    </div>
</div>
<div class="mb-3">
    <label asp-for="Notes" class="form-label">Notatki</label>
    <textarea asp-for="Notes" class="form-control" rows="3"></textarea>
</div>
<label class="form-check form-switch mb-4">
    <input class="form-check-input" type="checkbox" asp-for="IsActive" />
    <span class="form-check-label">Składnik aktywny</span>
</label>
