@model IEnumerable<KuchniaUCygana.Application.DTOs.Menu.IngredientDto>
@{
    Layout = "_LayoutStaff";
    ViewData["Title"] = "Katalog składników";
    ViewData["Section"] = "Katalog Menu";
}

<div class="card card-premium">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h3 class="card-title">Składniki</h3>
        <a asp-action="Create" class="btn btn-primary">Nowy składnik</a>
    </div>
    <div class="table-responsive">
        <table class="table table-vcenter card-table">
            <thead>
                <tr>
                    <th>Nazwa</th>
                    <th>Jednostka</th>
                    <th>Koszt</th>
                    <th>Status</th>
                    <th class="text-end">Akcje</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td><strong>@item.Name</strong><div class="text-secondary small">@item.Notes</div></td>
                        <td>@item.Unit</td>
                        <td>@item.CostPerUnit.ToString("F2")</td>
                        <td>@(item.IsActive ? "Aktywny" : "Wstrzymany")</td>
                        <td class="text-end">
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Edytuj</a>
                            <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('Usunąć składnik?');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-danger">Usuń</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
