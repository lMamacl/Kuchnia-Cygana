@model KuchniaUCygana.Application.DTOs.Warehouse.WarehouseDemandDto
@{
    Layout = "_LayoutStaff";
    ViewData["Title"] = "Zapotrzebowanie magazynu";
    ViewData["Section"] = "Magazyn";
    ViewData["Description"] = "Agregacja składników i opakowań z opłaconych zamówień oraz snapshotu M2.";
}

@functions {
    string RiskColor(string risk)
        => risk switch
        {
            "Shortage" => "danger",
            "Expired" => "danger",
            "ExpiryRisk" => "warning",
            _ => "success"
        };
}

<div class="card card-premium mb-4">
    <div class="card-body">
        <form method="get" class="row align-items-end g-3">
            <div class="col-sm-6 col-lg-3">
                <label class="form-label fw-bold">Początek zakresu</label>
                <input type="date" name="startDate" class="form-control" value="@Model.StartDate.ToString("yyyy-MM-dd")" />
            </div>
            <div class="col-sm-6 col-lg-2">
                <label class="form-label fw-bold">Dni</label>
                <select name="days" class="form-select">
                    <option value="7" selected="@(Model.RangeDays == 7)">7</option>
                    <option value="14" selected="@(Model.RangeDays == 14)">14</option>
                    <option value="21" selected="@(Model.RangeDays == 21)">21</option>
                    <option value="31" selected="@(Model.RangeDays == 31)">31</option>
                </select>
            </div>
            <div class="col-12 col-lg-auto">
                <button type="submit" class="btn btn-primary">Przelicz</button>
                <button type="button" class="btn btn-outline-secondary" onclick="window.print()">Drukuj</button>
                <a asp-action="M2Plan" asp-route-startDate="@Model.StartDate.ToString("yyyy-MM-dd")" asp-route-days="@Model.RangeDays" class="btn btn-outline-primary">Plan z M2</a>
                <a asp-action="Index" asp-route-date="@Model.StartDate.ToString("yyyy-MM-dd")" class="btn btn-outline-secondary">Wróć do kuchni</a>
            </div>
        </form>
    </div>
</div>

<div class="row row-cards mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="card card-premium">
            <div class="card-body">
                <div class="subheader">Pozycje zamówień</div>
                <div class="h2 mb-1">@Model.TotalOrderItems</div>
                <div class="text-secondary small">Zakres: @Model.RangeDays dni</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card card-premium">
            <div class="card-body">
                <div class="subheader">Wiersze zapotrzebowania</div>
                <div class="h2 mb-1">@Model.TotalRows</div>
                <div class="text-secondary small">Składniki i opakowania</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card card-premium">
            <div class="card-body">
                <div class="subheader">Braki</div>
                <div class="h2 mb-1 text-danger">@Model.ShortageRows</div>
                <div class="text-secondary small">Wiersze z niedoborem</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card card-premium">
            <div class="card-body">
                <div class="subheader">Dni z planem M2</div>
                <div class="h2 mb-1">@Model.Days.Count(day => day.HasPublishedSnapshot) / @Model.RangeDays</div>
                <div class="text-secondary small">Opublikowany snapshot</div>
            </div>
        </div>
    </div>
</div>

<div class="card card-premium mb-4">
    <div class="card-header bg-transparent">
        <h3 class="card-title">Status dni</h3>
    </div>
    <div class="table-responsive">
        <table class="table table-vcenter card-table">
            <thead>
                <tr>
                    <th>Data</th>
                    <th>Status M2</th>
                    <th class="text-end">Snapshot items</th>
                    <th class="text-end">Order items</th>
                    <th class="text-end">Dopasowane</th>
                    <th class="text-end">Brak dopasowania</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var day in Model.Days)
                {
                    <tr>
                        <td>@day.PlanDate.ToString("dd.MM.yyyy")</td>
                        <td><span class="badge bg-@(day.HasPublishedSnapshot ? "success" : "secondary")-lt">@day.Status</span></td>
                        <td class="text-end">@day.SnapshotItemCount</td>
                        <td class="text-end">@day.OrderItemCount</td>
                        <td class="text-end">@day.MatchedOrderItemCount</td>
                        <td class="text-end @(day.MissingSnapshotMatches > 0 ? "text-danger fw-bold" : "text-secondary")">@day.MissingSnapshotMatches</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="card card-premium">
    <div class="card-header bg-transparent">
        <h3 class="card-title">FEFO preview i braki</h3>
    </div>
    <div class="table-responsive">
        <table class="table table-vcenter card-table">
            <thead>
                <tr>
                    <th>Zasób</th>
                    <th>Tryb FEFO</th>
                    <th class="text-end">Potrzeba</th>
                    <th class="text-end">Dostępne</th>
                    <th class="text-end">Brak</th>
                    <th>Najwcześniejsza partia</th>
                    <th>Ryzyko</th>
                    <th>Źródło</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Rows.Count == 0)
                {
                    <tr>
                        <td colspan="8" class="text-center text-secondary py-4">Brak zapotrzebowania dla wybranego zakresu.</td>
                    </tr>
                }
                @foreach (var row in Model.Rows)
                {
                    <tr>
                        <td>
                            <div class="fw-bold">@row.ResourceName</div>
                            <div class="small text-secondary">@row.ResourceType</div>
                        </td>
                        <td>
                            <span class="badge bg-blue-lt">@row.SelectionMode</span>
                            @if (row.StockItemId.HasValue)
                            {
                                <div class="small text-secondary">StockItemId @row.StockItemId</div>
                            }
                            else
                            {
                                <div class="small text-secondary">Kategoria @row.WarehouseCategoryId</div>
                            }
                        </td>
                        <td class="text-end">@row.RequiredQuantity.ToString("0.##") @row.Unit</td>
                        <td class="text-end">@row.AvailableQuantity.ToString("0.##") @row.Unit</td>
                        <td class="text-end @(row.ShortageQuantity > 0 ? "text-danger fw-bold" : "text-success")">@row.ShortageQuantity.ToString("0.##") @row.Unit</td>
                        <td>
                            @if (row.EarliestBatchId.HasValue)
                            {
                                <div>#@row.EarliestBatchId</div>
                                <div class="small text-secondary">@row.EarliestExpiryDate?.ToLocalTime().ToString("dd.MM.yyyy")</div>
                            }
                            else
                            {
                                <span class="text-secondary">brak partii</span>
                            }
                        </td>
                        <td><span class="badge bg-@RiskColor(row.RiskLabel)-lt">@row.RiskLabel</span></td>
                        <td class="small text-secondary">@string.Join(", ", row.SourceMeals.Take(3))</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
