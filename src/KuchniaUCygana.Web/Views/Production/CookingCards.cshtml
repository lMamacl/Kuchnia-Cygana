@model KuchniaUCygana.Application.DTOs.Production.ProductionPlanDto
@{
    Layout = "_LayoutStaff";
    ViewData["Title"] = "Wykaz Kart Gotowania";
    ViewData["Section"] = "Kuchnia";
    ViewData["Description"] = "Zbiór wszystkich aktywnych receptur i instrukcji przygotowania potraw zaplanowanych na dzisiaj.";

    var date = Model?.ProductionDate ?? 
               (DateOnly.TryParse(Context.Request.Query["date"], out var d) ? d : DateOnly.FromDateTime(DateTime.Today));
    var hasPlan = Model != null && Model.Items.Any();
}

@functions {
    string GetMealCategory(string mealName)
    {
        if (mealName.Contains("zup", StringComparison.OrdinalIgnoreCase)) return "Zupa";
        if (mealName.Contains("sernik", StringComparison.OrdinalIgnoreCase) || mealName.Contains("deser", StringComparison.OrdinalIgnoreCase) || mealName.Contains("ciast", StringComparison.OrdinalIgnoreCase)) return "Deser";
        if (mealName.Contains("śniadan", StringComparison.OrdinalIgnoreCase) || mealName.Contains("owsian", StringComparison.OrdinalIgnoreCase)) return "Śniadanie";
        return "Danie Główne";
    }

    string GetStatusColor(string status)
    {
        return status switch
        {
            "Cooked" => "success",
            "Cooking" => "warning",
            "Pending" => "secondary",
            _ => "secondary"
        };
    }

    string TranslateStatus(string status)
    {
        return status switch
        {
            "Cooked" => "Zakończone",
            "Cooking" => "W toku",
            "Pending" => "Oczekuje",
            _ => status
        };
    }
}

<!-- Pasek nawigacji datą -->
<div class="card card-premium mb-4">
    <div class="card-body py-3">
        <form method="get" class="row align-items-center g-3">
            <div class="col-auto">
                <label class="form-label mb-0 fw-bold">Dzień gotowania:</label>
            </div>
            <div class="col-auto">
                <input type="date" name="date" class="form-control" value="@date.ToString("yyyy-MM-dd")" onchange="this.form.submit()" />
            </div>
            <div class="col-auto ms-auto">
                <div class="btn-list">
                    <a asp-action="CookingCards" asp-route-date="@date.AddDays(-1)" class="btn btn-outline-secondary">
                        &laquo; Poprzedni dzień
                    </a>
                    <a asp-action="CookingCards" asp-route-date="@DateOnly.FromDateTime(DateTime.Today)" class="btn btn-outline-secondary">
                        Dzisiaj
                    </a>
                    <a asp-action="CookingCards" asp-route-date="@date.AddDays(1)" class="btn btn-outline-secondary">
                        Następny dzień &raquo;
                    </a>
                </div>
            </div>
        </form>
    </div>
</div>

@if (!hasPlan)
{
    <div class="row justify-content-center my-5">
        <div class="col-md-8 text-center">
            <div class="empty py-5">
                <div class="empty-icon mb-4 text-secondary">
                    <svg xmlns="http://www.w3.org/2000/svg" class="icon icon-tabler icon-tabler-calendar-off" width="64" height="64" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
                        <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                        <path d="M9 5h9a2 2 0 0 1 2 2v9m-.18 3.84a2 2 0 0 1 -1.82 1.16h-12a2 2 0 0 1 -2 -2v-12a2 2 0 0 1 1.158 -1.815" />
                        <path d="M16 3v4" />
                        <path d="M8 3v1" />
                        <path d="M4 11h7m4 0h5" />
                        <path d="M3 3l18 18" />
                    </svg>
                </div>
                <p class="empty-title h2 text-dark">Brak aktywnych kart gotowania</p>
                <p class="empty-subtitle text-secondary">
                    Nie wygenerowano jeszcze planu gotowania dla dnia <strong>@date.ToString("dd.MM.yyyy")</strong> lub plan nie zawiera żadnych pozycji.
                </p>
                <div class="empty-action mt-4">
                    <a asp-action="Index" asp-route-date="@date" class="btn btn-primary">Przejdź do Pulpitu Produkcji</a>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <div class="row row-cards">
        <div class="col-12">
            <div class="card card-premium">
                <div class="card-header bg-transparent d-flex justify-content-between align-items-center">
                    <h3 class="card-title">Aktywne Karty Gotowania na @date.ToString("dd.MM.yyyy")</h3>
                    <a asp-action="Index" asp-route-date="@date" class="btn btn-sm btn-outline-secondary">Wróć do Pulpitu</a>
                </div>
                
                <div class="table-responsive">
                    <table class="table table-vcenter card-table table-premium">
                        <thead>
                            <tr>
                                <th class="w-1">ID</th>
                                <th>Nazwa Potrawy</th>
                                <th>Kategoria</th>
                                <th class="text-center">Porcje</th>
                                <th>Status gotowania</th>
                                <th class="w-1">Operacje</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var card in Model.Items)
                            {
                                <tr>
                                    <td class="text-secondary font-weight-medium">#@card.Id</td>
                                    <td class="font-weight-bold text-dark">@card.MealName</td>
                                    <td><span class="badge bg-secondary-lt">@GetMealCategory(card.MealName)</span></td>
                                    <td class="text-center fw-bold">@card.PlannedQuantity szt.</td>
                                    <td>
                                        <span class="badge bg-@GetStatusColor(card.Status)-lt text-@GetStatusColor(card.Status) d-inline-flex align-items-center gap-1">
                                            <span class="status-dot bg-@GetStatusColor(card.Status) @(card.Status == "Cooking" ? "status-dot-pulse" : "")" style="width: 6px; height: 6px;"></span>
                                            @TranslateStatus(card.Status)
                                        </span>
                                    </td>
                                    <td>
                                        <a asp-action="CookingCard" asp-route-planItemId="@card.Id" class="btn btn-sm btn-outline-primary">
                                            Otwórz Kartę
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
}
