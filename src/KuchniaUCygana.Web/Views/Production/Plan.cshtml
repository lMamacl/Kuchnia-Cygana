@model KuchniaUCygana.Application.DTOs.Production.ProductionPlanDto
@{
    Layout = "_LayoutStaff";
    ViewData["Title"] = "Szczegóły Planu Produkcji";
    ViewData["Section"] = "Kuchnia";
    var hasItems = Model.Items.Count > 0;
    var hasPendingFefo = Model.Items.Any(item => !item.FefoDeductedAt.HasValue);
    var canRunFefo = hasPendingFefo && Model.Status is not ("Completed" or "Cancelled");
    ViewData["Description"] = "Bieżące monitorowanie stanu przygotowania potraw, receptur oraz zatwierdzanie ugotowanych porcji.";
}

@functions {
    string GetMealCategory(string mealName)
    {
        if (mealName.Contains("zup", StringComparison.OrdinalIgnoreCase)) return "Zupa";
        if (mealName.Contains("sernik", StringComparison.OrdinalIgnoreCase) || mealName.Contains("deser", StringComparison.OrdinalIgnoreCase) || mealName.Contains("ciast", StringComparison.OrdinalIgnoreCase)) return "Deser";
        if (mealName.Contains("śniadan", StringComparison.OrdinalIgnoreCase) || mealName.Contains("owsian", StringComparison.OrdinalIgnoreCase)) return "Śniadanie";
        return "Danie Główne";
    }

    string GetStatusColor(string status)
    {
        return status switch
        {
            "Cooked" => "success",
            "Cooking" => "warning",
            "Pending" => "secondary",
            _ => "secondary"
        };
    }

    string TranslateStatus(string status)
    {
        return status switch
        {
            "Cooked" => "Zakończone",
            "Cooking" => "W toku",
            "Pending" => "Oczekuje",
            _ => status
        };
    }

    string TranslatePlanStatus(string status)
    {
        return status switch
        {
            "Draft" => "Szkic",
            "Active" => "Aktywny",
            "InProgress" => "W toku",
            "Completed" => "Zakończony",
            "Cancelled" => "Anulowany",
            _ => status
        };
    }

    string GetPlanStatusColor(string status)
    {
        return status switch
        {
            "Draft" => "secondary",
            "Active" => "blue",
            "InProgress" => "warning",
            "Completed" => "success",
            "Cancelled" => "danger",
            _ => "secondary"
        };
    }
}

<div class="row row-cards">
    <!-- Informacje o Planie -->
    <div class="col-12">
        <div class="card card-premium">
            <div class="card-body py-4">
                <div class="row align-items-center g-3">
                    <div class="col">
                        <div class="text-uppercase text-secondary small fw-bold">Plan produkcji #@Model.Id</div>
                        <h2 class="h1 mb-1 text-dark">Dzień produkcji: @Model.ProductionDate.ToString("dd.MM.yyyy")</h2>
                        <div class="d-flex flex-wrap gap-2 align-items-center mt-2">
                            <span class="badge bg-@GetPlanStatusColor(Model.Status)-lt text-@GetPlanStatusColor(Model.Status) fw-bold d-inline-flex align-items-center gap-1">
                                <span class="status-dot bg-@GetPlanStatusColor(Model.Status) @(Model.Status == "InProgress" ? "status-dot-pulse" : "")" style="width: 6px; height: 6px;"></span>
                                Plan: @TranslatePlanStatus(Model.Status)
                            </span>
                            @if (Model.IsSharedWithLogistics)
                            {
                                <span class="badge bg-green-lt text-green fw-bold">Udostępniony logistyce</span>
                            }
                            @if (!string.IsNullOrEmpty(Model.Notes))
                            {
                                <span class="text-secondary small">Uwagi: @Model.Notes</span>
                            }
                        </div>
                    </div>
                    <div class="col-auto">
                        @if (canRunFefo)
                        {
                            <form asp-action="ProduceSemiFinished" asp-route-planId="@Model.Id" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-success me-2">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M7 10l5 -6l5 6v10a1 1 0 0 1 -1 1h-8a1 1 0 0 1 -1 -1z" /><path d="M21 10l-2 8" /><path d="M3 10l2 8" /></svg>
                                    Zdejmij Składniki (FEFO)
                                </button>
                            </form>
                        }
                        else if (hasItems)
                        {
                            <button type="button" class="btn btn-success me-2" disabled>
                                <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M7 10l5 -6l5 6v10a1 1 0 0 1 -1 1h-8a1 1 0 0 1 -1 -1z" /><path d="M21 10l-2 8" /><path d="M3 10l2 8" /></svg>
                                Składniki Zdjęte
                            </button>
                        }
                        <a asp-action="Index" asp-route-date="@Model.ProductionDate" class="btn btn-outline-secondary">Wróć do Pulpitu</a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Tabela Potraw w Planie -->
    <div class="col-12">
        <div class="card card-premium">
            <div class="card-header">
                <h3 class="card-title">Pozycje Planu Produkcyjnego</h3>
            </div>
            <div class="table-responsive">
                <table class="table table-vcenter card-table table-premium">
                    <thead>
                        <tr>
                            <th class="w-1">ID</th>
                            <th>Nazwa Dania / Potrawy</th>
                            <th>Kategoria</th>
                            <th class="text-center">Zaplanowane Porcje</th>
                            <th>FEFO</th>
                            <th>Status realizacji</th>
                            <th class="w-1 text-center">Operacje</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Items)
                        {
                            <tr>
                                <td class="text-secondary font-weight-medium">#@item.Id</td>
                                <td>
                                    <div class="font-weight-bold text-dark">@item.MealName</div>
                                </td>
                                <td>
                                    <span class="badge bg-secondary-lt">@GetMealCategory(item.MealName)</span>
                                </td>
                                <td class="text-center fw-bold text-dark">
                                    @item.PlannedQuantity szt.
                                </td>
                                <td>
                                    @if (item.FefoDeductedAt.HasValue)
                                    {
                                        <span class="badge bg-success-lt text-success">zdjete</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning-lt text-warning">do wykonania</span>
                                    }
                                </td>
                                <td>
                                    <span class="badge bg-@GetStatusColor(item.Status)-lt text-@GetStatusColor(item.Status) d-inline-flex align-items-center gap-1">
                                        <span class="status-dot bg-@GetStatusColor(item.Status) @(item.Status == "Cooking" ? "status-dot-pulse" : "")" style="width: 6px; height: 6px;"></span>
                                        @TranslateStatus(item.Status)
                                    </span>
                                </td>
                                <td>
                                    <div class="btn-list flex-nowrap justify-content-center">
                                        <a asp-action="CookingCard" asp-route-planItemId="@item.Id" class="btn btn-sm btn-outline-primary">
                                            Karta gotowania
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
