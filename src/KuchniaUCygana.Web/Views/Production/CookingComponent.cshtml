@model KuchniaUCygana.Application.DTOs.Production.CookingComponentCardDto
@{
    Layout = "_LayoutStaff";
    ViewData["Title"] = "Gotowanie skladowej";
    ViewData["Section"] = "Kuchnia";
    ViewData["Description"] = "Operacyjna karta skladowej ze snapshotu M2.";

    var sessionStarted = Model.Session.Status != "NotStarted";
    var sessionCompleted = Model.Session.Status == "Completed";
}

@functions {
    string FormatWeight(decimal weightInGrams)
    {
        if (weightInGrams >= 1000m)
        {
            return $"{(weightInGrams / 1000m):0.##} kg";
        }

        return $"{weightInGrams:0.##} g";
    }

    string FormatQuantity(decimal quantity, string unit)
        => unit.Equals("g", StringComparison.OrdinalIgnoreCase)
            ? FormatWeight(quantity)
            : $"{quantity:0.###} {unit}";

    string StatusColor(string status)
        => status switch
        {
            "Completed" => "success",
            "InProgress" => "azure",
            _ => "secondary",
        };

    string StepCardClass(bool isChecked, bool requiresControl, bool isCritical)
        => isChecked
            ? "border-success bg-success-lt"
            : isCritical
                ? "border-danger bg-white"
                : requiresControl
                    ? "border-warning bg-white"
                    : "border bg-white";

    string StepStatusBadge(bool isChecked)
        => isChecked
            ? "bg-success-lt text-success"
            : "bg-secondary-lt text-secondary";
}

<div class="row g-4">
    <div class="col-lg-4">
        <div class="card card-premium">
            <div class="card-status-top bg-azure"></div>
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start gap-3 mb-3">
                    <div>
                        <div class="text-secondary small">Danie</div>
                        <h2 class="h3 mb-1">@Model.MealName</h2>
                        @if (!string.IsNullOrWhiteSpace(Model.MealVariantName))
                        {
                            <div class="text-secondary small">Wariant: @Model.MealVariantName</div>
                        }
                    </div>
                    <span class="badge bg-@StatusColor(Model.Session.Status)-lt text-@StatusColor(Model.Session.Status)">
                        @Model.Session.Status
                    </span>
                </div>

                <div class="hr my-3"></div>

                <dl class="row mb-0">
                    <dt class="col-6 text-secondary fw-normal">Data</dt>
                    <dd class="col-6 text-end">@Model.ProductionDate.ToString("dd.MM.yyyy")</dd>
                    <dt class="col-6 text-secondary fw-normal">Porcje</dt>
                    <dd class="col-6 text-end fw-bold">@Model.PlannedQuantity szt.</dd>
                    <dt class="col-6 text-secondary fw-normal">Status pozycji</dt>
                    <dd class="col-6 text-end">@Model.ProductionStatus</dd>
                    <dt class="col-6 text-secondary fw-normal">FEFO</dt>
                    <dd class="col-6 text-end @(Model.FefoDeductedAt.HasValue ? "text-success" : "text-warning")">
                        @(Model.FefoDeductedAt.HasValue ? "wykonane" : "do wykonania")
                    </dd>
                    <dt class="col-6 text-secondary fw-normal">Opakowania</dt>
                    <dd class="col-6 text-end @(Model.PackagingDeductedAt.HasValue ? "text-success" : "text-secondary")">
                        @(Model.PackagingDeductedAt.HasValue ? "zdjete" : "czekaja")
                    </dd>
                </dl>

                <div class="hr my-3"></div>

                <div class="mb-3">
                    <div class="text-secondary small">Skladowa</div>
                    <div class="fw-bold">@Model.ComponentName</div>
                    <div class="small text-secondary">
                        v@Model.VersionNumber
                        @if (!string.IsNullOrWhiteSpace(Model.Role))
                        {
                            <span> · @Model.Role</span>
                        }
                    </div>
                </div>

                <div class="row g-2 mb-3">
                    <div class="col-6">
                        <div class="border rounded p-2 h-100">
                            <div class="text-secondary small">Na porcje</div>
                            <div class="fw-bold">@FormatQuantity(Model.QuantityPerServing, Model.Unit)</div>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="border rounded p-2 h-100">
                            <div class="text-secondary small">Lacznie</div>
                            <div class="fw-bold">@FormatQuantity(Model.TotalQuantity, Model.Unit)</div>
                        </div>
                    </div>
                </div>

                @if (Model.RequiresCoreTemperatureCheck)
                {
                    <div class="alert alert-warning">
                        Wymagany test temperatury rdzenia
                        @if (Model.MinimumCoreTemperatureCelsius.HasValue)
                        {
                            <strong>min. @Model.MinimumCoreTemperatureCelsius.Value.ToString("0.#") C</strong>
                        }
                    </div>
                }

                @if (Model.FefoDeductedAt is null)
                {
                    <div class="alert alert-danger">
                        Najpierw wykonaj FEFO dla planu produkcji. Sesji skladowej nie mozna uruchomic przed zdjeciem magazynu.
                    </div>
                }
                else if (!sessionStarted)
                {
                    <form asp-action="StartCookingComponent"
                          asp-route-planItemId="@Model.PlanItemId"
                          asp-route-recipeComponentVersionId="@Model.RecipeComponentVersionId"
                          method="post">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-primary w-100">Rozpocznij gotowanie skladowej</button>
                    </form>
                }
                else if (!sessionCompleted)
                {
                    <form asp-action="CompleteCookingComponent"
                          asp-route-planItemId="@Model.PlanItemId"
                          asp-route-recipeComponentVersionId="@Model.RecipeComponentVersionId"
                          method="post">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-success w-100">Oznacz skladowa jako ukonczona</button>
                        <div class="form-hint text-center mt-2">Wymagane kroki krytyczne i kontrolne musza byc odznaczone.</div>
                    </form>
                }
                else
                {
                    <div class="alert alert-success mb-0">
                        Skladowa ukonczona przez @(Model.Session.CompletedBy ?? "-")
                        @if (Model.Session.CompletedAt.HasValue)
                        {
                            <span>@Model.Session.CompletedAt.Value.ToLocalTime().ToString("dd.MM HH:mm")</span>
                        }
                    </div>
                }
            </div>
            <div class="card-footer bg-transparent">
                <a asp-action="CookingCard" asp-route-planItemId="@Model.PlanItemId" class="btn btn-outline-secondary w-100">Wroc do karty dania</a>
            </div>
        </div>
    </div>

    <div class="col-lg-8">
        <div class="card card-premium mb-4">
            <div class="card-header bg-transparent">
                <h3 class="card-title">Kroki przygotowania</h3>
            </div>
            <div class="card-body">
                @if (!Model.InstructionSections.Any())
                {
                    <div class="text-secondary">Snapshot M2 nie zawiera krokow instrukcji dla tej skladowej.</div>
                }
                else
                {
                    foreach (var section in Model.InstructionSections.OrderBy(section => section.SortOrder))
                    {
                        <section class="mb-4">
                            <h4 class="h5 mb-3">@(string.IsNullOrWhiteSpace(section.Title) ? "Sekcja" : section.Title)</h4>
                            <div class="vstack gap-3">
                                @foreach (var step in section.Steps.OrderBy(step => step.SortOrder))
                                {
                                    Model.Session.StepChecksByStepId.TryGetValue(step.StepId, out var check);
                                    var isChecked = check?.IsChecked == true;
                                    <form asp-action="ToggleCookingComponentStep"
                                          asp-route-planItemId="@Model.PlanItemId"
                                          asp-route-recipeComponentVersionId="@Model.RecipeComponentVersionId"
                                          asp-route-stepId="@step.StepId"
                                          method="post"
                                          class="rounded p-3 @StepCardClass(isChecked, step.RequiresControl, step.IsCritical)">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="isChecked" value="@(isChecked ? "false" : "true")" />
                                        <div class="d-flex justify-content-between gap-3">
                                            <div class="d-flex gap-3">
                                                <div class="d-flex align-items-center justify-content-center rounded-circle border @(isChecked ? "bg-success text-white border-success" : "bg-white text-secondary")"
                                                     style="width: 34px; height: 34px; min-width: 34px; font-weight: 700;">
                                                    @if (isChecked)
                                                    {
                                                        <span>&#10003;</span>
                                                    }
                                                </div>
                                                <div>
                                                <div class="fw-bold">
                                                    @step.SortOrder. @step.StepText
                                                </div>
                                                <div class="small text-secondary mt-1">
                                                    <span class="badge @StepStatusBadge(isChecked) me-1">
                                                        @(isChecked ? "wykonane" : "do wykonania")
                                                    </span>
                                                    @if (step.IsCritical)
                                                    {
                                                        <span class="badge bg-red-lt text-red me-1">krytyczny</span>
                                                    }
                                                    @if (step.RequiresControl)
                                                    {
                                                        <span class="badge bg-orange-lt text-orange me-1">kontrola</span>
                                                    }
                                                    @if (step.ExpectedValue.HasValue)
                                                    {
                                                        <span>oczekiwane: @step.ExpectedValue.Value.ToString("0.##") @step.ExpectedUnit</span>
                                                    }
                                                </div>
                                                @if (step.RequiresControl)
                                                {
                                                    <div class="alert alert-warning mt-2 mb-0 py-2">
                                                        Ten krok wymaga wpisania wyniku kontroli
                                                        @if (step.ControlType == "CoreTemperature")
                                                        {
                                                            <strong>temperatury rdzenia</strong>
                                                        }
                                                        @if (step.ExpectedValue.HasValue)
                                                        {
                                                            <span> - minimum/oczekiwane: @step.ExpectedValue.Value.ToString("0.##") @step.ExpectedUnit.</span>
                                                        }
                                                    </div>
                                                }
                                                @if (isChecked)
                                                {
                                                    <div class="small text-success mt-1">
                                                        Odznaczono przez @(check?.CheckedBy ?? "-")
                                                        @if (check?.CheckedAt.HasValue == true)
                                                        {
                                                            <span>@check.CheckedAt.Value.ToLocalTime().ToString("dd.MM HH:mm")</span>
                                                        }
                                                    </div>
                                                }
                                                </div>
                                            </div>
                                            <button type="submit" class="btn btn-sm @(isChecked ? "btn-outline-secondary" : "btn-primary")" disabled="@(!sessionStarted || sessionCompleted)">
                                                @(isChecked ? "Cofnij wykonanie" : "Oznacz jako wykonane")
                                            </button>
                                        </div>

                                        @if (step.RequiresControl)
                                        {
                                            <div class="row g-2 mt-3">
                                                <div class="col-md-3">
                                                    <label class="form-label">Wartosc</label>
                                                    <input type="number" step="0.01" name="actualValue" class="form-control" value="@check?.ActualValue" disabled="@(!sessionStarted || sessionCompleted)" required="@(!isChecked)" />
                                                </div>
                                                <div class="col-md-3">
                                                    <label class="form-label">Jednostka</label>
                                                    <input type="text" name="actualUnit" class="form-control" value="@(check?.ActualUnit ?? step.ExpectedUnit)" disabled="@(!sessionStarted || sessionCompleted)" required="@(!isChecked)" />
                                                </div>
                                                <div class="col-md-6">
                                                    <label class="form-label">Notatka</label>
                                                    <input type="text" name="notes" class="form-control" value="@check?.Notes" disabled="@(!sessionStarted || sessionCompleted)" />
                                                </div>
                                            </div>
                                        }
                                    </form>
                                }
                            </div>
                        </section>
                    }
                }
            </div>
        </div>

        <div class="card card-premium mb-4">
            <div class="card-header bg-transparent d-flex justify-content-between align-items-center">
                <h3 class="card-title">Skladniki skladowej</h3>
                <span class="badge bg-azure-lt text-azure">na @Model.PlannedQuantity porcji</span>
            </div>
            <div class="table-responsive">
                <table class="table table-vcenter card-table">
                    <thead>
                        <tr>
                            <th>Skladnik</th>
                            <th>Kategoria</th>
                            <th class="text-end">Na 1 porcje</th>
                            <th class="text-end">Lacznie</th>
                            <th>Kontrola</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var ingredient in Model.Ingredients)
                        {
                            <tr>
                                <td class="fw-bold">@ingredient.IngredientName</td>
                                <td><span class="badge bg-secondary-lt">@(ingredient.WarehouseCategoryName ?? "Brak mapowania")</span></td>
                                <td class="text-end">@FormatWeight(ingredient.WeightPerServing)</td>
                                <td class="text-end fw-bold">@FormatWeight(ingredient.TotalWeight)</td>
                                <td>
                                    @if (ingredient.RequiresCoreTemperatureCheck)
                                    {
                                        <span class="badge bg-orange-lt text-orange">@ingredient.MinimumCoreTemperatureCelsius?.ToString("0.#") C</span>
                                    }
                                    else
                                    {
                                        <span class="text-secondary">-</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        @if (Model.PackagingRequirements.Any() || Model.Allergens.Any() || Model.NutritionFacts is not null)
        {
            <div class="row g-4">
                <div class="col-md-6">
                    <div class="card card-premium h-100">
                        <div class="card-header bg-transparent">
                            <h3 class="card-title">Opakowania i alergeny</h3>
                        </div>
                        <div class="card-body">
                            @if (Model.PackagingRequirements.Any())
                            {
                                <div class="mb-3">
                                    <div class="text-secondary small mb-1">Opakowania</div>
                                    <ul class="mb-0">
                                        @foreach (var packaging in Model.PackagingRequirements)
                                        {
                                            <li>@packaging.ResourceName: @packaging.TotalQuantity.ToString("0.##") @packaging.Unit</li>
                                        }
                                    </ul>
                                </div>
                            }
                            <div>
                                <div class="text-secondary small mb-1">Alergeny</div>
                                <div>@(Model.Allergens.Any() ? string.Join(", ", Model.Allergens) : "Brak zadeklarowanych alergenow")</div>
                            </div>
                        </div>
                    </div>
                </div>
                @if (Model.NutritionFacts is not null)
                {
                    <div class="col-md-6">
                        <div class="card card-premium h-100">
                            <div class="card-header bg-transparent">
                                <h3 class="card-title">Wartosci odzywcze skladowej / 100 g</h3>
                            </div>
                            <div class="card-body">
                                <div class="row g-2 text-center">
                                    <div class="col-6"><strong>@Model.NutritionFacts.CaloriesPer100g.ToString("0")</strong><div class="small text-secondary">kcal</div></div>
                                    <div class="col-6"><strong>@Model.NutritionFacts.ProteinPer100g.ToString("0.#")</strong><div class="small text-secondary">bialko</div></div>
                                    <div class="col-6"><strong>@Model.NutritionFacts.CarbohydratesPer100g.ToString("0.#")</strong><div class="small text-secondary">wegle</div></div>
                                    <div class="col-6"><strong>@Model.NutritionFacts.FatPer100g.ToString("0.#")</strong><div class="small text-secondary">tluszcz</div></div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>
