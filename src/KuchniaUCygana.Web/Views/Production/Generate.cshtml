@model KuchniaUCygana.Application.DTOs.Production.CreateProductionPlanRequest
@{
    Layout = "_LayoutStaff";
    ViewData["Title"] = "Generuj Plan Produkcji";
    ViewData["Section"] = "Kuchnia";
    ViewData["Description"] = "Uruchom inteligentny proces bilansowania zamówień i generowania dziennego planu gotowania.";
    DateOnly selectedDate = ViewBag.SelectedDate;
}

<div class="row justify-content-center">
    <div class="col-lg-8 col-xl-6">
        <div class="card card-premium">
            <div class="card-status-top bg-primary"></div>
            <div class="card-header bg-transparent py-3">
                <h3 class="card-title d-flex align-items-center gap-2">
                    <svg xmlns="http://www.w3.org/2000/svg" class="icon text-primary" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M12 3l8 4.5l-8 4.5l-8 -4.5z" /><path d="M12 12l8 4.5l-8 4.5l-8 -4.5z" /><path d="M12 12v9" /><path d="M12 3v9" /></svg>
                    Uruchomienie generatora planu
                </h3>
            </div>
            <div class="card-body">
                <form asp-action="Generate" method="post" autocomplete="off">
                    @Html.AntiForgeryToken()

                    <div class="alert alert-info alert-premium-smart bg-info-lt border-info p-3 mb-4">
                        <div class="d-flex align-items-start gap-3">
                            <svg xmlns="http://www.w3.org/2000/svg" class="icon text-info mt-1" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M3 12a9 9 0 1 0 18 0a9 9 0 0 0 -18 0" /><path d="M12 9h.01" /><path d="M11 12h1v4h1" /></svg>
                            <div>
                                <h4 class="alert-title text-info fw-bold mb-1">Co się stanie po wygenerowaniu?</h4>
                                <p class="text-secondary small mb-0">
                                    System automatycznie sprawdzi wszystkie aktywne zamówienia klientów na wybrany dzień, pogrupuje je według dań i obliczy zapotrzebowanie na składniki zgodnie z zarejestrowanymi recepturami. Następnie wygeneruje karty gotowania dla zespołu kuchennego.
                                </p>
                            </div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label required">Data planowanej produkcji</label>
                        <div class="input-icon">
                            <span class="input-icon-addon">
                                <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M4 7a2 2 0 0 1 2 -2h12a2 2 0 0 1 2 2v12a2 2 0 0 1 -2 2h-12a2 2 0 0 1 -2 -2v-12z" /><path d="M16 3v4" /><path d="M8 3v4" /><path d="M4 11h16" /><path d="M11 15h1" /><path d="M12 15v3" /></svg>
                            </span>
                            <input type="date" asp-for="ProductionDate" class="form-control" value="@selectedDate.ToString("yyyy-MM-dd")" required />
                        </div>
                        <span asp-validation-for="ProductionDate" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Wskazówki i uwagi dla kuchni (opcjonalnie)</label>
                        <textarea asp-for="Notes" class="form-control" rows="4" placeholder="Wpisz specyficzne instrukcje, np. 'Uwaga na alergeny orzechowe przy deserach' lub 'Ryby dostarczy kurier do godziny 07:00'"></textarea>
                        <span asp-validation-for="Notes" class="text-danger small"></span>
                    </div>

                    <div class="card-footer bg-transparent p-0 pt-3 d-flex justify-content-between">
                        <a asp-action="Index" class="btn btn-outline-secondary">Powrót</a>
                        <button type="submit" class="btn btn-primary">
                            Generuj Plan i Receptury
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
