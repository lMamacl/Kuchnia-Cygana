@using KuchniaUCygana.Domain.Enums
@model KuchniaUCygana.Web.Models.KitchenReworkViewModel
@{
    Layout = "_LayoutStaff";
    ViewData["Title"] = "Ponowne przygotowanie";
    ViewData["Section"] = "Kuchnia";
    ViewData["Description"] = "Zamienniki pudełek zgłoszone przez kompletację.";

    var filter = Model.Filter;
    var page = Model.Page;
}

@functions {
    string StatusLabel(PackingIncidentStatus status) => status switch
    {
        PackingIncidentStatus.New => "Nowe",
        PackingIncidentStatus.InProgress => "W przygotowaniu",
        PackingIncidentStatus.KitchenReworkRequested => "Do ponownego przygotowania",
        PackingIncidentStatus.WarehouseActionRequired => "Czeka też na magazyn",
        PackingIncidentStatus.Resolved => "Zamknięte",
        _ => status.ToString()
    };

    IDictionary<string, string> RouteValues(int page)
    {
        var values = new Dictionary<string, string>
        {
            ["date"] = Model.SelectedDate.ToString("yyyy-MM-dd"),
            ["page"] = page.ToString(),
            ["pageSize"] = Model.Filter.PageSize.ToString(),
        };

        Add(values, "search", Model.Filter.Search);
        Add(values, "status", Model.Filter.Status);
        return values;
    }

    void Add(IDictionary<string, string> values, string key, string? value)
    {
        if (!string.IsNullOrWhiteSpace(value))
        {
            values[key] = value;
        }
    }
}

<div class="row row-cards">
    <div class="col-12">
        <div class="card card-premium">
            <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
                <div>
                    <h3 class="card-title mb-1">Ponowne przygotowanie</h3>
                    <div class="text-secondary small">Zamienniki pudełek po zgłoszeniach z kompletacji.</div>
                </div>
            </div>
            <div class="card-body border-bottom">
                <form method="get" class="row align-items-end g-3">
                    <input type="hidden" name="page" value="1" />
                    <div class="col-sm-6 col-lg-2">
                        <label class="form-label fw-bold">Data</label>
                        <input type="date" class="form-control" name="date" value="@Model.SelectedDate.ToString("yyyy-MM-dd")" />
                    </div>
                    <div class="col-sm-6 col-lg-3">
                        <label class="form-label fw-bold">Szukaj</label>
                        <input type="search" class="form-control" name="search" value="@filter.Search" placeholder="Danie, klient, pudełko, powód" />
                    </div>
                    <div class="col-sm-6 col-lg-3">
                        <label class="form-label fw-bold">Status</label>
                        <select name="status" class="form-select">
                            <option value="">Wszystkie</option>
                            <option value="New" selected="@(filter.Status == "New")">Nowe</option>
                            <option value="InProgress" selected="@(filter.Status == "InProgress")">W przygotowaniu</option>
                            <option value="KitchenReworkRequested" selected="@(filter.Status == "KitchenReworkRequested")">Do ponownego przygotowania</option>
                            <option value="WarehouseActionRequired" selected="@(filter.Status == "WarehouseActionRequired")">Czeka też na magazyn</option>
                            <option value="Resolved" selected="@(filter.Status == "Resolved")">Zamknięte</option>
                        </select>
                    </div>
                    <div class="col-sm-6 col-lg-1">
                        <label class="form-label fw-bold">Strona</label>
                        <select name="pageSize" class="form-select">
                            <option value="10" selected="@(filter.PageSize == 10)">10</option>
                            <option value="25" selected="@(filter.PageSize == 25)">25</option>
                            <option value="50" selected="@(filter.PageSize == 50)">50</option>
                            <option value="100" selected="@(filter.PageSize == 100)">100</option>
                        </select>
                    </div>
                    <div class="col-12 col-lg-auto">
                        <button type="submit" class="btn btn-indigo">Pokaż</button>
                        <a asp-action="Rework" asp-route-date="@Model.SelectedDate.ToString("yyyy-MM-dd")" class="btn btn-outline-secondary">Wyczyść</a>
                    </div>
                </form>
            </div>
            <div class="card-header">
                <div>
                    <h3 class="card-title mb-0">Zgłoszenia do ponownego przygotowania</h3>
                    <div class="text-secondary small">
                        Wyniki @((page.TotalCount == 0 ? 0 : ((page.Page - 1) * page.PageSize) + 1)) - @Math.Min(page.Page * page.PageSize, page.TotalCount) z @(page.TotalCount)
                    </div>
                </div>
            </div>
            <div class="table-responsive">
                <table class="table table-vcenter card-table table-premium">
                    <thead>
                        <tr>
                            <th>Zgłoszenie</th>
                            <th>Dostawa</th>
                            <th>Danie</th>
                            <th>Powód</th>
                            <th>Status</th>
                            <th class="w-1 text-end">Akcje</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!page.Items.Any())
                        {
                            <tr>
                                <td colspan="6" class="text-center text-secondary py-4">Brak zamienników dla wybranych filtrów.</td>
                            </tr>
                        }
                        @foreach (var incident in page.Items)
                        {
                            <tr>
                                <td>
                                    <div class="fw-bold">#@incident.Id</div>
                                    <div class="text-secondary small">@incident.ReportedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</div>
                                </td>
                                <td>
                                    <div>Klient ID: <strong>@(incident.ClientPublicId ?? "-")</strong></div>
                                    <div class="text-secondary small">DeliveryCalendarId: @(incident.DeliveryCalendarId?.ToString() ?? "-")</div>
                                    <div class="text-secondary small">Sesja: #@incident.PackingSessionId</div>
                                </td>
                                <td>
                                    <div class="fw-bold">@incident.MealName</div>
                                    @if (incident.ReplacementPackingItemStatus.HasValue)
                                    {
                                        <div class="text-secondary small">Status zamiennika: @incident.ReplacementPackingItemStatus</div>
                                    }
                                    <div class="text-secondary small">Zamiennik pudełka: #@(incident.ReplacementPackingItemId?.ToString() ?? "-")</div>
                                    <div class="text-secondary small">Oryginał: @(incident.BoxCode ?? "-")</div>
                                </td>
                                <td>
                                    <div>@incident.ReasonSummary</div>
                                    @if (!string.IsNullOrWhiteSpace(incident.Description))
                                    {
                                        <div class="text-secondary small">@incident.Description</div>
                                    }
                                </td>
                                <td>
                                    <span class="badge bg-azure-lt text-azure">@StatusLabel(incident.Status)</span>
                                    @if (incident.KitchenStartedAt.HasValue)
                                    {
                                        <div class="text-secondary small mt-1">Start: @incident.KitchenStartedAt.Value.ToLocalTime().ToString("HH:mm")</div>
                                    }
                                    @if (incident.KitchenPreparedAt.HasValue)
                                    {
                                        <div class="text-success small mt-1">Przygotowane: @incident.KitchenPreparedAt.Value.ToLocalTime().ToString("HH:mm")</div>
                                    }
                                </td>
                                <td class="text-end">
                                    <div class="d-flex flex-column gap-2 align-items-end">
                                        @if (!incident.KitchenStartedAt.HasValue)
                                        {
                                            <form asp-action="StartRework" asp-route-incidentId="@incident.Id" method="post">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="date" value="@Model.SelectedDate.ToString("yyyy-MM-dd")" />
                                                <button type="submit" class="btn btn-sm btn-outline-primary">Oznacz w przygotowaniu</button>
                                            </form>
                                        }
                                        @if (!incident.KitchenPreparedAt.HasValue)
                                        {
                                            <form asp-action="MarkReworkPrepared" asp-route-incidentId="@incident.Id" method="post">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="date" value="@Model.SelectedDate.ToString("yyyy-MM-dd")" />
                                                <button type="submit" class="btn btn-sm btn-outline-success">Oznacz jako przygotowane</button>
                                            </form>
                                        }
                                        @if (incident.ReplacementPackingItemId.HasValue && incident.KitchenPreparedAt.HasValue && incident.ReplacementPackingItemStatus == PackingItemStatus.Pending)
                                        {
                                            <form asp-action="PrintFoilLabel" asp-route-packingItemId="@incident.ReplacementPackingItemId.Value" method="post" target="_blank">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="returnDate" value="@Model.SelectedDate.ToString("yyyy-MM-dd")" />
                                                <button type="submit" class="btn btn-sm btn-indigo">Drukuj etykietę</button>
                                            </form>
                                        }
                                        else if (incident.ReplacementPackingItemId.HasValue && incident.ReplacementPackingItemStatus is PackingItemStatus.FoilPrinted or PackingItemStatus.Packed)
                                        {
                                            <a asp-action="FoilLabel" asp-route-packingItemId="@incident.ReplacementPackingItemId.Value" target="_blank" class="btn btn-sm btn-outline-secondary">Podgląd etykiety</a>
                                        }
                                        else if (incident.ReplacementPackingItemId.HasValue)
                                        {
                                            <span class="badge bg-secondary-lt text-secondary">Etykieta po przygotowaniu</span>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            @if (page.TotalPages > 1)
            {
                <div class="card-footer d-flex align-items-center">
                    <div class="text-secondary small">Strona @(page.Page) z @(page.TotalPages)</div>
                    <ul class="pagination m-0 ms-auto">
                        <li class="page-item @(page.Page <= 1 ? "disabled" : "")">
                            <a class="page-link" asp-action="Rework" asp-all-route-data="@RouteValues(Math.Max(1, page.Page - 1))">Poprzednia</a>
                        </li>
                        @{
                            var firstPage = Math.Max(1, page.Page - 2);
                            var lastPage = Math.Min(page.TotalPages, page.Page + 2);
                        }
                        @for (var pageNumber = firstPage; pageNumber <= lastPage; pageNumber++)
                        {
                            <li class="page-item @(pageNumber == page.Page ? "active" : "")">
                                <a class="page-link" asp-action="Rework" asp-all-route-data="@RouteValues(pageNumber)">@pageNumber</a>
                            </li>
                        }
                        <li class="page-item @(page.Page >= page.TotalPages ? "disabled" : "")">
                            <a class="page-link" asp-action="Rework" asp-all-route-data="@RouteValues(Math.Min(page.TotalPages, page.Page + 1))">Następna</a>
                        </li>
                    </ul>
                </div>
            }
        </div>
    </div>
</div>
