@{
    Layout = "_LayoutStaff";
    ViewData["Title"] = "Interaktywna Karta Gotowania";
    ViewData["Section"] = "Kuchnia";
    ViewData["Description"] = "Szczegółowa specyfikacja receptury z automatycznym przeliczaniem ilości składników na zadaną liczbę porcji.";

    int planItemId = ViewBag.PlanItemId > 0 ? ViewBag.PlanItemId : 101;

    // Definiujemy mockowe danie w zależności od ID dla uwiarygodnienia widoku
    var dishName = "Kurczak Teriyaki z ryżem jaśminowym i brokułami";
    var category = "Danie Główne";
    var portions = 240;
    var image = "/img/chicken_teriyaki.png";

    if (planItemId == 102)
    {
        dishName = "Krem z pieczonej dyni z pestkami i imbirem";
        category = "Zupa";
        portions = 150;
        image = "/img/pumpkin_soup.png";
    }
    else if (planItemId == 103)
    {
        dishName = "Proteinowy sernik jagodowy bez cukru";
        category = "Deser";
        portions = 180;
        image = "/img/blueberry_cheesecake.png";
    }
    else if (planItemId == 104)
    {
        dishName = "Łosoś pieczony w ziołach z purée z batatów";
        category = "Danie Główne";
        portions = 110;
        image = "/img/baked_salmon.png";
    }

    // Składniki bazowe na 1 porcję
    var ingredients = new[]
    {
        new { Name = "Pierś z kurczaka świeża", BaseQty = 0.15m, Unit = "kg" },
        new { Name = "Sos Teriyaki domowy", BaseQty = 0.04m, Unit = "l" },
        new { Name = "Ryż jaśminowy", BaseQty = 0.08m, Unit = "kg" },
        new { Name = "Brokuły świeże", BaseQty = 0.06m, Unit = "kg" },
        new { Name = "Sezam biały", BaseQty = 0.005m, Unit = "kg" }
    };
}

<div class="row g-4">
    <!-- Informacje o Danie & Formularz Zatwierdzenia -->
    <div class="col-lg-5">
        <div class="card card-premium">
            <div class="card-status-top bg-azure"></div>
            <div class="card-body p-4">
                <div class="d-flex align-items-center gap-3 mb-4">
                    <span class="avatar avatar-xl rounded-3" style="background-image: url(@image); width: 80px; height: 80px; background-size: cover; background-position: center; border: 1px solid rgba(0, 0, 0, 0.08);"></span>
                    <div>
                        <span class="badge bg-indigo-lt text-indigo mb-1">@category</span>
                        <h2 class="h2 mb-0 text-dark">@dishName</h2>
                        <div class="text-secondary small mt-1">Pozycja planu #@planItemId</div>
                    </div>
                </div>

                <div class="hr my-3"></div>

                <div class="d-flex justify-content-between mb-3">
                    <span class="text-secondary">Wymagane porcje:</span>
                    <strong class="text-dark">@portions szt.</strong>
                </div>

                <form asp-action="ApproveCooking" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="planItemId" value="@planItemId" />
                    
                    <div class="mb-3">
                        <label class="form-label required">Ugotowana ilość rzeczywista (szt.)</label>
                        <input type="number" name="actualQuantity" class="form-control form-control-lg text-center fw-bold" value="@portions" required min="0" />
                        <small class="form-hint text-center">Wpisz faktyczną liczbę gotowych porcji, która trafi do pakowania.</small>
                    </div>

                    <button type="submit" class="btn btn-success w-100 py-2">
                        <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M5 12l5 5l10 -10" /></svg>
                        Zatwierdź Wykonanie Potrawy
                    </button>
                </form>
            </div>
            <div class="card-footer bg-transparent d-flex justify-content-between">
                <a asp-action="Index" class="btn btn-outline-secondary">Wróć do planu</a>
            </div>
        </div>
    </div>

    <!-- Skalowana receptura -->
    <div class="col-lg-7">
        <div class="card card-premium">
            <div class="card-header bg-transparent d-flex justify-content-between align-items-center">
                <h3 class="card-title">Zapotrzebowanie na Składniki (Skalowane)</h3>
                <span class="badge bg-azure-lt text-azure">Przeliczono na @portions porcji</span>
            </div>
            <div class="table-responsive">
                <table class="table table-vcenter card-table table-premium">
                    <thead>
                        <tr>
                            <th>Składnik</th>
                            <th class="text-end">Na 1 porcję</th>
                            <th class="text-end font-weight-bold fw-bold text-dark">Łącznie dla @portions porcji</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var ing in ingredients)
                        {
                            var totalQty = ing.BaseQty * portions;
                            <tr>
                                <td class="font-weight-medium fw-bold text-dark">@ing.Name</td>
                                <td class="text-end text-secondary">
                                    @ing.BaseQty.ToString("F3") @ing.Unit
                                </td>
                                <td class="text-end font-weight-bold fw-bold text-azure" style="font-size: 1.05rem;">
                                    @totalQty.ToString("F2") @ing.Unit
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
