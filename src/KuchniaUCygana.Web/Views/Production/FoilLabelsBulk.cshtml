@model IEnumerable<KuchniaUCygana.Application.DTOs.Packing.PackingLabelDto>
@{
    Layout = "_LayoutStaff";
    ViewData["Title"] = "Etykiety foliowe zbiorczo";
    ViewData["Section"] = "Kuchnia";
    var errors = ViewBag.Errors as IReadOnlyList<string> ?? Array.Empty<string>();
    ViewData["Description"] = "Zbiorczy wydruk etykiet foliowych na pudełka.";
}

@section Styles {
    <style>
        .foil-label-card {
            border: 2px dashed #475569;
            border-radius: 6px;
            padding: 3mm;
            background: #fff;
            width: 68mm;
            max-width: 100%;
            margin: 0;
            color: #0f172a;
            position: relative;
            font-size: 7.2pt;
            line-height: 1.15;
            overflow-wrap: anywhere;
            break-inside: avoid;
            page-break-inside: avoid;
        }

        .label-sheet {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(68mm, 1fr));
            gap: 4mm;
            align-items: start;
        }

        .foil-label-card h2 {
            font-size: 11pt;
            line-height: 1.05;
        }

        .foil-label-card .badge {
            font-size: 7pt;
            white-space: nowrap;
        }

        .foil-label-body {
            display: grid;
            grid-template-columns: minmax(0, 1fr) 22mm;
            gap: 2.5mm;
            align-items: start;
        }

        .foil-label-copy {
            min-width: 0;
        }

        .foil-label-full {
            grid-column: 1 / -1;
        }

        .foil-label-qr {
            width: 22mm;
            height: 22mm;
            border: 1px solid #cbd5e1;
            padding: 1mm;
            background: #fff;
            font-size: 5pt;
            line-height: 1.05;
            overflow-wrap: anywhere;
        }

        .foil-label-nutrition {
            width: 100%;
            table-layout: fixed;
            font-size: 6.2pt;
            line-height: 1.08;
            word-break: normal;
            overflow-wrap: normal;
        }

        .foil-label-nutrition th,
        .foil-label-nutrition td {
            padding: 0.7mm 0.8mm;
            white-space: normal;
            word-break: normal;
            overflow-wrap: normal;
            vertical-align: top;
        }

        .foil-label-nutrition th:nth-child(1),
        .foil-label-nutrition td:nth-child(1) {
            width: 42%;
        }

        .foil-label-nutrition th:nth-child(2),
        .foil-label-nutrition td:nth-child(2),
        .foil-label-nutrition th:nth-child(3),
        .foil-label-nutrition td:nth-child(3) {
            width: 29%;
        }

        .nutrition-header-short {
            display: none;
        }

        .foil-label-ingredients {
            overflow-wrap: anywhere;
        }

        @@media print {
            @@page {
                size: A4;
                margin: 6mm;
            }

            body * {
                visibility: hidden;
            }

            .printable-area,
            .printable-area * {
                visibility: visible;
            }

            .printable-area {
                position: absolute;
                left: 0;
                top: 0;
                width: 198mm;
            }

            .label-sheet {
                display: grid;
                grid-template-columns: repeat(3, 64mm);
                gap: 3mm;
                align-items: start;
            }

            .foil-label-card {
                border: 2px solid #000 !important;
                box-shadow: none !important;
                margin: 0;
                page-break-inside: avoid;
                break-inside: avoid;
                width: 64mm;
                min-height: 64mm;
                max-width: 64mm;
                padding: 2.2mm;
                font-size: 6.5pt;
            }

            .foil-label-nutrition {
                font-size: 5.2pt;
                line-height: 1.02;
            }

            .foil-label-nutrition th,
            .foil-label-nutrition td {
                padding: 0.45mm 0.5mm;
            }

            .foil-label-nutrition th {
                white-space: nowrap;
            }

            .nutrition-header-full {
                display: none;
            }

            .nutrition-header-short {
                display: inline;
            }

            .d-print-none {
                display: none !important;
            }
        }
    </style>
}

<div class="card card-premium d-print-none mb-4">
    <div class="card-body d-flex justify-content-between align-items-center">
        <div>
            <h3 class="mb-1 text-dark">Druk zbiorczy etykiet foliowych</h3>
            <p class="text-secondary small mb-0">Wygenerowano @Model.Count() etykiet gotowych do wydruku.</p>
        </div>
        <div class="btn-list">
            <button class="btn btn-primary" onclick="window.print();">
                <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M17 17h2a2 2 0 0 0 2 -2v-4a2 2 0 0 0 -2 -2h-14a2 2 0 0 0 -2 2v4a2 2 0 0 0 2 2h2" /><path d="M17 9v-4a2 2 0 0 0 -2 -2h-6a2 2 0 0 0 -2 2v4" /><path d="M7 13m0 2a2 2 0 0 1 2 -2h6a2 2 0 0 1 2 2v4a2 2 0 0 1 -2 2h-6a2 2 0 0 1 -2 -2z" /></svg>
                Uruchom druk
            </button>
            <a asp-action="FoilPrinting" class="btn btn-outline-secondary">Wróć do listy</a>
        </div>
    </div>
</div>

@if (errors.Count > 0)
{
    <div class="alert alert-warning d-print-none">
        <div class="fw-bold">Pominieto @errors.Count etykiet.</div>
        <ul class="mb-0">
            @foreach (var error in errors.Take(10))
            {
                <li>@error</li>
            }
        </ul>
    </div>
}

<div class="printable-area">
    <div class="label-sheet">
        @foreach (var label in Model)
        {
            <div class="foil-label-card shadow-sm">
                    <div class="d-flex justify-content-between align-items-start border-bottom border-secondary pb-2 mb-3">
                        <div>
                            <div class="text-uppercase text-secondary fw-bold small" style="font-size: 0.7rem; letter-spacing: 0.05em;">Kuchnia u Cygana</div>
                            <h2 class="h3 font-weight-bold text-dark mb-0">@label.DishName</h2>
                            @if (!string.IsNullOrWhiteSpace(label.MealVariantName))
                            {
                                <div class="small text-secondary">Wariant: @label.MealVariantName</div>
                            }
                        </div>
                        @if (label.Kcal.HasValue)
                        {
                            <span class="badge bg-dark text-white fw-bold py-1 px-2">@label.Kcal kcal</span>
                        }
                    </div>

                    <div class="foil-label-body">
                        <div class="foil-label-copy">
                            <div class="mb-2">
                                <div class="text-uppercase text-secondary small fw-bold" style="font-size: 0.65rem;">Składniki:</div>
                                <div class="foil-label-ingredients small text-dark" style="line-height: 1.3;">
                                    @if (label.IngredientGroups.Count > 0)
                                    {
                                        foreach (var group in label.IngredientGroups)
                                        {
                                            <div><span class="fw-semibold">@group.GroupName:</span> @string.Join(", ", group.Ingredients)</div>
                                        }
                                    }
                                    else
                                    {
                                        <div>@(string.IsNullOrWhiteSpace(label.Ingredients) ? "Brak danych" : label.Ingredients)</div>
                                    }
                                </div>
                            </div>

                            <div>
                                <div class="text-uppercase text-danger small fw-bold" style="font-size: 0.65rem;">Alergeny:</div>
                                <div class="small text-danger fw-semibold">@label.Allergens</div>
                            </div>
                        </div>
                        <div class="text-end">
                            <div class="foil-label-qr d-flex align-items-center justify-content-center text-center small fw-bold">
                                @label.QrCode
                            </div>
                        </div>
                        <div class="foil-label-full mt-2">
                            <div class="text-uppercase text-secondary small fw-bold" style="font-size: 0.65rem;">Warto&#347;ci od&#380;ywcze produktu</div>
                            <div class="small text-dark mb-1">
                                @if (label.ServingWeightGrams.HasValue)
                                {
                                    <span>Gramatura: @label.ServingWeightGrams.Value.ToString("0.##") g</span>
                                }
                            </div>
                            @if (label.NutritionRows.Count > 0)
                            {
                                <table class="table table-sm table-bordered foil-label-nutrition mb-0">
                                    <colgroup>
                                        <col style="width: 42%;" />
                                        <col style="width: 29%;" />
                                        <col style="width: 29%;" />
                                    </colgroup>
                                    <thead>
                                        <tr>
                                            <th>Sk&#322;adnik</th>
                                            <th>
                                                <span class="nutrition-header-full">w 100 g produktu</span>
                                                <span class="nutrition-header-short">100 g</span>
                                            </th>
                                            <th>
                                                <span class="nutrition-header-full">w porcji</span>
                                                <span class="nutrition-header-short">porcja</span>
                                            </th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var row in label.NutritionRows)
                                        {
                                            <tr>
                                                <td>@row.Name</td>
                                                <td>@row.Per100g</td>
                                                <td>@row.PerServing</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            }
                            else
                            {
                                <div class="small text-dark">Brak danych</div>
                            }
                        </div>
                        <div class="foil-label-full mt-2 text-secondary" style="font-size: 0.7rem;">
                            Kod QR: <strong class="text-dark">@label.QrCode</strong>
                        </div>
                    </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        window.addEventListener('load', function() {
            setTimeout(function() {
                window.print();
            }, 300);
        });
    </script>
}
