@model KuchniaUCygana.Application.DTOs.Packing.PackingLabelDto
@{
    Layout = "_LayoutStaff";
    ViewData["Title"] = "Etykieta foliowa";
    ViewData["Section"] = "Kuchnia";
    ViewData["Description"] = "Wydruk etykiety foliowej na pudełko z kodem QR posiłku.";
}

@section Styles {
    <style>
        .foil-label-card {
            border: 2px dashed #475569;
            border-radius: 6px;
            padding: 3mm;
            background: #fff;
            width: 68mm;
            max-width: 100%;
            margin: 0 auto;
            color: #0f172a;
            position: relative;
            font-size: 7.2pt;
            line-height: 1.15;
            overflow-wrap: anywhere;
        }

        .foil-label-card h2 {
            font-size: 11pt;
            line-height: 1.05;
        }

        .foil-label-card .badge {
            font-size: 7pt;
            white-space: nowrap;
        }

        .foil-label-body {
            display: grid;
            grid-template-columns: minmax(0, 1fr) 22mm;
            gap: 2.5mm;
            align-items: start;
        }

        .foil-label-copy {
            min-width: 0;
        }

        .foil-label-full {
            grid-column: 1 / -1;
        }

        .foil-label-qr {
            width: 22mm;
            height: 22mm;
            border: 1px solid #cbd5e1;
            padding: 1mm;
            background: #fff;
            font-size: 5pt;
            line-height: 1.05;
            overflow-wrap: anywhere;
        }

        .foil-label-nutrition {
            width: 100%;
            table-layout: fixed;
            font-size: 6.2pt;
            line-height: 1.08;
            word-break: normal;
            overflow-wrap: normal;
        }

        .foil-label-nutrition th,
        .foil-label-nutrition td {
            padding: 0.7mm 0.8mm;
            white-space: normal;
            word-break: normal;
            overflow-wrap: normal;
            vertical-align: top;
        }

        .foil-label-nutrition th:nth-child(1),
        .foil-label-nutrition td:nth-child(1) {
            width: 42%;
        }

        .foil-label-nutrition th:nth-child(2),
        .foil-label-nutrition td:nth-child(2),
        .foil-label-nutrition th:nth-child(3),
        .foil-label-nutrition td:nth-child(3) {
            width: 29%;
        }

        .nutrition-header-short {
            display: none;
        }

        .foil-label-ingredients {
            overflow-wrap: anywhere;
        }

        @@media print {
            @@page {
                size: A4;
                margin: 6mm;
            }

            body * {
                visibility: hidden;
            }

            .printable-label,
            .printable-label * {
                visibility: visible;
            }

            .printable-label {
                position: absolute;
                left: 0;
                top: 0;
                width: 68mm;
            }

            .foil-label-card {
                border: 2px solid #000 !important;
                box-shadow: none !important;
                margin: 0;
                width: 68mm;
                min-height: 64mm;
                max-width: 68mm;
                padding: 2.5mm;
                font-size: 6.8pt;
                page-break-inside: avoid;
                break-inside: avoid;
            }

            .foil-label-nutrition {
                font-size: 5.2pt;
                line-height: 1.02;
            }

            .foil-label-nutrition th,
            .foil-label-nutrition td {
                padding: 0.45mm 0.5mm;
            }

            .foil-label-nutrition th {
                white-space: nowrap;
            }

            .nutrition-header-full {
                display: none;
            }

            .nutrition-header-short {
                display: inline;
            }

            .d-print-none {
                display: none !important;
            }
        }
    </style>
}

<div class="card card-premium d-print-none mb-4">
    <div class="card-body d-flex justify-content-between align-items-center">
        <div>
            <h3 class="mb-1 text-dark">Druk etykiety foliowej</h3>
            <p class="text-secondary small mb-0">Etykieta przeznaczona do naklejenia bezpośrednio na folię zgrzewanego pudełka.</p>
        </div>
        <div class="btn-list">
            <button class="btn btn-primary" onclick="window.print();">
                <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M17 17h2a2 2 0 0 0 2 -2v-4a2 2 0 0 0 -2 -2h-14a2 2 0 0 0 -2 2v4a2 2 0 0 0 2 2h2" /><path d="M17 9v-4a2 2 0 0 0 -2 -2h-6a2 2 0 0 0 -2 2v4" /><path d="M7 13m0 2a2 2 0 0 1 2 -2h6a2 2 0 0 1 2 2v4a2 2 0 0 1 -2 2h-6a2 2 0 0 1 -2 -2z" /></svg>
                Drukuj ponownie
            </button>
            <a asp-action="FoilPrinting" class="btn btn-outline-secondary">Wróć do listy</a>
        </div>
    </div>
</div>

<div class="printable-label">
    <div class="foil-label-card shadow-sm">
        <div class="d-flex justify-content-between align-items-start border-bottom border-secondary pb-2 mb-3">
            <div>
                <div class="text-uppercase text-secondary fw-bold small" style="font-size: 0.7rem; letter-spacing: 0.05em;">Kuchnia u Cygana</div>
                <h2 class="h3 font-weight-bold text-dark mb-0">@Model.DishName</h2>
                @if (!string.IsNullOrWhiteSpace(Model.MealVariantName))
                {
                    <div class="small text-secondary">Wariant: @Model.MealVariantName</div>
                }
            </div>
            @if (Model.Kcal.HasValue)
            {
                <span class="badge bg-dark text-white fw-bold py-1 px-2">@Model.Kcal kcal</span>
            }
        </div>

        <div class="foil-label-body">
            <div class="foil-label-copy">
                <div class="mb-2">
                    <div class="text-uppercase text-secondary small fw-bold" style="font-size: 0.65rem;">Składniki:</div>
                    <div class="foil-label-ingredients small text-dark" style="line-height: 1.3;">
                        @if (Model.IngredientGroups.Count > 0)
                        {
                            foreach (var group in Model.IngredientGroups)
                            {
                                <div><span class="fw-semibold">@group.GroupName:</span> @string.Join(", ", group.Ingredients)</div>
                            }
                        }
                        else
                        {
                            <div>@(string.IsNullOrWhiteSpace(Model.Ingredients) ? "Brak danych" : Model.Ingredients)</div>
                        }
                    </div>
                </div>

                <div>
                    <div class="text-uppercase text-danger small fw-bold" style="font-size: 0.65rem;">Alergeny:</div>
                    <div class="small text-danger fw-semibold">@Model.Allergens</div>
                </div>
            </div>
            <div class="text-end">
                <div class="foil-label-qr d-flex align-items-center justify-content-center text-center small fw-bold">
                    @Model.QrCode
                </div>
            </div>
            <div class="foil-label-full mt-2">
                <div class="text-uppercase text-secondary small fw-bold" style="font-size: 0.65rem;">Warto&#347;ci od&#380;ywcze produktu</div>
                <div class="small text-dark mb-1">
                    @if (Model.ServingWeightGrams.HasValue)
                    {
                        <span>Gramatura: @Model.ServingWeightGrams.Value.ToString("0.##") g</span>
                    }
                </div>
                @if (Model.NutritionRows.Count > 0)
                {
                    <table class="table table-sm table-bordered foil-label-nutrition mb-0">
                        <colgroup>
                            <col style="width: 42%;" />
                            <col style="width: 29%;" />
                            <col style="width: 29%;" />
                        </colgroup>
                        <thead>
                            <tr>
                                <th>Sk&#322;adnik</th>
                                <th>
                                    <span class="nutrition-header-full">w 100 g produktu</span>
                                    <span class="nutrition-header-short">100 g</span>
                                </th>
                                <th>
                                    <span class="nutrition-header-full">w porcji</span>
                                    <span class="nutrition-header-short">porcja</span>
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in Model.NutritionRows)
                            {
                                <tr>
                                    <td>@row.Name</td>
                                    <td>@row.Per100g</td>
                                    <td>@row.PerServing</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <div class="small text-dark">Brak danych</div>
                }
            </div>
            <div class="foil-label-full mt-2 text-secondary" style="font-size: 0.7rem;">
                Kod QR: <strong class="text-dark">@Model.QrCode</strong>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        window.addEventListener('load', function() {
            setTimeout(function() {
                window.print();
            }, 300);
        });
    </script>
}
