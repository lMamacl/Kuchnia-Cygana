@model KuchniaUCygana.Application.DTOs.Packing.PackingLabelDto
@{
    Layout = "_LayoutStaff";
    ViewData["Title"] = "Etykieta foliowa";
    ViewData["Section"] = "Kuchnia";
    ViewData["Description"] = "Wydruk etykiety foliowej na pudełko z kodem QR posiłku.";
}

@section Styles {
    <style>
        .foil-label-card {
            border: 2px dashed #475569;
            border-radius: 6px;
            padding: 1.25rem;
            background: #fff;
            max-width: 420px;
            margin: 0 auto;
            color: #0f172a;
            position: relative;
        }

        .foil-label-qr {
            width: 100px;
            height: 100px;
            border: 1px solid #cbd5e1;
            padding: 4px;
            background: #fff;
        }

        @@media print {
            body * {
                visibility: hidden;
            }

            .printable-label,
            .printable-label * {
                visibility: visible;
            }

            .printable-label {
                position: absolute;
                left: 0;
                top: 0;
                width: 100%;
            }

            .foil-label-card {
                border: 2px solid #000 !important;
                box-shadow: none !important;
                margin: 0;
                width: 100%;
                max-width: 100%;
                page-break-inside: avoid;
            }

            .d-print-none {
                display: none !important;
            }
        }
    </style>
}

<div class="card card-premium d-print-none mb-4">
    <div class="card-body d-flex justify-content-between align-items-center">
        <div>
            <h3 class="mb-1 text-dark">Druk etykiety foliowej</h3>
            <p class="text-secondary small mb-0">Etykieta przeznaczona do naklejenia bezpośrednio na folię zgrzewanego pudełka.</p>
        </div>
        <div class="btn-list">
            <button class="btn btn-primary" onclick="window.print();">
                <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M17 17h2a2 2 0 0 0 2 -2v-4a2 2 0 0 0 -2 -2h-14a2 2 0 0 0 -2 2v4a2 2 0 0 0 2 2h2" /><path d="M17 9v-4a2 2 0 0 0 -2 -2h-6a2 2 0 0 0 -2 2v4" /><path d="M7 13m0 2a2 2 0 0 1 2 -2h6a2 2 0 0 1 2 2v4a2 2 0 0 1 -2 2h-6a2 2 0 0 1 -2 -2z" /></svg>
                Drukuj ponownie
            </button>
            <a asp-action="FoilPrinting" class="btn btn-outline-secondary">Wróć do listy</a>
        </div>
    </div>
</div>

<div class="printable-label">
    <div class="foil-label-card shadow-sm">
        <div class="d-flex justify-content-between align-items-start border-bottom border-secondary pb-2 mb-3">
            <div>
                <div class="text-uppercase text-secondary fw-bold small" style="font-size: 0.7rem; letter-spacing: 0.05em;">Kuchnia u Cygana</div>
                <h2 class="h3 font-weight-bold text-dark mb-0">@Model.DishName</h2>
            </div>
            @if (Model.Kcal.HasValue)
            {
                <span class="badge bg-dark text-white fw-bold py-1 px-2">@Model.Kcal kcal</span>
            }
        </div>

        <div class="row align-items-center">
            <div class="col">
                <div class="mb-2">
                    <div class="text-uppercase text-secondary small fw-bold" style="font-size: 0.65rem;">Składniki:</div>
                    <div class="small text-dark" style="line-height: 1.3;">@Model.Ingredients</div>
                </div>

                <div>
                    <div class="text-uppercase text-danger small fw-bold" style="font-size: 0.65rem;">Alergeny:</div>
                    <div class="small text-danger fw-semibold">@Model.Allergens</div>
                </div>

                <div class="mt-3 text-secondary" style="font-size: 0.7rem;">
                    Kod QR: <strong class="text-dark">@Model.QrCode</strong>
                </div>
            </div>
            <div class="col-auto text-end">
                <div class="foil-label-qr d-flex align-items-center justify-content-center text-center small fw-bold">
                    @Model.QrCode
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        window.addEventListener('load', function() {
            setTimeout(function() {
                window.print();
            }, 300);
        });
    </script>
}
