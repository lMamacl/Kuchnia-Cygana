@model KuchniaUCygana.Web.Models.PackingDeliveryViewModel
@{
    Layout = "_LayoutStaff";
    ViewData["Title"] = "Kontrola manifestu";
    ViewData["Section"] = "Załadunek";
    ViewData["Description"] = "Podgląd i zatwierdzenie manifestu przed załadunkiem auta.";

    var route = Model.Route;
    var manifest = Model.Manifest!;
    var selectedDate = Model.SelectedDate;
    var statusColor = manifest.IsVerified ? "success" : "warning";
    var statusText = manifest.IsVerified ? "Manifest zatwierdzony" : "Manifest wymaga kontroli";
}

<div class="row row-cards">
    <!-- Górny panel podsumowujący (Premium KPI) -->
    <div class="col-12">
        <div class="card card-premium shadow-sm">
            <div class="card-body py-4">
                <div class="row align-items-center g-3">
                    <div class="col">
                        <div class="text-uppercase text-secondary small fw-bold tracking-wider mb-1">
                            Manifest cyfrowy · <span class="font-monospace">@manifest.ManifestNumber</span>
                        </div>
                        <h1 class="h2 mb-2 text-dark font-weight-bold">@route.RouteName</h1>
                        
                        <!-- Grid KPI z Ikonami -->
                        <div class="row g-3 mt-2">
                            <div class="col-6 col-sm-4 col-md-2">
                                <div class="d-flex align-items-center gap-2">
                                    <div class="bg-primary-lt p-2 rounded">
                                        <svg xmlns="http://www.w3.org/2000/svg" class="icon text-primary m-0" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><rect x="4" y="5" width="16" height="16" rx="2" /><line x1="16" y1="3" x2="16" y2="7" /><line x1="8" y1="3" x2="8" y2="7" /><line x1="4" y1="11" x2="20" y2="11" /><rect x="8" y="14" width="8" height="4" rx="1" /></svg>
                                    </div>
                                    <div>
                                        <div class="text-secondary small">Data</div>
                                        <div class="fw-bold text-dark">@selectedDate.ToString("dd.MM.yyyy")</div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-6 col-sm-4 col-md-2">
                                <div class="d-flex align-items-center gap-2">
                                    <div class="bg-primary-lt p-2 rounded">
                                        <svg xmlns="http://www.w3.org/2000/svg" class="icon text-primary m-0" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><circle cx="7" cy="17" r="2" /><circle cx="17" cy="17" r="2" /><path d="M5 17h-2v-6l2-5h9l4 5h1a2 2 0 0 1 2 2v4h-2" /><line x1="9" y1="17" x2="15" y2="17" /></svg>
                                    </div>
                                    <div>
                                        <div class="text-secondary small">Pojazd</div>
                                        <div class="fw-bold text-dark">@route.VehicleRegistration</div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-6 col-sm-4 col-md-2">
                                <div class="d-flex align-items-center gap-2">
                                    <div class="bg-primary-lt p-2 rounded">
                                        <svg xmlns="http://www.w3.org/2000/svg" class="icon text-primary m-0" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><line x1="9" y1="6" x2="20" y2="6" /><line x1="9" y1="12" x2="20" y2="12" /><line x1="9" y1="18" x2="20" y2="18" /><line x1="5" y1="6" x2="5" y2="6.01" /><line x1="5" y1="12" x2="5" y2="12.01" /><line x1="5" y1="18" x2="5" y2="18.01" /></svg>
                                    </div>
                                    <div>
                                        <div class="text-secondary small">Wersja</div>
                                        <div class="fw-bold text-dark">v@manifest.ManifestVersion</div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-6 col-sm-4 col-md-2">
                                <div class="d-flex align-items-center gap-2">
                                    <div class="bg-primary-lt p-2 rounded">
                                        <svg xmlns="http://www.w3.org/2000/svg" class="icon text-primary m-0" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M14 4h-4v-2h4v2z" /><path d="M6 4h12a2 2 0 0 1 2 2v14a2 2 0 0 1 -2 2h-12a2 2 0 0 1 -2 -2v-14a2 2 0 0 1 2 -2z" /><path d="M10 10v4" /><path d="M14 10v4" /></svg>
                                    </div>
                                    <div>
                                        <div class="text-secondary small">Torby</div>
                                        <div class="fw-bold text-dark">@route.TotalBags</div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-6 col-sm-4 col-md-2">
                                <div class="d-flex align-items-center gap-2">
                                    <div class="bg-primary-lt p-2 rounded">
                                        <svg xmlns="http://www.w3.org/2000/svg" class="icon text-primary m-0" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><polyline points="12 3 20 7.5 20 16.5 12 21 4 16.5 4 7.5 12 3" /><line x1="12" y1="12" x2="20" y2="7.5" /><line x1="12" y1="12" x2="12" y2="21" /><line x1="12" y1="12" x2="4" y2="7.5" /><line x1="16" y1="5.25" x2="8" y2="9.75" /></svg>
                                    </div>
                                    <div>
                                        <div class="text-secondary small">Pudełka</div>
                                        <div class="fw-bold text-dark">@route.Bags.Sum(b => b.TotalBoxes)</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Baner Statusu w Nagłówku -->
                    <div class="col-auto">
                        <div class="bg-@statusColor-lt text-@statusColor px-4 py-3 rounded border border-@statusColor d-flex align-items-center gap-2">
                            @if (manifest.IsVerified)
                            {
                                <svg xmlns="http://www.w3.org/2000/svg" class="icon icon-tabler icon-tabler-shield-check" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M9 12l2 2l4 -4" /><path d="M12 3a12 12 0 0 0 8.5 3a12 12 0 0 1 -8.5 15a12 12 0 0 1 -8.5 -15a12 12 0 0 0 8.5 -3" /></svg>
                            }
                            else
                            {
                                <svg xmlns="http://www.w3.org/2000/svg" class="icon icon-tabler icon-tabler-alert-circle" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><circle cx="12" cy="12" r="9" /><line x1="12" y1="8" x2="12" y2="12" /><line x1="12" y1="16" x2="12.01" y2="16" /></svg>
                            }
                            <span class="fw-bold fs-3">@statusText</span>
                        </div>
                    </div>
                </div>
                
                <div class="border-top mt-3 pt-3 text-secondary small d-flex flex-wrap justify-content-between align-items-center gap-2">
                    <div>
                        Wygenerowano: <strong>@manifest.GeneratedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</strong> przez <strong>@(manifest.GeneratedBy ?? "System")</strong>
                        @if (!string.IsNullOrWhiteSpace(manifest.ChangeReason))
                        {
                            <span class="mx-2 text-muted">|</span><span>Powód zmiany: <strong class="text-dark">@manifest.ChangeReason</strong></span>
                        }
                    </div>
                    @if (manifest.IsVerified && manifest.VerifiedAt.HasValue)
                    {
                        <div>
                            Zatwierdzono: <strong class="text-success">@manifest.VerifiedAt.Value.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</strong>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Karta główna z kontrolą manifestu -->
    <div class="col-12">
        <div class="card shadow-sm">
            <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
                <h3 class="card-title text-dark">Spis kontrolny trasy</h3>
                <div class="btn-list">
                    <a asp-action="Route" asp-route-routeId="@route.RouteId" asp-route-date="@selectedDate.ToString("yyyy-MM-dd")" class="btn btn-outline-secondary">
                        <svg xmlns="http://www.w3.org/2000/svg" class="icon icon-tabler icon-tabler-arrow-left" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><line x1="5" y1="12" x2="19" y2="12" /><line x1="5" y1="12" x2="11" y2="18" /><line x1="5" y1="12" x2="11" y2="6" /></svg> Wróć do trasy
                    </a>
                    <a asp-action="ManifestJson" asp-route-routeId="@route.RouteId" asp-route-date="@selectedDate.ToString("yyyy-MM-dd")" class="btn btn-outline-secondary">
                        <svg xmlns="http://www.w3.org/2000/svg" class="icon icon-tabler icon-tabler-code" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><polyline points="7 8 3 12 7 16" /><polyline points="17 8 21 12 17 16" /><line x1="14" y1="4" x2="10" y2="20" /></svg> Payload JSON
                    </a>
                </div>
            </div>
            
            <!-- Panel weryfikacji manifestu -->
            @if (!manifest.IsVerified)
            {
                <div class="card-body bg-light border-bottom">
                    <form asp-action="VerifyManifest" asp-route-routeId="@route.RouteId" method="post" class="m-0">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="date" value="@selectedDate.ToString("yyyy-MM-dd")" />
                        <div class="row align-items-center g-3">
                            <div class="col-md">
                                <label class="form-check m-0 py-1">
                                    <input class="form-check-input" type="checkbox" name="confirmedManifest" value="true" required />
                                    <span class="form-check-label text-dark fw-medium">
                                        Potwierdzam pełną zgodność stopów trasy, kodów toreb, etykiet transportowych oraz liczby pudełek z fizyczną dostawą przygotowaną do załadunku.
                                    </span>
                                </label>
                            </div>
                            <div class="col-md-auto">
                                <button type="submit" class="btn btn-success btn-lg px-4" disabled="@(!route.CanVerifyManifest ? "disabled" : null)">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="icon icon-tabler icon-tabler-check" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><line x1="5" y1="12" x2="9" y2="16" /><line x1="19" y1="6" x2="9" y2="16" /></svg> Zatwierdź manifest
                                </button>
                            </div>
                        </div>
                        @if (!route.CanVerifyManifest)
                        {
                            <div class="text-danger small mt-2 d-flex align-items-center gap-1">
                                <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><circle cx="12" cy="12" r="9" /><line x1="12" y1="8" x2="12" y2="12" /><line x1="12" y1="16" x2="12.01" y2="16" /></svg>
                                Manifest można zatwierdzić dopiero po spakowaniu wszystkich toreb dla tej trasy.
                            </div>
                        }
                    </form>
                </div>
            }
            
            <div class="table-responsive">
                <table class="table table-vcenter card-table table-hover table-premium mb-0">
                    <thead class="bg-light text-uppercase fs-6 tracking-wider">
                        <tr>
                            <th class="w-1 py-3 text-center">Stop</th>
                            <th class="py-3">Adresat &amp; Zamówienie</th>
                            <th class="py-3">Adres dostawy</th>
                            <th class="py-3">Etykieta &amp; Torba</th>
                            <th class="py-3 text-center">Pudełka</th>
                            <th class="py-3 text-end">Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var bag in route.Bags.OrderBy(b => b.StopNumber).ThenBy(b => b.BagNumber))
                        {
                            <tr class="align-middle">
                                <td class="text-center py-3">
                                    <span class="avatar avatar-sm bg-dark text-white rounded-circle fw-bold">
                                        #@bag.StopNumber
                                    </span>
                                </td>
                                <td class="py-3">
                                    <div class="fw-bold text-dark fs-3">@bag.ClientName</div>
                                    <div class="text-secondary small d-flex align-items-center gap-2">
                                        <span>Zamówienie: <strong>#@bag.OrderId</strong></span>
                                        <span class="text-muted">·</span>
                                        <span>CalendarId: <strong>@(bag.DeliveryCalendarId?.ToString() ?? "-")</strong></span>
                                    </div>
                                </td>
                                <td class="py-3">
                                    <div class="text-dark d-flex align-items-start gap-1">
                                        <svg xmlns="http://www.w3.org/2000/svg" class="icon text-muted mt-1" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><circle cx="12" cy="11" r="3" /><path d="M17.657 16.657l-4.243 4.243a2 2 0 0 1 -2.827 0l-4.244 -4.243a8 8 0 1 1 11.314 0z" /></svg>
                                        <div>
                                            <div class="fw-medium">@bag.Address</div>
                                            <div class="text-secondary small font-monospace">@bag.DeliveryWindow</div>
                                        </div>
                                    </div>
                                </td>
                                <td class="py-3">
                                    <div class="d-flex align-items-center gap-2 mb-1">
                                        <span class="font-monospace fw-bold text-dark fs-3">@bag.BagCode</span>
                                        <span class="badge bg-indigo-lt text-indigo">Torba @bag.BagNumber</span>
                                    </div>
                                    <div>
                                        @if (bag.HasLabels)
                                        {
                                            <span class="badge bg-success-lt text-success d-inline-flex align-items-center gap-1">
                                                <svg xmlns="http://www.w3.org/2000/svg" class="icon icon-tabler icon-tabler-tag" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M11 3l9 9a1.5 1.5 0 0 1 0 2l-6 6a1.5 1.5 0 0 1 -2 0l-9 -9v-4a2 2 0 0 1 2 -2h4" /><circle cx="9" cy="9" r="1" /></svg>
                                                Transportowa gotowa
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger-lt text-danger d-inline-flex align-items-center gap-1">
                                                <svg xmlns="http://www.w3.org/2000/svg" class="icon icon-tabler icon-tabler-alert-triangle" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M12 9v2m0 4v.01" /><path d="M5 19h14a2 2 0 0 0 1.84 -2.75l-7.1 -12.25a2 2 0 0 0 -3.5 0l-7.1 12.25a2 2 0 0 0 1.75 2.75" /></svg>
                                                Brak etykiety
                                            </span>
                                        }
                                    </div>
                                </td>
                                <td class="text-center py-3">
                                    <div class="h3 mb-0 text-dark">@bag.PackedBoxes / @bag.TotalBoxes</div>
                                    <div class="text-secondary small">zapakowane</div>
                                </td>
                                <td class="text-end py-3">
                                    <span class="badge bg-@bag.StatusColor-lt text-@bag.StatusColor px-3 py-2 fs-5">
                                        @bag.StatusText
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
