@model TransportLabelReprintFormViewModel
@{
    Layout = "_LayoutStaff";
    ViewData["Title"] = "Redruk etykiet trasy";
    ViewData["Section"] = "Załadunek";
    ViewData["Description"] = "Kontrola i audyt redruku etykiet transportowych dla całej trasy.";

    var dateText = Model.Date?.ToString("yyyy-MM-dd") ?? string.Empty;
}

<div class="row g-4">
    <div class="col-xl-7">
        <div class="card card-premium">
            <div class="card-body">
                <h3 class="mb-1 text-dark">Formularz redruku etykiet trasy</h3>
                <p class="text-secondary small mb-4">Redruk trasy utworzy osobny rekord audytowy dla każdej etykiety transportowej widocznej poniżej.</p>

                @if (!Model.Labels.Any())
                {
                    <div class="alert alert-warning">Nie znaleziono etykiet do redruku dla tej trasy.</div>
                }
                else
                {
                    <div class="table-responsive mb-4">
                        <table class="table table-sm align-middle">
                            <thead>
                                <tr>
                                    <th>Kod torby</th>
                                    <th>ClientPublicId</th>
                                    <th>DeliveryCalendarId</th>
                                    <th>Wydruk</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var label in Model.Labels)
                                {
                                    <tr>
                                        <td><code>@label.BagCode</code></td>
                                        <td>@label.ClientPublicId</td>
                                        <td>@(label.DeliveryCalendarId?.ToString() ?? "-")</td>
                                        <td>#@label.PrintNumber</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }

                <form asp-action="ReprintDeliveryLabels" asp-route-routeId="@Model.RouteId" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="date" value="@dateText" />
                    <div class="mb-3">
                        <label asp-for="ReprintReason" class="form-label">Powód redruku całej trasy</label>
                        <textarea asp-for="ReprintReason" class="form-control" rows="4" maxlength="250" required placeholder="Np. wydruk zbiorczy zaciął się, etykiety zamoczone, seria nieczytelna..."></textarea>
                        <span asp-validation-for="ReprintReason" class="text-danger small"></span>
                    </div>
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-danger" @(!Model.Labels.Any() ? "disabled" : null)>Wygeneruj redruk trasy</button>
                        <a asp-action="DeliveryLabels" asp-route-routeId="@Model.RouteId" asp-route-date="@dateText" class="btn btn-outline-secondary">Anuluj</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
    <div class="col-xl-5">
        <div class="card">
            <div class="card-body">
                <h4 class="mb-3">Zasada redruku</h4>
                <p class="small text-secondary mb-0">Redruk nie zmienia kodów toreb. Zmienia się tylko numer wydruku i snapshot audytowy, więc manifest wykryje zmianę, jeśli nie został jeszcze zatwierdzony.</p>
            </div>
        </div>
    </div>
</div>
