@model CreateVehicleRequest
@{
    Layout = "_LayoutStaff";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="card card-premium">
            <div class="card-header">
                <h3 class="card-title">Dane nowego pojazdu</h3>
            </div>
            <div class="card-body">
                <form asp-action="CreateVehicle" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger alert-premium-smart mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="RegistrationNumber" class="form-label required">Numer rejestracyjny</label>
                        <input type="text" asp-for="RegistrationNumber" class="form-control font-monospace text-uppercase" placeholder="np. WI 12345" required />
                        <span asp-validation-for="RegistrationNumber" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Model" class="form-label required">Model / Typ pojazdu</label>
                        <input type="text" asp-for="Model" class="form-control" placeholder="np. Fiat Ducato Maxi" required />
                        <span asp-validation-for="Model" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="MaxLoadKg" class="form-label required">Maksymalna ładowność (kg)</label>
                        <div class="input-group">
                            <input type="number" asp-for="MaxLoadKg" class="form-control" placeholder="np. 1200" min="1" step="0.01" required />
                            <span class="input-group-text">kg</span>
                        </div>
                        <span asp-validation-for="MaxLoadKg" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="form-footer d-flex align-items-center justify-content-between">
                        <a asp-action="Vehicles" class="btn btn-link text-secondary">
                            Anuluj i wróć
                        </a>
                        <button type="submit" class="btn btn-primary">
                            <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
                                <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                                <path d="M12 5l0 14" />
                                <path d="M5 12l14 0" />
                            </svg>
                            Zarejestruj pojazd
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
