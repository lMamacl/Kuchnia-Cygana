@model KuchniaUCygana.Application.DTOs.Orders.UpdateAddressRequest
@{
    ViewData["Title"] = "Edytuj adres";
}

<div class="row justify-content-center">
    <div class="col-md-7">
        <h2 class="mb-4">Edytuj adres</h2>

        <form asp-action="Edit" method="post">
            <input type="hidden" asp-for="Id" />
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>

            <div class="mb-3">
                <label asp-for="Label" class="form-label">Nazwa adresu</label>
                <input asp-for="Label" class="form-control" />
                <span asp-validation-for="Label" class="text-danger small"></span>
            </div>

            <div class="row">
                <div class="col-md-8 mb-3">
                    <label asp-for="Street" class="form-label">Ulica</label>
                    <input asp-for="Street" class="form-control" />
                    <span asp-validation-for="Street" class="text-danger small"></span>
                </div>
                <div class="col-md-2 mb-3">
                    <label asp-for="BuildingNumber" class="form-label">Nr budynku</label>
                    <input asp-for="BuildingNumber" class="form-control" />
                    <span asp-validation-for="BuildingNumber" class="text-danger small"></span>
                </div>
                <div class="col-md-2 mb-3">
                    <label asp-for="ApartmentNumber" class="form-label">Nr lokalu</label>
                    <input asp-for="ApartmentNumber" class="form-control" />
                </div>
            </div>

            <div class="row">
                <div class="col-md-4 mb-3">
                    <label asp-for="PostalCode" class="form-label">Kod pocztowy</label>
                    <input asp-for="PostalCode" class="form-control" />
                    <span asp-validation-for="PostalCode" class="text-danger small"></span>
                </div>
                <div class="col-md-8 mb-3">
                    <label asp-for="City" class="form-label">Miasto</label>
                    <input asp-for="City" class="form-control" />
                    <span asp-validation-for="City" class="text-danger small"></span>
                </div>
            </div>

            <div class="mb-4">
                <label asp-for="DeliveryNotes" class="form-label">Uwagi dla kuriera</label>
                <textarea asp-for="DeliveryNotes" class="form-control" rows="2"></textarea>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">Zapisz zmiany</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Anuluj</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}