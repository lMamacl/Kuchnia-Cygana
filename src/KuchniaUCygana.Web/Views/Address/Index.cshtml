@model IEnumerable<KuchniaUCygana.Application.DTOs.Orders.AddressDto>
@{
    ViewData["Title"] = "Moje adresy";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="mb-0">Moje adresy</h2>
    <a asp-action="Create" class="btn btn-primary">+ Dodaj adres</a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">
        Nie masz jeszcze żadnych adresów dostawy.
        <a asp-action="Create" class="alert-link">Dodaj pierwszy adres</a>.
    </div>
}
else
{
    <div class="row g-3">
        @foreach (var address in Model)
        {
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 @(address.IsDefault ? "border-primary border-2" : "")">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <h5 class="card-title mb-0">
                                <span class="me-1">📍</span> @address.Label
                            </h5>
                            @if (address.IsDefault)
                            {
                                <span class="badge bg-primary">Domyślny</span>
                            }
                        </div>

                        <p class="card-text mb-1">
                            @address.Street @address.BuildingNumber
                            @if (!string.IsNullOrEmpty(address.ApartmentNumber))
                            {
                                @("/" + address.ApartmentNumber)
                            }
                        </p>
                        <p class="card-text text-muted mb-0">
                            @address.PostalCode @address.City
                        </p>

                        @if (!string.IsNullOrEmpty(address.DeliveryNotes))
                        {
                            <p class="card-text small text-secondary mt-2 mb-0">
                                <em>ℹ️ @address.DeliveryNotes</em>
                            </p>
                        }
                    </div>

                    <div class="card-footer bg-transparent d-flex flex-wrap gap-2">
                        <a asp-action="Edit" asp-route-id="@address.Id"
                           class="btn btn-sm btn-outline-secondary">
                            Edytuj
                        </a>

                        @if (!address.IsDefault)
                        {
                            <form asp-action="SetDefault" asp-route-id="@address.Id" method="post">
                                <button type="submit" class="btn btn-sm btn-outline-primary">
                                    Ustaw domyślny
                                </button>
                            </form>

                            <form asp-action="Delete" asp-route-id="@address.Id" method="post"
                                  x-data="{}"
                                  x-on:submit.prevent="confirm('Czy na pewno chcesz usunąć adres @address.Label?') && $el.submit()">
                                <button type="submit" class="btn btn-sm btn-outline-danger">
                                    Usuń
                                </button>
                            </form>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}