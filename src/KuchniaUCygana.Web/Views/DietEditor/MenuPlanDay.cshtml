@model KuchniaUCygana.Application.DTOs.Menu.DietMenuDayDto
@using KuchniaUCygana.Application.DTOs.Menu
@{
    Layout = "_LayoutStaff";
    var diets = ViewBag.Diets as IEnumerable<DietDto> ?? Enumerable.Empty<DietDto>();
    var slots = ViewBag.Slots as IEnumerable<string> ?? new[] { "Breakfast", "Snack1", "Lunch", "Snack2", "Dinner" };
    var variants = diets.SelectMany(d => d.Variants.Select(v => new { Diet = d.Name, Variant = v })).ToList();
}

<div class="row row-cards">
    <div class="col-12">
        <div class="card card-premium">
            <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
                <div>
                    <h3 class="card-title">Dzien menu @Model.PlanDate.ToString("yyyy-MM-dd")</h3>
                    <div class="text-secondary small">@Model.Status</div>
                </div>
                <a asp-controller="DietMenuPlan" asp-action="Index" asp-route-startDate="@Model.PlanDate.ToString("yyyy-MM-dd")" class="btn btn-sm btn-outline-primary">Tydzien</a>
            </div>
            <div class="card-body">
                @if (Model.HasPlan)
                {
                    <div class="d-flex flex-wrap gap-2 align-items-center">
                        <span class="badge @(Model.Status == "Published" ? "bg-success-lt text-success" : "bg-blue-lt text-blue")">@Model.Status</span>
                        <span class="text-secondary">@Model.Items.Count pozycji</span>
                        @if (Model.PublishedAt.HasValue)
                        {
                            <span class="text-secondary">Opublikowano: @Model.PublishedAt.Value.ToString("yyyy-MM-dd HH:mm") przez @Model.PublishedBy</span>
                        }
                    </div>
                    @if (!Model.CanEdit && !string.IsNullOrWhiteSpace(Model.EditBlockReason))
                    {
                        <div class="alert alert-warning mt-3 mb-0">@Model.EditBlockReason</div>
                    }
                }
                else
                {
                    <form asp-controller="DietMenuPlan" asp-action="CreateDay" method="post" class="row g-3 align-items-end">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="PlanDate" value="@Model.PlanDate.ToString("yyyy-MM-dd")" />
                        <div class="col-md-8">
                            <label class="form-label">Notatka</label>
                            <input name="Notes" class="form-control" maxlength="500" />
                        </div>
                        <div class="col-md-4">
                            <button type="submit" class="btn btn-primary w-100">Utworz draft dnia</button>
                        </div>
                    </form>
                }
            </div>
        </div>
    </div>

    @if (Model.HasPlan)
    {
        <div class="col-lg-8">
            <div class="card card-premium">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h3 class="card-title">Pozycje planu</h3>
                    @if (Model.CanEdit)
                    {
                        <form asp-controller="DietMenuPlan" asp-action="Publish" asp-route-planId="@Model.Id" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="planDate" value="@Model.PlanDate.ToString("yyyy-MM-dd")" />
                            <button type="submit" class="btn btn-sm btn-success" disabled="@(!Model.Validation.CanPublish)">Publikuj</button>
                        </form>
                    }
                </div>
                <div class="table-responsive">
                    <table class="table table-vcenter card-table">
                        <thead>
                            <tr>
                                <th>Slot</th>
                                <th>Wariant</th>
                                <th>Posilek</th>
                                <th class="text-end">Gramatura</th>
                                <th class="text-center">Skladowe</th>
                                <th>Status</th>
                                <th class="w-1"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Items.Count == 0)
                            {
                                <tr><td colspan="7" class="text-center text-secondary py-4">Brak pozycji w dniu menu.</td></tr>
                            }
                            @foreach (var item in Model.Items.OrderBy(i => i.SortOrder).ThenBy(i => i.Id))
                            {
                                <tr>
                                    <td>
                                        <div class="fw-bold">@item.MealSlot</div>
                                        <div class="text-secondary small">#@item.SortOrder</div>
                                    </td>
                                    <td>
                                        <div>@item.DietName</div>
                                        <div class="text-secondary small">@item.VariantName</div>
                                    </td>
                                    <td>
                                        <div class="fw-bold">@item.MealName</div>
                                        <div class="text-secondary small">@item.MealStatus</div>
                                        <div class="d-flex flex-wrap gap-1 mt-1">
                                            <span class="badge @(item.UsesSpecialMealVariant ? "bg-purple-lt text-purple" : "bg-secondary-lt text-secondary")">
                                                @(item.MealVariantName ?? "wariant bazowy")
                                            </span>
                                            <span class="badge @(item.UsesServingMultiplier ? "bg-orange-lt text-orange" : "bg-secondary-lt text-secondary")">
                                                multiplier x @item.ServingSizeMultiplier.ToString("0.##")
                                            </span>
                                        </div>
                                    </td>
                                    <td class="text-end">
                                        @if (item.FinalWeightAfterMultiplierGrams.HasValue)
                                        {
                                            <div class="fw-bold">@item.FinalWeightAfterMultiplierGrams.Value.ToString("0.##") g</div>
                                            <div class="text-secondary small">baza @item.FinalWeightGrams?.ToString("0.##") g</div>
                                        }
                                        else
                                        {
                                            <span class="text-secondary">-</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <span class="badge bg-blue-lt">@item.ComponentCount</span>
                                        @if (item.LegacyRecipeCount > 0)
                                        {
                                            <span class="badge bg-secondary-lt">legacy @item.LegacyRecipeCount</span>
                                        }
                                    </td>
                                    <td>
                                        @if (item.ValidationWarnings.Count == 0)
                                        {
                                            <span class="badge bg-success-lt text-success">@item.CompletenessStatus</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning-lt text-warning">@item.CompletenessStatus / @item.ValidationWarnings.Count brakow</span>
                                            <div class="text-secondary small">@string.Join("; ", item.ValidationWarnings)</div>
                                        }
                                    </td>
                                    <td>
                                        @if (Model.CanEdit)
                                        {
                                            <form asp-controller="DietMenuPlan" asp-action="DeleteItem" asp-route-planId="@Model.Id" asp-route-itemId="@item.Id" method="post">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="planDate" value="@Model.PlanDate.ToString("yyyy-MM-dd")" />
                                                <button type="submit" class="btn btn-sm btn-outline-danger">Usun</button>
                                            </form>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            @if (Model.CanEdit)
            {
                <div class="card card-premium mt-3">
                    <div class="card-header">
                        <h3 class="card-title">Edycja pozycji</h3>
                    </div>
                    <div class="card-body">
                        @foreach (var item in Model.Items.OrderBy(i => i.SortOrder).ThenBy(i => i.Id))
                        {
                            <form asp-controller="DietMenuPlan" asp-action="UpdateItem" asp-route-planId="@Model.Id" asp-route-itemId="@item.Id" method="post" class="row g-2 align-items-end mb-3 menu-plan-item-form">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="planDate" value="@Model.PlanDate.ToString("yyyy-MM-dd")" />
                                <div class="col-md-3">
                                    <label class="form-label">Wariant</label>
                                    <select name="DietVariantId" class="form-select form-select-sm" required>
                                        @foreach (var variant in variants)
                                        {
                                            <option value="@variant.Variant.Id" selected="@(variant.Variant.Id == item.DietVariantId)">@variant.Diet / @variant.Variant.Name</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label">Slot</label>
                                    <select name="MealSlot" class="form-select form-select-sm" required>
                                        @foreach (var slot in slots)
                                        {
                                            <option value="@slot" selected="@(slot == item.MealSlot)">@slot</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label">Posilek</label>
                                    <div class="menu-plan-meal-lookup" data-selected-meal-id="@item.MealId" data-selected-meal-name="@item.MealName">
                                        <input type="hidden" name="MealId" class="js-meal-id" value="@item.MealId" />
                                        <input type="search" class="form-control form-control-sm js-meal-query" value="@item.MealName" autocomplete="off" />
                                        <div class="list-group mt-1 shadow-sm d-none js-meal-results"></div>
                                        <div class="small text-secondary mt-1 js-meal-status">@item.MealStatus</div>
                                    </div>
                                </div>
                                <div class="col-md-2">
                                    <label class="form-label">Wariant dania</label>
                                    <select name="MealVariantId" class="form-select form-select-sm js-meal-variant-select" data-selected-variant-id="@(item.MealVariantId?.ToString() ?? string.Empty)" disabled>
                                        <option value="">Ladowanie wariantow...</option>
                                    </select>
                                    <div class="small text-secondary mt-1 js-variant-status">@(item.MealVariantStatus ?? "wariant bazowy")</div>
                                </div>
                                <div class="col-md-1">
                                    <label class="form-label">x</label>
                                    <input name="ServingSizeMultiplier" type="number" step="0.01" min="0.01" value="@item.ServingSizeMultiplier" class="form-control form-control-sm" />
                                </div>
                                <div class="col-md-1">
                                    <label class="form-label">Lp.</label>
                                    <input name="SortOrder" type="number" value="@item.SortOrder" class="form-control form-control-sm" />
                                </div>
                                <div class="col-md-1">
                                    <button type="submit" class="btn btn-sm btn-outline-primary w-100">Zapisz</button>
                                </div>
                            </form>
                        }
                    </div>
                </div>
            }
        </div>

        <div class="col-lg-4">
            <div class="card card-premium">
                <div class="card-header">
                    <h3 class="card-title">Walidacja publikacji</h3>
                </div>
                <div class="card-body">
                    @if (Model.Validation.Warnings.Count == 0)
                    {
                        <span class="badge bg-success-lt text-success">Plan gotowy do publikacji</span>
                    }
                    else
                    {
                        <ul class="mb-0">
                            @foreach (var warning in Model.Validation.Warnings)
                            {
                                <li>@warning</li>
                            }
                        </ul>
                    }
                </div>
            </div>

            @if (Model.CanEdit)
            {
                <div class="card card-premium mt-3">
                    <div class="card-header">
                        <h3 class="card-title">Dodaj pozycje</h3>
                    </div>
                    <div class="card-body">
                        <form asp-controller="DietMenuPlan" asp-action="AddItem" asp-route-planId="@Model.Id" method="post" class="menu-plan-item-form">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="planDate" value="@Model.PlanDate.ToString("yyyy-MM-dd")" />
                            <div class="mb-3">
                                <label class="form-label">Wariant diety</label>
                                <select name="DietVariantId" class="form-select" required>
                                    <option value="">Wybierz wariant</option>
                                    @foreach (var variant in variants)
                                    {
                                        <option value="@variant.Variant.Id">@variant.Diet / @variant.Variant.Name</option>
                                    }
                                </select>
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Slot</label>
                                <select name="MealSlot" class="form-select" required>
                                    @foreach (var slot in slots)
                                    {
                                        <option value="@slot">@slot</option>
                                    }
                                </select>
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Posilek</label>
                                <div class="menu-plan-meal-lookup">
                                    <input type="hidden" name="MealId" class="js-meal-id" value="" />
                                    <input type="search" class="form-control js-meal-query" autocomplete="off" />
                                    <div class="list-group mt-1 shadow-sm d-none js-meal-results"></div>
                                    <div class="small text-secondary mt-1 js-meal-status">Wpisz nazwe dania.</div>
                                </div>
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Wariant dania</label>
                                <select name="MealVariantId" class="form-select js-meal-variant-select" data-selected-variant-id="" disabled>
                                    <option value="">Najpierw wybierz posilek</option>
                                </select>
                                <div class="small text-secondary mt-1 js-variant-status">Brak wybranego wariantu.</div>
                            </div>
                            <div class="row g-2">
                                <div class="col-6">
                                    <label class="form-label">Mnoznik</label>
                                    <input name="ServingSizeMultiplier" type="number" step="0.01" min="0.01" value="1" class="form-control" />
                                </div>
                                <div class="col-6">
                                    <label class="form-label">Kolejnosc</label>
                                    <input name="SortOrder" type="number" value="0" class="form-control" />
                                </div>
                            </div>
                            <button type="submit" class="btn btn-primary w-100 mt-3">Dodaj</button>
                        </form>
                    </div>
                </div>

                <div class="card card-premium mt-3">
                    <div class="card-header">
                        <h3 class="card-title">Kopiuj dzien</h3>
                    </div>
                    <div class="card-body">
                        <form asp-controller="DietMenuPlan" asp-action="CopyDay" asp-route-planId="@Model.Id" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="returnDate" value="@Model.PlanDate.ToString("yyyy-MM-dd")" />
                            <label class="form-label">Data docelowa</label>
                            <input type="date" name="TargetDate" class="form-control" required />
                            <button type="submit" class="btn btn-outline-primary w-100 mt-3">Kopiuj aktywne pozycje</button>
                        </form>
                    </div>
                </div>
            }
        </div>
    }
</div>

<script>
(function () {
    const mealsLookupUrl = '@Url.Content("~/diet-editor/menu-plan/lookups/meals")';
    const variantsLookupUrlTemplate = '@Url.Content("~/diet-editor/menu-plan/lookups/meals/__mealId__/variants")';

    const valueOf = function (item, camelName, pascalName) {
        return item[camelName] ?? item[pascalName];
    };

    const asArray = function (value) {
        return Array.isArray(value) ? value : [];
    };

    const debounce = function (callback, delay) {
        let timeoutId;
        return function () {
            window.clearTimeout(timeoutId);
            const args = arguments;
            timeoutId = window.setTimeout(function () {
                callback.apply(null, args);
            }, delay);
        };
    };

    const setVariantPlaceholder = function (variantSelect, text) {
        variantSelect.innerHTML = '';
        const option = document.createElement('option');
        option.value = '';
        option.textContent = text;
        variantSelect.appendChild(option);
    };

    const mealStatusText = function (meal) {
        const status = valueOf(meal, 'status', 'Status') || '';
        const completeness = valueOf(meal, 'completenessStatus', 'CompletenessStatus') || '';
        const variantCount = valueOf(meal, 'variantCount', 'VariantCount') ?? 0;
        const warningCount = valueOf(meal, 'warningCount', 'WarningCount') ?? 0;
        const parts = [status, completeness, `${variantCount} wariantow`].filter(Boolean);
        if (warningCount > 0) {
            parts.push(`${warningCount} brakow`);
        }

        return parts.join(' / ');
    };

    const variantStatusText = function (option) {
        const parts = [
            option.dataset.status,
            option.dataset.completeness,
        ].filter(Boolean);

        if (option.dataset.weight) {
            parts.push(`${option.dataset.weight} g`);
        }

        const warningCount = Number(option.dataset.warningCount || 0);
        if (warningCount > 0) {
            parts.push(`${warningCount} brakow`);
        }

        return parts.join(' / ') || 'Brak statusu wariantu.';
    };

    const updateVariantStatus = function (variantSelect, variantStatus) {
        const selected = variantSelect.selectedOptions[0];
        variantStatus.textContent = selected ? variantStatusText(selected) : 'Brak wybranego wariantu.';
    };

    const renderVariantOptions = function (variantSelect, variantStatus, variants, selectedVariantId) {
        variantSelect.innerHTML = '';

        if (variants.length === 0) {
            setVariantPlaceholder(variantSelect, 'Brak wariantow dla dania');
            variantSelect.disabled = true;
            variantStatus.textContent = 'Brak dostepnych wariantow.';
            return;
        }

        let selectedFound = false;
        variants.forEach(function (variant) {
            const id = valueOf(variant, 'mealVariantId', 'MealVariantId');
            const name = valueOf(variant, 'name', 'Name') || 'wariant';
            const status = valueOf(variant, 'status', 'Status') || '';
            const completeness = valueOf(variant, 'completenessStatus', 'CompletenessStatus') || '';
            const warningCount = valueOf(variant, 'warningCount', 'WarningCount') ?? 0;
            const finalWeight = valueOf(variant, 'finalWeightGrams', 'FinalWeightGrams');
            const option = document.createElement('option');
            option.value = id == null ? '' : id.toString();
            option.textContent = `${name} (${status})`;
            option.dataset.status = status;
            option.dataset.completeness = completeness;
            option.dataset.warningCount = warningCount.toString();
            if (finalWeight != null) {
                option.dataset.weight = Number(finalWeight).toFixed(2);
            }

            if (option.value === selectedVariantId) {
                option.selected = true;
                selectedFound = true;
            }

            variantSelect.appendChild(option);
        });

        if (selectedVariantId && !selectedFound) {
            const option = document.createElement('option');
            option.value = selectedVariantId;
            option.textContent = 'aktualny wariant niedostepny';
            option.dataset.status = 'Unavailable';
            option.dataset.completeness = 'Incomplete';
            option.dataset.warningCount = '1';
            option.selected = true;
            variantSelect.appendChild(option);
        }

        if (!selectedVariantId) {
            variantSelect.value = '';
        }

        variantSelect.disabled = false;
        updateVariantStatus(variantSelect, variantStatus);
    };

    const renderMealResults = function (resultsBox, meals, onSelect) {
        resultsBox.innerHTML = '';
        resultsBox.classList.remove('d-none');

        if (meals.length === 0) {
            const empty = document.createElement('div');
            empty.className = 'list-group-item text-secondary small';
            empty.textContent = 'Brak wynikow.';
            resultsBox.appendChild(empty);
            return;
        }

        meals.forEach(function (meal) {
            const mealId = valueOf(meal, 'mealId', 'MealId');
            const mealName = valueOf(meal, 'mealName', 'MealName') || '';
            const categoryName = valueOf(meal, 'categoryName', 'CategoryName') || 'bez kategorii';
            const status = valueOf(meal, 'status', 'Status') || '';
            const completeness = valueOf(meal, 'completenessStatus', 'CompletenessStatus') || '';
            const warningCount = valueOf(meal, 'warningCount', 'WarningCount') ?? 0;
            const item = document.createElement('button');
            item.type = 'button';
            item.className = 'list-group-item list-group-item-action py-2';

            const title = document.createElement('div');
            title.className = 'fw-bold';
            title.textContent = mealName;

            const meta = document.createElement('div');
            meta.className = 'small text-secondary';
            meta.textContent = `${categoryName} / ${status} / ${completeness}`;

            const badge = document.createElement('span');
            badge.className = warningCount > 0
                ? 'badge bg-warning-lt text-warning mt-1'
                : 'badge bg-success-lt text-success mt-1';
            badge.textContent = warningCount > 0 ? `${warningCount} brakow` : 'gotowe';

            item.appendChild(title);
            item.appendChild(meta);
            item.appendChild(badge);
            item.addEventListener('click', function () {
                onSelect(mealId, mealName, meal);
            });

            resultsBox.appendChild(item);
        });
    };

    const loadVariants = async function (mealId, variantSelect, variantStatus, selectedVariantId) {
        variantSelect.disabled = true;
        setVariantPlaceholder(variantSelect, 'Ladowanie wariantow...');
        variantStatus.textContent = 'Ladowanie statusu wariantow...';

        try {
            const response = await fetch(variantsLookupUrlTemplate.replace('__mealId__', encodeURIComponent(mealId)), {
                headers: { 'Accept': 'application/json' },
            });
            if (!response.ok) {
                throw new Error('Lookup wariantow zwrocil blad.');
            }

            const variants = asArray(await response.json());
            renderVariantOptions(variantSelect, variantStatus, variants, selectedVariantId || '');
        } catch {
            setVariantPlaceholder(variantSelect, 'Nie udalo sie pobrac wariantow');
            variantSelect.disabled = true;
            variantStatus.textContent = 'Blad pobierania wariantow.';
        }
    };

    document.querySelectorAll('.menu-plan-item-form').forEach(function (form) {
        const lookup = form.querySelector('.menu-plan-meal-lookup');
        const mealIdInput = form.querySelector('.js-meal-id');
        const mealQuery = form.querySelector('.js-meal-query');
        const resultsBox = form.querySelector('.js-meal-results');
        const mealStatus = form.querySelector('.js-meal-status');
        const variantSelect = form.querySelector('.js-meal-variant-select');
        const variantStatus = form.querySelector('.js-variant-status');
        if (!lookup || !mealIdInput || !mealQuery || !resultsBox || !variantSelect || !variantStatus) {
            return;
        }

        const searchMeals = debounce(async function () {
            const query = mealQuery.value.trim();
            if (query.length < 2) {
                resultsBox.classList.add('d-none');
                mealStatus.textContent = mealIdInput.value ? mealStatus.textContent : 'Wpisz minimum 2 znaki.';
                return;
            }

            try {
                const response = await fetch(`${mealsLookupUrl}?query=${encodeURIComponent(query)}`, {
                    headers: { 'Accept': 'application/json' },
                });
                if (!response.ok) {
                    throw new Error('Lookup dan zwrocil blad.');
                }

                const meals = asArray(await response.json());
                renderMealResults(resultsBox, meals, function (mealId, mealName, meal) {
                    mealIdInput.value = mealId;
                    mealQuery.value = mealName;
                    resultsBox.classList.add('d-none');
                    mealStatus.textContent = mealStatusText(meal);
                    variantSelect.dataset.selectedVariantId = '';
                    loadVariants(mealId, variantSelect, variantStatus, '');
                });
            } catch {
                resultsBox.classList.add('d-none');
                mealStatus.textContent = 'Blad pobierania dan.';
            }
        }, 250);

        mealQuery.addEventListener('input', function () {
            mealIdInput.value = '';
            variantSelect.dataset.selectedVariantId = '';
            variantSelect.disabled = true;
            setVariantPlaceholder(variantSelect, 'Najpierw wybierz posilek');
            variantStatus.textContent = 'Brak wybranego wariantu.';
            searchMeals();
        });

        mealQuery.addEventListener('focus', function () {
            if (!mealIdInput.value) {
                searchMeals();
            }
        });

        variantSelect.addEventListener('change', function () {
            updateVariantStatus(variantSelect, variantStatus);
        });

        form.addEventListener('submit', function (event) {
            if (!mealIdInput.value) {
                event.preventDefault();
                mealStatus.textContent = 'Wybierz danie z listy wynikow.';
                mealQuery.focus();
                return;
            }

            if (variantSelect.disabled) {
                event.preventDefault();
                variantStatus.textContent = 'Poczekaj na zaladowanie wariantow.';
            }
        });

        document.addEventListener('click', function (event) {
            if (!lookup.contains(event.target)) {
                resultsBox.classList.add('d-none');
            }
        });

        if (mealIdInput.value) {
            loadVariants(
                mealIdInput.value,
                variantSelect,
                variantStatus,
                variantSelect.dataset.selectedVariantId || '');
        }
    });
})();
</script>
