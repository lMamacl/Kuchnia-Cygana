@model IEnumerable<KuchniaUCygana.Domain.Entities.Menu.Diet>
@{
    Layout = "_LayoutStaff";
    ViewData["Title"] = "Katalog Diet";
    ViewData["Section"] = "Katalog Menu";
    ViewData["Description"] = "Zarz¹dzanie programami dietetycznymi (np. Slim, Keto, Bulking) dostêpnymi dla klientów.";
}

<div class="row row-cards">
    <div class="col-12">
        <div class="card card-premium">
            <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
                <h3 class="card-title">Programy Dietetyczne</h3>
                <div class="btn-list">
                    <a asp-action="Create" class="btn btn-primary">
                        <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none"><path stroke="none" d="M0 0h24v24H0z" fill="none" /><path d="M12 5l0 14" /><path d="M5 12l14 0" /></svg>
                        Nowa Dieta
                    </a>
                </div>
            </div>

            <div class="table-responsive">
                <table class="table table-vcenter card-table table-premium">
                    <thead>
                        <tr>
                            <th class="w-1">Skrót</th>
                            <th>Nazwa planu</th>
                            <th>Status</th>
                            <th class="w-1 text-end">Akcje</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr><td colspan="4" class="text-secondary text-center py-4">Brak zdefiniowanych programów dietetycznych.</td></tr>
                        }
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td><span class="badge bg-purple-lt text-purple font-weight-bold">@item.Id</span></td>
                                <td>
                                    <div class="font-weight-bold text-dark">@item.Name</div>
                                    <div class="text-secondary small">@item.Description</div>
                                </td>
                                <td>
                                    @if (item.IsActive)
                                    {
                                        <span class="badge bg-success-lt text-success">Aktywna w ofercie</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-lt text-secondary">Wstrzymana</span>
                                    }
                                </td>
                                <td>
                                    <div class="btn-list flex-nowrap justify-content-end">
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning">Modyfikuj</a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>