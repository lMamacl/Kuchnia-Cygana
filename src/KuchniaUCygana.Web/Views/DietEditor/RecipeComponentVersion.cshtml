@model KuchniaUCygana.Application.DTOs.Menu.RecipeComponentVersionDetailDto
@{
    Layout = "_LayoutStaff";
    var ingredients = ViewBag.Ingredients as IEnumerable<KuchniaUCygana.Application.DTOs.Menu.IngredientDto>
        ?? Enumerable.Empty<KuchniaUCygana.Application.DTOs.Menu.IngredientDto>();
    var categories = ViewBag.WarehouseCategories as IEnumerable<KuchniaUCygana.Application.DTOs.Warehouse.WarehouseCategoryDto>
        ?? Enumerable.Empty<KuchniaUCygana.Application.DTOs.Warehouse.WarehouseCategoryDto>();
}

<div class="row row-cards">
    <div class="col-12">
        <div class="card card-premium">
            <div class="card-body">
                <div class="d-flex justify-content-between gap-3 flex-wrap">
                    <div>
                        <div class="text-uppercase text-secondary small fw-bold">@Model.ComponentName</div>
                        <h2 class="mb-1">Wersja v@Model.VersionNumber</h2>
                        <div class="d-flex gap-2 flex-wrap">
                            <span class="badge bg-blue-lt">@Model.Status</span>
                            @if (Model.IsComplete)
                            {
                                <span class="badge bg-green-lt">Kompletna</span>
                            }
                            else
                            {
                                <span class="badge bg-orange-lt">Braki</span>
                            }
                        </div>
                    </div>
                    <div class="btn-list">
                        <a asp-controller="RecipeComponents" asp-action="Details" asp-route-id="@Model.RecipeComponentId" class="btn btn-outline-secondary">Skladowa</a>
                        @if (Model.Status == "Draft")
                        {
                            <form asp-controller="RecipeComponents" asp-action="PublishVersion" asp-route-componentId="@Model.RecipeComponentId" asp-route-versionId="@Model.Id" method="post">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-success">Publikuj</button>
                            </form>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    @if (Model.ValidationWarnings.Count > 0)
    {
        <div class="col-12">
            <div class="alert alert-warning">
                <div class="fw-bold mb-1">Braki blokujace publikacje</div>
                <ul class="mb-0">
                    @foreach (var warning in Model.ValidationWarnings)
                    {
                        <li>@warning</li>
                    }
                </ul>
            </div>
        </div>
    }

    <div class="col-12">
        <div class="card card-premium">
            <div class="card-header">
                <h3 class="card-title">Parametry wersji</h3>
            </div>
            <div class="card-body">
                <form asp-controller="RecipeComponents" asp-action="UpdateVersion" asp-route-componentId="@Model.RecipeComponentId" asp-route-versionId="@Model.Id" method="post" class="row g-3">
                    @Html.AntiForgeryToken()
                    <div class="col-12">
                        <label class="form-label">Instrukcje</label>
                        <textarea name="Instructions" class="form-control" rows="5">@Model.Instructions</textarea>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Yield</label>
                        <input name="YieldQuantity" type="number" step="0.001" min="0" value="@Model.YieldQuantity" class="form-control" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Jednostka yield</label>
                        <input name="YieldUnit" value="@Model.YieldUnit" class="form-control" maxlength="40" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Raw weight g</label>
                        <input name="RawWeightGrams" type="number" step="0.01" value="@Model.RawWeightGrams" class="form-control" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Cooked weight g</label>
                        <input name="CookedWeightGrams" type="number" step="0.01" value="@Model.CookedWeightGrams" class="form-control" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Kcal / 100 g</label>
                        <input name="CaloriesPer100g" type="number" step="0.01" value="@Model.CaloriesPer100g" class="form-control" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Bialko / 100 g</label>
                        <input name="ProteinPer100g" type="number" step="0.01" value="@Model.ProteinPer100g" class="form-control" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Wegle / 100 g</label>
                        <input name="CarbohydratesPer100g" type="number" step="0.01" value="@Model.CarbohydratesPer100g" class="form-control" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Tluszcz / 100 g</label>
                        <input name="FatPer100g" type="number" step="0.01" value="@Model.FatPer100g" class="form-control" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Blonnik / 100 g</label>
                        <input name="FiberPer100g" type="number" step="0.01" value="@Model.FiberPer100g" class="form-control" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Shelf-life h</label>
                        <input name="ShelfLifeHours" type="number" min="0" value="@Model.ShelfLifeHours" class="form-control" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-check mt-4">
                            <input name="UseEarliestIngredientExpiry" type="checkbox" value="true" class="form-check-input" @(Model.UseEarliestIngredientExpiry ? "checked" : "") />
                            <input name="UseEarliestIngredientExpiry" type="hidden" value="false" />
                            <span class="form-check-label">Najwczesniejszy surowiec</span>
                        </label>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Opis zmiany</label>
                        <input name="ChangeSummary" value="@Model.ChangeSummary" class="form-control" maxlength="500" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-check mt-4">
                            <input name="IsTechnologyChange" type="checkbox" value="true" class="form-check-input" @(Model.IsTechnologyChange ? "checked" : "") />
                            <input name="IsTechnologyChange" type="hidden" value="false" />
                            <span class="form-check-label">Zmiana technologiczna</span>
                        </label>
                    </div>
                    <div class="col-md-5">
                        <label class="form-label">Powod zmiany nietechnologicznej</label>
                        <input name="NonTechnologyChangeReason" value="@Model.NonTechnologyChangeReason" class="form-control" maxlength="500" />
                    </div>
                    <div class="col-12">
                        <button type="submit" class="btn btn-primary">Zapisz wersje</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="col-lg-7">
        <div class="card card-premium">
            <div class="card-header">
                <h3 class="card-title">Skladniki</h3>
            </div>
            <div class="table-responsive">
                <table class="table table-vcenter card-table">
                    <thead>
                        <tr>
                            <th>Skladnik</th>
                            <th>g</th>
                            <th>Kategoria</th>
                            <th class="w-1"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var ingredient in Model.Ingredients)
                        {
                            <tr>
                                <td>
                                    <div class="fw-bold">@ingredient.IngredientName</div>
                                    @if (ingredient.IsOptional)
                                    {
                                        <span class="badge bg-secondary-lt">Opcjonalny</span>
                                    }
                                </td>
                                <td>@ingredient.WeightInGrams</td>
                                <td>@ingredient.WarehouseCategoryName</td>
                                <td>
                                    @if (Model.Status == "Draft")
                                    {
                                        <form asp-controller="RecipeComponents" asp-action="DeleteIngredient" asp-route-componentId="@Model.RecipeComponentId" asp-route-versionId="@Model.Id" asp-route-ingredientRowId="@ingredient.Id" method="post">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-danger">Usun</button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            @if (Model.Status == "Draft")
            {
                <div class="card-body border-top">
                    <form asp-controller="RecipeComponents" asp-action="SaveIngredient" asp-route-componentId="@Model.RecipeComponentId" asp-route-versionId="@Model.Id" method="post" class="row g-2">
                        @Html.AntiForgeryToken()
                        <div class="col-md-4">
                            <select name="IngredientId" class="form-select" required>
                                <option value="">Skladnik</option>
                                @foreach (var ingredient in ingredients)
                                {
                                    <option value="@ingredient.Id">@ingredient.Name</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-2">
                            <input name="WeightInGrams" type="number" step="0.01" min="0" class="form-control" placeholder="g" required />
                        </div>
                        <div class="col-md-2">
                            <input name="YieldFactor" type="number" step="0.0001" min="0" value="1" class="form-control" />
                        </div>
                        <div class="col-md-3">
                            <select name="WarehouseCategoryId" class="form-select" required>
                                <option value="">Kategoria</option>
                                @foreach (var category in categories)
                                {
                                    <option value="@category.Id">@category.Name</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-1">
                            <button type="submit" class="btn btn-primary w-100">+</button>
                        </div>
                    </form>
                </div>
            }
        </div>
    </div>

    <div class="col-lg-5">
        <div class="card card-premium">
            <div class="card-header">
                <h3 class="card-title">Opakowania</h3>
            </div>
            <div class="table-responsive">
                <table class="table table-vcenter card-table">
                    <thead>
                        <tr>
                            <th>Nazwa</th>
                            <th>Ilosc</th>
                            <th class="w-1"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var packaging in Model.PackagingRequirements)
                        {
                            <tr>
                                <td>
                                    <div class="fw-bold">@packaging.ResourceName</div>
                                    <div class="text-secondary small">@packaging.ContainerRole</div>
                                </td>
                                <td>@packaging.Quantity @packaging.Unit</td>
                                <td>
                                    @if (Model.Status == "Draft")
                                    {
                                        <form asp-controller="RecipeComponents" asp-action="DeletePackaging" asp-route-componentId="@Model.RecipeComponentId" asp-route-versionId="@Model.Id" asp-route-packagingId="@packaging.Id" method="post">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-danger">Usun</button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            @if (Model.Status == "Draft")
            {
                <div class="card-body border-top">
                    <form asp-controller="RecipeComponents" asp-action="SavePackaging" asp-route-componentId="@Model.RecipeComponentId" asp-route-versionId="@Model.Id" method="post" class="row g-2">
                        @Html.AntiForgeryToken()
                        <div class="col-md-5">
                            <input name="ResourceName" class="form-control" placeholder="Nazwa" required maxlength="200" />
                        </div>
                        <div class="col-md-3">
                            <input name="Quantity" type="number" step="0.001" min="0" value="1" class="form-control" />
                        </div>
                        <div class="col-md-4">
                            <select name="WarehouseCategoryId" class="form-select">
                                <option value="">Kategoria</option>
                                @foreach (var category in categories)
                                {
                                    <option value="@category.Id">@category.Name</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-4">
                            <input name="Unit" value="pcs" class="form-control" maxlength="20" />
                        </div>
                        <div class="col-md-5">
                            <input name="ContainerRole" class="form-control" placeholder="Rola pojemnika" maxlength="80" />
                        </div>
                        <div class="col-md-3">
                            <button type="submit" class="btn btn-primary w-100">Dodaj</button>
                        </div>
                    </form>
                </div>
            }
        </div>
    </div>
</div>
