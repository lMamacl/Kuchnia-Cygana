@model KuchniaUCygana.Application.DTOs.Menu.RecipeComponentVersionDetailDto
@{
    Layout = "_LayoutStaff";
    var comparison = Model.Comparison;
}

<div class="row row-cards">
    <div class="col-12">
        <div class="card card-premium">
            <div class="card-body">
                <div class="d-flex justify-content-between gap-3 flex-wrap">
                    <div>
                        <div class="text-uppercase text-secondary small fw-bold">@Model.ComponentName</div>
                        <h2 class="mb-1">Wersja v@Model.VersionNumber</h2>
                        <div class="d-flex gap-2 flex-wrap">
                            <span class="badge bg-blue-lt">@Model.Status</span>
                            @if (Model.IsComplete)
                            {
                                <span class="badge bg-green-lt">Kompletna</span>
                            }
                            else
                            {
                                <span class="badge bg-orange-lt">Braki</span>
                            }
                        </div>
                    </div>
                    <div class="btn-list">
                        <a asp-controller="RecipeComponents" asp-action="Details" asp-route-id="@Model.RecipeComponentId" class="btn btn-outline-secondary">Skladowa</a>
                        @if (Model.Status == "Draft")
                        {
                            <form asp-controller="RecipeComponents" asp-action="PublishVersion" asp-route-componentId="@Model.RecipeComponentId" asp-route-versionId="@Model.Id" method="post">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-success">Publikuj</button>
                            </form>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    @if (Model.ValidationWarnings.Count > 0)
    {
        <div class="col-12">
            <div class="alert alert-warning">
                <div class="fw-bold mb-1">Braki blokujace publikacje</div>
                <ul class="mb-0">
                    @foreach (var warning in Model.ValidationWarnings)
                    {
                        <li>@warning</li>
                    }
                </ul>
            </div>
        </div>
    }

    <div class="col-12">
        <div class="card card-premium">
            <div class="card-header">
                <h3 class="card-title">Porownanie wersji</h3>
            </div>
            <div class="card-body">
                <div class="row g-3 mb-3">
                    <div class="col-md-2">
                        <div class="text-secondary small">Suma skladnikow net</div>
                        <strong>@comparison.IngredientWeightGrams.ToString("0.##") g</strong>
                    </div>
                    <div class="col-md-2">
                        <div class="text-secondary small">Suma skladnikow gross</div>
                        <strong>@comparison.IngredientGrossWeightGrams.ToString("0.##") g</strong>
                    </div>
                    <div class="col-md-2">
                        <div class="text-secondary small">Raw</div>
                        <strong>@(Model.RawWeightGrams?.ToString("0.##") ?? "-") g</strong>
                    </div>
                    <div class="col-md-2">
                        <div class="text-secondary small">Cooked</div>
                        <strong>@(Model.CookedWeightGrams?.ToString("0.##") ?? "-") g</strong>
                    </div>
                    <div class="col-md-2">
                        <div class="text-secondary small">Yield</div>
                        <strong>@comparison.YieldQuantity.ToString("0.###") @comparison.YieldUnit</strong>
                    </div>
                    <div class="col-md-2">
                        <div class="text-secondary small">Reference</div>
                        <strong>@(comparison.ReferenceWeightGrams?.ToString("0.##") ?? "-") g (@comparison.ReferenceWeightSource)</strong>
                    </div>
                </div>
                <div class="table-responsive">
                    <table class="table table-vcenter">
                        <thead>
                            <tr>
                                <th>Nutrition / 100 g</th>
                                <th>Kcal</th>
                                <th>Bialko</th>
                                <th>Wegle</th>
                                <th>Tluszcz</th>
                                <th>Blonnik</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>Wpisane recznie</td>
                                <td>@(comparison.ManualNutritionPer100g.CaloriesPer100g?.ToString("0.##") ?? "-")</td>
                                <td>@(comparison.ManualNutritionPer100g.ProteinPer100g?.ToString("0.##") ?? "-")</td>
                                <td>@(comparison.ManualNutritionPer100g.CarbohydratesPer100g?.ToString("0.##") ?? "-")</td>
                                <td>@(comparison.ManualNutritionPer100g.FatPer100g?.ToString("0.##") ?? "-")</td>
                                <td>@(comparison.ManualNutritionPer100g.FiberPer100g?.ToString("0.##") ?? "-")</td>
                            </tr>
                            <tr>
                                <td>Wyliczone ze skladnikow</td>
                                <td>@(comparison.CalculatedNutritionPer100g?.CaloriesPer100g?.ToString("0.##") ?? "-")</td>
                                <td>@(comparison.CalculatedNutritionPer100g?.ProteinPer100g?.ToString("0.##") ?? "-")</td>
                                <td>@(comparison.CalculatedNutritionPer100g?.CarbohydratesPer100g?.ToString("0.##") ?? "-")</td>
                                <td>@(comparison.CalculatedNutritionPer100g?.FatPer100g?.ToString("0.##") ?? "-")</td>
                                <td>@(comparison.CalculatedNutritionPer100g?.FiberPer100g?.ToString("0.##") ?? "-")</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                @if (comparison.MissingNutritionIngredientCount > 0)
                {
                    <div class="alert alert-warning mb-0">
                        @comparison.MissingNutritionIngredientCount skladnikow nie ma pelnego nutrition, dlatego wyliczenie moze byc niedostepne.
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="col-12">
        <div class="card card-premium">
            <div class="card-header">
                <h3 class="card-title">Parametry wersji</h3>
            </div>
            <div class="card-body">
                <form asp-controller="RecipeComponents" asp-action="UpdateVersion" asp-route-componentId="@Model.RecipeComponentId" asp-route-versionId="@Model.Id" method="post" class="row g-3">
                    @Html.AntiForgeryToken()
                    <div class="col-12">
                        <label class="form-label">Instrukcje</label>
                        <textarea name="Instructions" class="form-control" rows="5">@Model.Instructions</textarea>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Yield</label>
                        <input name="YieldQuantity" type="number" step="0.001" min="0" value="@Model.YieldQuantity" class="form-control" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Jednostka yield</label>
                        <input name="YieldUnit" value="@Model.YieldUnit" class="form-control" maxlength="40" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Raw weight g</label>
                        <input name="RawWeightGrams" type="number" step="0.01" value="@Model.RawWeightGrams" class="form-control" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Cooked weight g</label>
                        <input name="CookedWeightGrams" type="number" step="0.01" value="@Model.CookedWeightGrams" class="form-control" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Kcal / 100 g</label>
                        <input name="CaloriesPer100g" type="number" step="0.01" value="@Model.CaloriesPer100g" class="form-control" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Bialko / 100 g</label>
                        <input name="ProteinPer100g" type="number" step="0.01" value="@Model.ProteinPer100g" class="form-control" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Wegle / 100 g</label>
                        <input name="CarbohydratesPer100g" type="number" step="0.01" value="@Model.CarbohydratesPer100g" class="form-control" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Tluszcz / 100 g</label>
                        <input name="FatPer100g" type="number" step="0.01" value="@Model.FatPer100g" class="form-control" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Blonnik / 100 g</label>
                        <input name="FiberPer100g" type="number" step="0.01" value="@Model.FiberPer100g" class="form-control" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Shelf-life h</label>
                        <input name="ShelfLifeHours" type="number" min="0" value="@Model.ShelfLifeHours" class="form-control" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-check mt-4">
                            <input name="UseEarliestIngredientExpiry" type="checkbox" value="true" class="form-check-input" @(Model.UseEarliestIngredientExpiry ? "checked" : "") />
                            <input name="UseEarliestIngredientExpiry" type="hidden" value="false" />
                            <span class="form-check-label">Najwczesniejszy surowiec</span>
                        </label>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Zrodlo nutrition</label>
                        <select name="NutritionSource" class="form-select">
                            <option value="Manual" selected="@(Model.NutritionSource == "Manual")">Manual</option>
                            <option value="Aggregated" selected="@(Model.NutritionSource == "Aggregated")">Agregowane</option>
                            <option value="Override" selected="@(Model.NutritionSource == "Override")">Override</option>
                        </select>
                    </div>
                    <div class="col-md-5">
                        <label class="form-label">Powod override nutrition</label>
                        <input name="NutritionOverrideReason" value="@Model.NutritionOverrideReason" class="form-control" maxlength="500" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-check mt-4">
                            <input name="AllergensApproved" type="checkbox" value="true" class="form-check-input" @(Model.AllergensApproved ? "checked" : "") />
                            <input name="AllergensApproved" type="hidden" value="false" />
                            <span class="form-check-label">Alergeny zatwierdzone</span>
                        </label>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Zrodlo zatwierdzenia alergenow</label>
                        <select name="AllergenApprovalSource" class="form-select">
                            <option value="DerivedFromIngredients" selected="@(Model.AllergenApprovalSource == "DerivedFromIngredients")">Ze skladnikow</option>
                            <option value="Override" selected="@(Model.AllergenApprovalSource == "Override")">Override</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Powod zatwierdzenia/override alergenow</label>
                        <input name="AllergenOverrideReason" value="@Model.AllergenOverrideReason" class="form-control" maxlength="500" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Opis zmiany</label>
                        <input name="ChangeSummary" value="@Model.ChangeSummary" class="form-control" maxlength="500" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-check mt-4">
                            <input name="IsTechnologyChange" type="checkbox" value="true" class="form-check-input" @(Model.IsTechnologyChange ? "checked" : "") />
                            <input name="IsTechnologyChange" type="hidden" value="false" />
                            <span class="form-check-label">Zmiana technologiczna</span>
                        </label>
                    </div>
                    <div class="col-md-5">
                        <label class="form-label">Powod zmiany nietechnologicznej</label>
                        <input name="NonTechnologyChangeReason" value="@Model.NonTechnologyChangeReason" class="form-control" maxlength="500" />
                    </div>
                    <div class="col-12">
                        <button type="submit" class="btn btn-primary">Zapisz wersje</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="col-lg-7">
        <div class="card card-premium">
            <div class="card-header">
                <h3 class="card-title">Skladniki</h3>
            </div>
            <div class="table-responsive">
                <table class="table table-vcenter card-table">
                    <thead>
                        <tr>
                            <th>Skladnik</th>
                            <th>g</th>
                            <th>Kategoria</th>
                            <th class="w-1"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var ingredient in Model.Ingredients)
                        {
                            <tr>
                                <td>
                                    <div class="fw-bold">@ingredient.IngredientName</div>
                                    @if (ingredient.IsOptional)
                                    {
                                        <span class="badge bg-secondary-lt">Opcjonalny</span>
                                    }
                                </td>
                                <td>@ingredient.WeightInGrams</td>
                                <td>@ingredient.WarehouseCategoryName</td>
                                <td>
                                    @if (Model.Status == "Draft")
                                    {
                                        <form asp-controller="RecipeComponents" asp-action="DeleteIngredient" asp-route-componentId="@Model.RecipeComponentId" asp-route-versionId="@Model.Id" asp-route-ingredientRowId="@ingredient.Id" method="post">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-danger">Usun</button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            @if (Model.Status == "Draft")
            {
                <div class="card-body border-top">
                    <form asp-controller="RecipeComponents" asp-action="SaveIngredient" asp-route-componentId="@Model.RecipeComponentId" asp-route-versionId="@Model.Id" method="post" class="row g-2">
                        @Html.AntiForgeryToken()
                        <input id="componentIngredientStockItemId" type="hidden" name="StockItemId" />
                        <div class="col-md-4">
                            <input id="componentIngredientSearch" type="search" class="form-control mb-1" placeholder="Szukaj skladnika" autocomplete="off" />
                            <select id="componentIngredientSelect" name="IngredientId" class="form-select" required data-placeholder="Skladnik">
                                <option value="">Skladnik</option>
                            </select>
                        </div>
                        <div class="col-md-2">
                            <input name="WeightInGrams" type="number" step="0.01" min="0" class="form-control" placeholder="g" required />
                        </div>
                        <div class="col-md-2">
                            <input name="YieldFactor" type="number" step="0.0001" min="0" value="1" class="form-control" />
                        </div>
                        <div class="col-md-3">
                            <input id="componentIngredientCategorySearch" type="search" class="form-control mb-1" placeholder="Szukaj kategorii" autocomplete="off" />
                            <select id="componentIngredientCategory" name="WarehouseCategoryId" class="form-select" required data-placeholder="Kategoria">
                                <option value="">Kategoria</option>
                            </select>
                        </div>
                        <div class="col-md-1">
                            <button type="submit" class="btn btn-primary w-100">+</button>
                        </div>
                    </form>
                </div>
            }
        </div>
    </div>

    <div class="col-12">
        <div class="card card-premium">
            <div class="card-header">
                <h3 class="card-title">Instrukcja przygotowania</h3>
            </div>
            <div class="card-body">
                @if (!Model.InstructionSections.Any())
                {
                    <div class="alert alert-warning mb-3">Brak sekcji i krokow instrukcji.</div>
                }
                @foreach (var instructionSection in Model.InstructionSections.OrderBy(s => s.SortOrder).ThenBy(s => s.Id))
                {
                    <div class="border rounded p-3 mb-3">
                        <div class="d-flex justify-content-between gap-2 flex-wrap mb-2">
                            <div>
                                <div class="fw-bold">@(instructionSection.Title ?? $"Sekcja {instructionSection.SortOrder}")</div>
                                <div class="text-secondary small">@instructionSection.Steps.Count krokow</div>
                            </div>
                            @if (Model.Status == "Draft")
                            {
                                <form asp-controller="RecipeComponents" asp-action="DeleteInstructionSection" asp-route-componentId="@Model.RecipeComponentId" asp-route-versionId="@Model.Id" asp-route-sectionId="@instructionSection.Id" method="post">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Usun sekcje</button>
                                </form>
                            }
                        </div>
                        <ol class="mb-3">
                            @foreach (var step in instructionSection.Steps.OrderBy(s => s.SortOrder).ThenBy(s => s.Id))
                            {
                                <li class="mb-2">
                                    <div>@step.StepText</div>
                                    @if (step.RequiresControl)
                                    {
                                        <span class="badge bg-orange-lt">Kontrola: @(step.ControlType ?? "wymagana") @step.ExpectedValue @step.ExpectedUnit</span>
                                    }
                                    @if (step.IsCritical)
                                    {
                                        <span class="badge bg-red-lt">Krytyczne</span>
                                    }
                                    @if (Model.Status == "Draft")
                                    {
                                        <form asp-controller="RecipeComponents" asp-action="DeleteInstructionStep" asp-route-componentId="@Model.RecipeComponentId" asp-route-versionId="@Model.Id" asp-route-stepId="@step.Id" method="post" class="d-inline ms-2">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-danger">Usun</button>
                                        </form>
                                    }
                                </li>
                            }
                        </ol>
                        @if (Model.Status == "Draft")
                        {
                            <form asp-controller="RecipeComponents" asp-action="SaveInstructionStep" asp-route-componentId="@Model.RecipeComponentId" asp-route-versionId="@Model.Id" asp-route-sectionId="@instructionSection.Id" method="post" class="row g-2 align-items-end">
                                @Html.AntiForgeryToken()
                                <div class="col-md-5">
                                    <label class="form-label">Krok</label>
                                    <input name="StepText" class="form-control" required />
                                </div>
                                <div class="col-md-1">
                                    <label class="form-label">Lp.</label>
                                    <input name="SortOrder" type="number" value="0" class="form-control" />
                                </div>
                                <div class="col-md-2">
                                    <label class="form-check mt-4">
                                        <input name="RequiresControl" type="checkbox" value="true" class="form-check-input" />
                                        <input name="RequiresControl" type="hidden" value="false" />
                                        <span class="form-check-label">Kontrola</span>
                                    </label>
                                </div>
                                <div class="col-md-2">
                                    <input name="ControlType" class="form-control" placeholder="Typ kontroli" maxlength="80" />
                                </div>
                                <div class="col-md-1">
                                    <input name="ExpectedValue" type="number" step="0.001" class="form-control" placeholder="Wart." />
                                </div>
                                <div class="col-md-1">
                                    <button type="submit" class="btn btn-primary w-100">+</button>
                                </div>
                            </form>
                        }
                    </div>
                }
                @if (Model.Status == "Draft")
                {
                    <form asp-controller="RecipeComponents" asp-action="SaveInstructionSection" asp-route-componentId="@Model.RecipeComponentId" asp-route-versionId="@Model.Id" method="post" class="row g-2 align-items-end">
                        @Html.AntiForgeryToken()
                        <div class="col-md-8">
                            <label class="form-label">Nowa sekcja</label>
                            <input name="Title" class="form-control" maxlength="200" />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">Lp.</label>
                            <input name="SortOrder" type="number" value="0" class="form-control" />
                        </div>
                        <div class="col-md-2">
                            <button type="submit" class="btn btn-primary w-100">Dodaj sekcje</button>
                        </div>
                    </form>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-5">
        <div class="card card-premium">
            <div class="card-header">
                <h3 class="card-title">Opakowania</h3>
            </div>
            <div class="table-responsive">
                <table class="table table-vcenter card-table">
                    <thead>
                        <tr>
                            <th>Nazwa</th>
                            <th>Ilosc</th>
                            <th class="w-1"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var packaging in Model.PackagingRequirements)
                        {
                            <tr>
                                <td>
                                    <div class="fw-bold">@packaging.ResourceName</div>
                                    <div class="text-secondary small">@packaging.ContainerRole</div>
                                </td>
                                <td>@packaging.Quantity @packaging.Unit</td>
                                <td>
                                    @if (Model.Status == "Draft")
                                    {
                                        <form asp-controller="RecipeComponents" asp-action="DeletePackaging" asp-route-componentId="@Model.RecipeComponentId" asp-route-versionId="@Model.Id" asp-route-packagingId="@packaging.Id" method="post">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-danger">Usun</button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            @if (Model.Status == "Draft")
            {
                <div class="card-body border-top">
                    <form asp-controller="RecipeComponents" asp-action="SavePackaging" asp-route-componentId="@Model.RecipeComponentId" asp-route-versionId="@Model.Id" method="post" class="row g-2">
                        @Html.AntiForgeryToken()
                        <div class="col-md-5">
                            <input name="ResourceName" class="form-control" placeholder="Nazwa" required maxlength="200" />
                        </div>
                        <div class="col-md-3">
                            <input name="Quantity" type="number" step="0.001" min="0" value="1" class="form-control" />
                        </div>
                        <div class="col-md-4">
                            <input id="componentPackagingCategorySearch" type="search" class="form-control mb-1" placeholder="Szukaj kategorii" autocomplete="off" />
                            <select id="componentPackagingCategory" name="WarehouseCategoryId" class="form-select" data-placeholder="Kategoria">
                                <option value="">Kategoria</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <input name="Unit" value="pcs" class="form-control" maxlength="20" />
                        </div>
                        <div class="col-md-5">
                            <input name="ContainerRole" class="form-control" placeholder="Rola pojemnika" maxlength="80" />
                        </div>
                        <div class="col-md-3">
                            <button type="submit" class="btn btn-primary w-100">Dodaj</button>
                        </div>
                    </form>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (() => {
            const clearAndFill = (select, items, currentValue) => {
                const placeholder = select.dataset.placeholder || "Wybierz";
                const selectedText = select.options[select.selectedIndex]?.text;
                select.innerHTML = `<option value="">${placeholder}</option>`;

                if (currentValue && !items.some(item => `${item.id}` === currentValue)) {
                    select.add(new Option(selectedText, currentValue, true, true));
                }

                items.forEach(item => {
                    const option = new Option(item.text, item.id, false, `${item.id}` === currentValue);
                    if (item.stockItemId) option.dataset.stockItemId = item.stockItemId;
                    if (item.warehouseCategoryId) option.dataset.warehouseCategoryId = item.warehouseCategoryId;
                    if (item.warehouseCategoryName) option.dataset.warehouseCategoryName = item.warehouseCategoryName;
                    select.add(option);
                });
            };

            const wireLookup = (searchId, selectId, url) => {
                const search = document.getElementById(searchId);
                const select = document.getElementById(selectId);
                if (!search || !select) return;

                let timeoutId;
                const load = async () => {
                    const response = await fetch(`${url}?term=${encodeURIComponent(search.value)}`);
                    const items = await response.json();
                    clearAndFill(select, items, select.value);
                };

                search.addEventListener("input", () => {
                    window.clearTimeout(timeoutId);
                    timeoutId = window.setTimeout(load, 250);
                });
                search.addEventListener("focus", load);
            };

            const wireIngredientLookup = () => {
                const search = document.getElementById("componentIngredientSearch");
                const select = document.getElementById("componentIngredientSelect");
                const categorySelect = document.getElementById("componentIngredientCategory");
                const stockInput = document.getElementById("componentIngredientStockItemId");
                if (!search || !select || !categorySelect || !stockInput) return;

                let timeoutId;
                const load = async () => {
                    const response = await fetch(`/diet-editor/recipe-components/lookups/ingredients?term=${encodeURIComponent(search.value)}`);
                    const items = await response.json();
                    clearAndFill(select, items, select.value);
                };

                select.addEventListener("change", () => {
                    const option = select.options[select.selectedIndex];
                    stockInput.value = option?.dataset.stockItemId || "";
                    const categoryId = option?.dataset.warehouseCategoryId || "";
                    const categoryName = option?.dataset.warehouseCategoryName || "";
                    if (categoryId) {
                        categorySelect.innerHTML = `<option value="${categoryId}" selected>${categoryName || "Kategoria"}</option>`;
                    }
                });

                search.addEventListener("input", () => {
                    window.clearTimeout(timeoutId);
                    timeoutId = window.setTimeout(load, 250);
                });
                search.addEventListener("focus", load);
            };

            wireIngredientLookup();
            wireLookup("componentIngredientCategorySearch", "componentIngredientCategory", "/diet-editor/recipe-components/lookups/warehouse-categories");
            wireLookup("componentPackagingCategorySearch", "componentPackagingCategory", "/diet-editor/recipe-components/lookups/warehouse-categories");
        })();
    </script>
}
