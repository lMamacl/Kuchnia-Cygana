@model CustomerSupportDashboardViewModel
@{
    Layout = "_LayoutStaff";
    var ticketsPage = Model.TicketsPage;
    var clientUsers = Model.Users
        .Where(user => string.Equals(user.Role, "Client", StringComparison.Ordinal))
        .OrderBy(user => user.FullName)
        .ToArray();
    var supportUsers = Model.Users
        .Where(user => user.Role is "BOK" or "BOKManager" or "Admin")
        .OrderBy(user => user.FullName)
        .ToArray();

    string PriorityClass(string priority) => priority switch
    {
        "Critical" => "bg-red-lt text-red",
        "High" => "bg-orange-lt text-orange",
        "Medium" => "bg-blue-lt text-blue",
        _ => "bg-secondary-lt text-secondary",
    };

    string StatusClass(string status) => status switch
    {
        "Resolved" or "Closed" => "bg-green-lt text-green",
        "Pending" => "bg-yellow-lt text-yellow",
        "Open" => "bg-blue-lt text-blue",
        _ => "bg-secondary-lt text-secondary",
    };
}

<div class="row row-cards">
    <div class="col-xl-4">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">Nowe zgloszenie</h3>
            </div>
            <form asp-action="CreateTicket" method="post">
                @Html.AntiForgeryToken()
                <div class="card-body">
                    <div class="mb-3">
                        <label class="form-label" for="ticket-client">Klient</label>
                        <select id="ticket-client" class="form-select" name="ClientUserId" required>
                            <option value="">Wybierz klienta</option>
                            @foreach (var user in clientUsers)
                            {
                                <option value="@user.Id" selected="@(Model.NewTicket.ClientUserId == user.Id)">@user.FullName (@user.Email)</option>
                            }
                        </select>
                        @if (clientUsers.Length == 0)
                        {
                            <div class="form-hint text-warning">Brak kont klienckich w bazie.</div>
                        }
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="ticket-title">Tytul</label>
                        <input id="ticket-title" class="form-control" name="Title" value="@Model.NewTicket.Title" maxlength="200" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="ticket-priority">Priorytet</label>
                        <select id="ticket-priority" class="form-select" name="Priority">
                            @foreach (var priority in Enum.GetValues<TicketPriority>())
                            {
                                <option value="@priority" selected="@(Model.NewTicket.Priority == priority)">@priority</option>
                            }
                        </select>
                    </div>
                    <div class="mb-0">
                        <label class="form-label" for="ticket-description">Opis</label>
                        <textarea id="ticket-description" class="form-control" name="Description" rows="5" required>@Model.NewTicket.Description</textarea>
                    </div>
                </div>
                <div class="card-footer text-end">
                    <button class="btn btn-primary" type="submit">Dodaj zgloszenie</button>
                </div>
            </form>
        </div>
    </div>
    <div class="col-xl-8">
        <div class="card">
            <div class="card-header d-flex flex-wrap align-items-center justify-content-between gap-2">
                <h3 class="card-title">Zgloszenia</h3>
                <span class="text-secondary small">Pokazuje @ticketsPage.FirstItem-@ticketsPage.LastItem z @ticketsPage.TotalCount</span>
            </div>
            <div class="table-responsive">
                <table class="table table-vcenter card-table">
                    <thead>
                        <tr>
                            <th>Zgloszenie</th>
                            <th>Klient</th>
                            <th>Status</th>
                            <th>Priorytet</th>
                            <th>Przypisane</th>
                            <th class="text-end">Akcje</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var ticket in ticketsPage.Items)
                        {
                            <tr>
                                <td>
                                    <div class="fw-semibold">@ticket.Title</div>
                                    <div class="text-secondary small">@ticket.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</div>
                                    <div class="text-secondary small">
                                        @(ticket.Description.Length > 100 ? ticket.Description[..100] + "..." : ticket.Description)
                                    </div>
                                </td>
                                <td>@(ticket.ClientFullName ?? $"#{ticket.ClientUserId}")</td>
                                <td><span class="badge @StatusClass(ticket.Status)">@ticket.Status</span></td>
                                <td><span class="badge @PriorityClass(ticket.Priority)">@ticket.Priority</span></td>
                                <td>@(ticket.AssignedToFullName ?? "-")</td>
                                <td class="text-end">
                                    <div class="d-inline-flex flex-wrap justify-content-end gap-2">
                                        <form asp-action="AssignTicket" asp-route-id="@ticket.Id" method="post" class="d-inline-flex gap-2">
                                            @Html.AntiForgeryToken()
                                            <select class="form-select form-select-sm" name="assignedToUserId" required>
                                                <option value="">Pracownik</option>
                                                @foreach (var user in supportUsers)
                                                {
                                                    <option value="@user.Id" selected="@(ticket.AssignedToUserId == user.Id)">@user.FullName</option>
                                                }
                                            </select>
                                            <button class="btn btn-sm btn-outline-primary" type="submit">Przypisz</button>
                                        </form>
                                        <form asp-action="ChangeTicketStatus" asp-route-id="@ticket.Id" method="post" class="d-inline-flex gap-2">
                                            @Html.AntiForgeryToken()
                                            <select class="form-select form-select-sm" name="status">
                                                @foreach (var status in Enum.GetValues<TicketStatus>())
                                                {
                                                    <option value="@status" selected="@(string.Equals(ticket.Status, status.ToString(), StringComparison.Ordinal))">@status</option>
                                                }
                                            </select>
                                            <button class="btn btn-sm btn-outline-secondary" type="submit">Zmien</button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                        @if (ticketsPage.TotalCount == 0)
                        {
                            <tr>
                                <td colspan="6" class="text-secondary text-center py-4">
                                    Brak zgloszen w bazie. Seeder dodaje startowa kolejke BOK dla kont klienckich.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            @if (ticketsPage.TotalCount > 0)
            {
                <div class="card-footer d-flex flex-wrap align-items-center justify-content-between gap-2">
                    <span class="text-secondary small">Strona @ticketsPage.Page / @ticketsPage.TotalPages, po @ticketsPage.PageSize rekordow</span>
                    <div class="btn-list">
                        <a class="btn btn-outline-secondary @(ticketsPage.HasPrevious ? string.Empty : "disabled")"
                           asp-controller="CustomerSupport"
                           asp-action="Tickets"
                           asp-route-page="@ticketsPage.PreviousPage"
                           asp-route-pageSize="@ticketsPage.PageSize">Poprzednia</a>
                        <a class="btn btn-outline-secondary @(ticketsPage.HasNext ? string.Empty : "disabled")"
                           asp-controller="CustomerSupport"
                           asp-action="Tickets"
                           asp-route-page="@ticketsPage.NextPage"
                           asp-route-pageSize="@ticketsPage.PageSize">Nastepna</a>
                    </div>
                </div>
            }
        </div>
    </div>
</div>
