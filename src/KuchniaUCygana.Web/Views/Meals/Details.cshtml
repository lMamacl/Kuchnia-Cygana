@model KuchniaUCygana.Application.DTOs.Menu.MealDetailDto
@{
    Layout = "_LayoutStaff";
    ViewData["Title"] = $"Posiłek #{Model.Id}";
    ViewData["Section"] = "Katalog Menu";
    ViewData["Description"] = "Zarządzanie recepturą, zdjęciami i opisami AI potrawy.";
}

@{
    var componentVersions = ViewBag.ComponentVersions as IEnumerable<KuchniaUCygana.Application.DTOs.Menu.RecipeComponentVersionOptionDto>
        ?? Enumerable.Empty<KuchniaUCygana.Application.DTOs.Menu.RecipeComponentVersionOptionDto>();
}

<div class="row row-cards">
    <div class="col-lg-8">
        <div class="card card-premium">
            <div class="card-body">
                <div class="row align-items-center mb-3">
                    <div class="col">
                        <h2 class="h1 mb-0 text-dark">@Model.Name</h2>
                        <span class="badge bg-indigo-lt text-indigo mt-2">Kategoria: @Model.CategoryId</span>
                    </div>
                    <div class="col-auto">
                        <span class="badge bg-secondary">Status: @Model.Status</span>
                    </div>
                </div>

                <h4 class="mt-4 mb-2 text-primary">Opis marketingowy (AI/Ręczny)</h4>
                @if (string.IsNullOrWhiteSpace(Model.MarketingDescription))
                {
                    <div class="alert alert-warning mb-3">
                        Brak opisu marketingowego. Możesz wygenerować go automatycznie za pomocą AI.
                    </div>
                }
                else
                {
                    <div class="bg-light p-3 border rounded mb-3">
                        @Model.MarketingDescription
                    </div>
                }

                <form asp-action="GenerateDescription" asp-route-mealId="@Model.Id" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-indigo btn-sm">
                        <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none" /><path d="M4 20l10 -10m0 -5v5h5m-9 -1v5h5m-9 -1v5h5" /><path d="M13 5l1 3l3 1l-3 1l-1 3l-1 -3l-3 -1l3 -1z" /></svg>
                        Generuj Opis AI (Smart Content)
                    </button>
                </form>
            </div>
        </div>

        <div class="card card-premium mt-3">
            <div class="card-header">
                <h3 class="card-title">Przepisy-składowe</h3>
            </div>
            <div class="card-body">
                @if (!Model.Components.Any())
                {
                    <div class="alert alert-warning mb-0">
                        Brak wersjonowanych składowych. Do czasu migracji M2 ten posiłek może korzystać z legacy `Recipes`.
                    </div>
                }
                else
                {
                    <div class="accordion" id="mealComponents">
                        @foreach (var component in Model.Components)
                        {
                            var collapseId = $"component-{component.RecipeComponentVersionId}";
                            <div class="accordion-item">
                                <h2 class="accordion-header" id="heading-@collapseId">
                                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#@collapseId" aria-expanded="false" aria-controls="@collapseId">
                                        <span class="me-2 fw-bold">@component.ComponentName</span>
                                        <span class="badge bg-blue-lt text-blue me-2">v@component.VersionNumber</span>
                                        <span class="badge bg-secondary-lt text-secondary">@component.VersionStatus</span>
                                    </button>
                                </h2>
                                <div id="@collapseId" class="accordion-collapse collapse" aria-labelledby="heading-@collapseId" data-bs-parent="#mealComponents">
                                    <div class="accordion-body">
                                        <div class="d-flex flex-wrap gap-2 mb-3">
                                            <span class="badge bg-indigo-lt text-indigo">Rola: @(component.Role ?? "składowa")</span>
                                            <span class="badge bg-green-lt text-green">Ilość: @component.QuantityPerServing.ToString("0.###") @component.Unit</span>
                                            @if (component.ShelfLifeHours.HasValue)
                                            {
                                                <span class="badge bg-orange-lt text-orange">Shelf-life: @component.ShelfLifeHours h</span>
                                            }
                                            @if (component.UseEarliestIngredientExpiry)
                                            {
                                                <span class="badge bg-red-lt text-red">Ważność z najwcześniejszego surowca</span>
                                            }
                                            @if (!component.IsLegacyFallback)
                                            {
                                                <a asp-controller="RecipeComponents" asp-action="Version" asp-route-componentId="@component.RecipeComponentId" asp-route-versionId="@component.RecipeComponentVersionId" class="btn btn-sm btn-outline-primary ms-auto">Szczegóły</a>
                                            }
                                        </div>

                                        @if (!string.IsNullOrWhiteSpace(component.Instructions))
                                        {
                                            <div class="bg-light p-3 border rounded mb-3">@component.Instructions</div>
                                        }

                                        <div class="table-responsive">
                                            <table class="table table-vcenter table-sm">
                                                <thead>
                                                    <tr>
                                                        <th>Składnik</th>
                                                        <th>Mapowanie</th>
                                                        <th class="text-end">Gramatura</th>
                                                        <th class="text-center">Opcjonalny</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @if (!component.Ingredients.Any())
                                                    {
                                                        <tr><td colspan="4" class="text-center text-muted">Brak składników w składowej.</td></tr>
                                                    }
                                                    @foreach (var ingredient in component.Ingredients)
                                                    {
                                                        <tr>
                                                            <td class="fw-bold">@ingredient.IngredientName (ID: @ingredient.IngredientId)</td>
                                                            <td>
                                                                @if (ingredient.WarehouseCategoryId.HasValue)
                                                                {
                                                                    <span class="badge bg-green-lt text-green">Kategoria: @(ingredient.WarehouseCategoryName ?? ingredient.WarehouseCategoryId.ToString())</span>
                                                                }
                                                                else
                                                                {
                                                                    <span class="badge bg-red-lt text-red">Brak kategorii</span>
                                                                }
                                                                @if (ingredient.StockItemId.HasValue)
                                                                {
                                                                    <span class="badge bg-blue-lt text-blue">StockItem: @ingredient.StockItemId</span>
                                                                }
                                                            </td>
                                                            <td class="text-end">@ingredient.WeightInGrams.ToString("F2") g</td>
                                                            <td class="text-center">
                                                                @if (ingredient.IsOptional)
                                                                {
                                                                    <span class="badge bg-yellow-lt text-yellow">Tak</span>
                                                                }
                                                            </td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
            <div class="card-body border-top">
                <form asp-controller="RecipeComponents" asp-action="AttachToMeal" method="post" class="row g-2 align-items-end">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="MealId" value="@Model.Id" />
                    <div class="col-md-4">
                        <label class="form-label">Dodaj skladowa</label>
                        <select name="RecipeComponentVersionId" class="form-select" required>
                            <option value="">Wybierz wersje</option>
                            @foreach (var option in componentVersions)
                            {
                                <option value="@option.RecipeComponentVersionId">@option.ComponentName v@option.VersionNumber</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Rola</label>
                        <input name="Role" class="form-control" maxlength="80" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Ilosc</label>
                        <input name="QuantityPerServing" type="number" step="0.001" min="0" value="1" class="form-control" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Kolejnosc</label>
                        <input name="SortOrder" type="number" value="0" class="form-control" />
                    </div>
                    <div class="col-md-2">
                        <button type="submit" class="btn btn-primary w-100">Dodaj</button>
                    </div>
                </form>
            </div>
        </div>

        <div class="card card-premium mt-3">
            <div class="card-header">
                <h3 class="card-title">Warianty dania</h3>
            </div>
            <div class="card-body">
                @if (!Model.Variants.Any())
                {
                    <div class="alert alert-warning mb-3">Brak wariantow technologicznych dania.</div>
                }
                else
                {
                    <div class="table-responsive mb-3">
                        <table class="table table-vcenter table-sm">
                            <thead>
                                <tr>
                                    <th>Nazwa</th>
                                    <th>Status</th>
                                    <th>Gramatura</th>
                                    <th>Kompletnosc</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var variant in Model.Variants)
                                {
                                    <tr>
                                        <td>
                                            <div class="fw-bold">@variant.Name</div>
                                            <div class="text-secondary small">@variant.VariantType @(variant.IsDefault ? "/ domyslny" : "")</div>
                                        </td>
                                        <td><span class="badge bg-blue-lt">@variant.Status</span></td>
                                        <td>@variant.CookedWeightGrams g</td>
                                        <td>
                                            @if (variant.IsComplete)
                                            {
                                                <span class="badge bg-success-lt text-success">Kompletny</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-warning-lt text-warning">@variant.ValidationWarnings.Count brakow</span>
                                                <div class="text-secondary small">@string.Join("; ", variant.ValidationWarnings)</div>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }

                <form asp-action="CreateVariant" asp-route-mealId="@Model.Id" method="post" class="row g-2 align-items-end">
                    @Html.AntiForgeryToken()
                    <div class="col-md-4">
                        <label class="form-label">Nazwa wariantu</label>
                        <input name="Name" class="form-control" placeholder="np. High protein" required maxlength="160" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Typ</label>
                        <select name="VariantType" class="form-select">
                            <option value="Weight">Wagowy</option>
                            <option value="Allergy">Alergiczny</option>
                            <option value="HighProtein">High protein</option>
                            <option value="LowCarb">Low carb</option>
                            <option value="Standard">Standard</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Kopiuj z</label>
                        <select name="SourceMealVariantId" class="form-select">
                            <option value="">Domyslny wariant</option>
                            @foreach (var variant in Model.Variants)
                            {
                                <option value="@variant.Id">@variant.Name</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-2">
                        <button type="submit" class="btn btn-primary w-100">Dodaj wariant</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card card-premium">
            <div class="card-header">
                <h3 class="card-title">Galeria potrawy</h3>
            </div>
            <div class="card-body">
                @if (!Model.Images.Any())
                {
                    <div class="text-center p-3 text-muted border border-dashed rounded mb-3">
                        <svg xmlns="http://www.w3.org/2000/svg" class="icon icon-lg text-muted mb-2" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none"><path stroke="none" d="M0 0h24v24H0z" fill="none" /><path d="M15 8h.01" /><path d="M11.5 21h-5.5a3 3 0 0 1 -3 -3v-12a3 3 0 0 1 3 -3h12a3 3 0 0 1 3 3v5.5" /><path d="M3 16l5 -5c.928 -.893 2.072 -.893 3 0l4 4" /><path d="M14 14l1 -1c.928 -.893 2.072 -.893 3 0" /></svg>
                        <br />Brak zdjęć
                    </div>
                }
                else
                {
                    <div class="row g-2 mb-3">
                        @foreach (var img in Model.Images)
                        {
                            <div class="col-6 position-relative">
                                <img src="@img.Url" class="img-fluid rounded border @(img.IsMain ? "border-primary border-2" : "")" alt="Zdjęcie posiłku" />
                                @if (img.IsMain)
                                {
                                    <span class="badge bg-primary position-absolute top-0 start-0 m-1">Główne</span>
                                }
                                <div class="mt-1 d-flex gap-1 justify-content-center">
                                    @if (!img.IsMain)
                                    {
                                        <form asp-action="SetMainImage" asp-route-imageId="@img.Id" method="post">
                                            <input type="hidden" name="mealId" value="@Model.Id" />
                                            <button type="submit" class="btn btn-xs btn-outline-primary" title="Ustaw jako główne">🌟</button>
                                        </form>
                                    }
                                    <form asp-action="DeleteImage" asp-route-imageId="@img.Id" method="post" onsubmit="return confirm('Usunąć to zdjęcie?');">
                                        <input type="hidden" name="mealId" value="@Model.Id" />
                                        <button type="submit" class="btn btn-xs btn-outline-danger" title="Usuń">🗑</button>
                                    </form>
                                </div>
                            </div>
                        }
                    </div>
                }

                <form asp-action="UploadImage" asp-route-mealId="@Model.Id" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <div class="mb-3">
                        <label class="form-label">Dodaj nowe zdjęcie</label>
                        <input type="file" name="file" class="form-control" accept="image/*" required />
                    </div>
                    <div class="form-check mb-3">
                        <input class="form-check-input" type="checkbox" name="isMain" value="true" id="isMainCheck">
                        <label class="form-check-label" for="isMainCheck">
                            Ustaw jako zdjęcie główne
                        </label>
                    </div>
                    <button type="submit" class="btn btn-primary w-100">Wgraj plik</button>
                </form>
            </div>
        </div>

        <div class="card mt-3 border-0 bg-transparent shadow-none">
            <div class="card-body p-0">
                <a asp-action="Index" class="btn btn-outline-secondary w-100">Powrót do listy</a>
            </div>
        </div>
    </div>
</div>
