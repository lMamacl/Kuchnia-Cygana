@model KuchniaUCygana.Application.DTOs.Menu.MealDetailDto
@{
    Layout = "_LayoutStaff";
    ViewData["Title"] = $"Posiłek #{Model.Id}";
    ViewData["Section"] = "Katalog Menu";
    ViewData["Description"] = "Zarządzanie recepturą, zdjęciami i opisami AI potrawy.";
}

<div class="row row-cards">
    <div class="col-lg-8">
        <div class="card card-premium">
            <div class="card-body">
                <div class="row align-items-center mb-3">
                    <div class="col">
                        <h2 class="h1 mb-0 text-dark">@Model.Name</h2>
                        <span class="badge bg-indigo-lt text-indigo mt-2">Kategoria: @Model.CategoryId</span>
                    </div>
                    <div class="col-auto">
                        <span class="badge bg-secondary">Status: @Model.Status</span>
                    </div>
                </div>

                <h4 class="mt-4 mb-2 text-primary">Opis marketingowy (AI/Ręczny)</h4>
                @if (string.IsNullOrWhiteSpace(Model.MarketingDescription))
                {
                    <div class="alert alert-warning mb-3">
                        Brak opisu marketingowego. Możesz wygenerować go automatycznie za pomocą AI.
                    </div>
                }
                else
                {
                    <div class="bg-light p-3 border rounded mb-3">
                        @Model.MarketingDescription
                    </div>
                }

                <form asp-action="GenerateDescription" asp-route-mealId="@Model.Id" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-indigo btn-sm">
                        <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none" /><path d="M4 20l10 -10m0 -5v5h5m-9 -1v5h5m-9 -1v5h5" /><path d="M13 5l1 3l3 1l-3 1l-1 3l-1 -3l-3 -1l3 -1z" /></svg>
                        Generuj Opis AI (Smart Content)
                    </button>
                </form>
            </div>
        </div>

        <div class="card card-premium mt-3">
            <div class="card-header">
                <h3 class="card-title">Receptura (Składniki)</h3>
            </div>
            <div class="table-responsive">
                <table class="table table-vcenter card-table table-premium">
                    <thead>
                        <tr>
                            <th>Składnik</th>
                            <th class="text-end">Gramatura</th>
                            <th class="text-center">Opcjonalny</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Recipe.Any())
                        {
                            <tr><td colspan="3" class="text-center text-muted">Brak przypisanych składników. Skonfiguruj recepturę.</td></tr>
                        }
                        @foreach (var item in Model.Recipe)
                        {
                            <tr>
                                <td class="fw-bold">@item.IngredientName (ID: @item.IngredientId)</td>
                                <td class="text-end">@item.WeightInGrams.ToString("F2") g</td>
                                <td class="text-center">
                                    @if (item.IsOptional)
                                    {
                                        <span class="badge bg-yellow-lt text-yellow">Tak</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card card-premium">
            <div class="card-header">
                <h3 class="card-title">Galeria potrawy</h3>
            </div>
            <div class="card-body">
                @if (!Model.Images.Any())
                {
                    <div class="text-center p-3 text-muted border border-dashed rounded mb-3">
                        <svg xmlns="http://www.w3.org/2000/svg" class="icon icon-lg text-muted mb-2" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none"><path stroke="none" d="M0 0h24v24H0z" fill="none" /><path d="M15 8h.01" /><path d="M11.5 21h-5.5a3 3 0 0 1 -3 -3v-12a3 3 0 0 1 3 -3h12a3 3 0 0 1 3 3v5.5" /><path d="M3 16l5 -5c.928 -.893 2.072 -.893 3 0l4 4" /><path d="M14 14l1 -1c.928 -.893 2.072 -.893 3 0" /></svg>
                        <br />Brak zdjęć
                    </div>
                }
                else
                {
                    <div class="row g-2 mb-3">
                        @foreach (var img in Model.Images)
                        {
                            <div class="col-6 position-relative">
                                <img src="@img.Url" class="img-fluid rounded border @(img.IsMain ? "border-primary border-2" : "")" alt="Zdjęcie posiłku" />
                                @if (img.IsMain)
                                {
                                    <span class="badge bg-primary position-absolute top-0 start-0 m-1">Główne</span>
                                }
                                <div class="mt-1 d-flex gap-1 justify-content-center">
                                    @if (!img.IsMain)
                                    {
                                        <form asp-action="SetMainImage" asp-route-imageId="@img.Id" method="post">
                                            <input type="hidden" name="mealId" value="@Model.Id" />
                                            <button type="submit" class="btn btn-xs btn-outline-primary" title="Ustaw jako główne">🌟</button>
                                        </form>
                                    }
                                    <form asp-action="DeleteImage" asp-route-imageId="@img.Id" method="post" onsubmit="return confirm('Usunąć to zdjęcie?');">
                                        <input type="hidden" name="mealId" value="@Model.Id" />
                                        <button type="submit" class="btn btn-xs btn-outline-danger" title="Usuń">🗑</button>
                                    </form>
                                </div>
                            </div>
                        }
                    </div>
                }

                <form asp-action="UploadImage" asp-route-mealId="@Model.Id" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <div class="mb-3">
                        <label class="form-label">Dodaj nowe zdjęcie</label>
                        <input type="file" name="file" class="form-control" accept="image/*" required />
                    </div>
                    <div class="form-check mb-3">
                        <input class="form-check-input" type="checkbox" name="isMain" value="true" id="isMainCheck">
                        <label class="form-check-label" for="isMainCheck">
                            Ustaw jako zdjęcie główne
                        </label>
                    </div>
                    <button type="submit" class="btn btn-primary w-100">Wgraj plik</button>
                </form>
            </div>
        </div>

        <div class="card mt-3 border-0 bg-transparent shadow-none">
            <div class="card-body p-0">
                <a asp-action="Index" class="btn btn-outline-secondary w-100">Powrót do listy</a>
            </div>
        </div>
    </div>
</div>
