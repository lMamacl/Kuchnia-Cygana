@model IEnumerable<KuchniaUCygana.Application.DTOs.Menu.MealDto>
@{
    Layout = "_LayoutStaff";
    ViewData["Title"] = "Baza posiłków";
    ViewData["Section"] = "Katalog Menu";
    ViewData["Description"] = "Lista wszystkich potraw w katalogu cateringu.";
}

@functions {
    string GetStatusColor(string status) => status switch
    {
        "Draft" => "secondary",
        "Ready" => "azure",
        "Published" => "success",
        "Archived" => "danger",
        _ => "secondary"
    };

    string TranslateStatus(string status) => status switch
    {
        "Draft" => "Szkic",
        "Ready" => "Gotowy",
        "Published" => "Opublikowany",
        "Archived" => "Archiwum",
        _ => status
    };
}

<div class="row row-cards">
    <div class="col-12">
        <div class="card card-premium">
            <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
                <h3 class="card-title">Katalog Potraw</h3>
                <div class="btn-list">
                    <a asp-action="Create" class="btn btn-primary">
                        <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none" /><path d="M12 5l0 14" /><path d="M5 12l14 0" /></svg>
                        Nowy Posiłek
                    </a>
                </div>
            </div>

            <div class="table-responsive">
                <table class="table table-vcenter card-table table-premium">
                    <thead>
                        <tr>
                            <th class="w-1">ID</th>
                            <th>Nazwa posiłku</th>
                            <th>Czas (min)</th>
                            <th>Status</th>
                            <th class="w-1 text-end">Akcja</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var meal in Model)
                        {
                            var color = GetStatusColor(meal.Status);
                            <tr>
                                <td class="text-secondary font-weight-medium">#@meal.Id</td>
                                <td>
                                    <div class="font-weight-bold text-dark">@meal.Name</div>
                                    @if (!meal.IsActive)
                                    {
                                        <span class="badge bg-danger-lt text-danger mt-1">Nieaktywny</span>
                                    }
                                </td>
                                <td class="text-secondary">@meal.PreparationTimeMinutes min</td>
                                <td>
                                    <span class="badge bg-@color-lt text-@color d-inline-flex align-items-center gap-1">
                                        <span class="status-dot bg-@color" style="width: 6px; height: 6px;"></span>
                                        @TranslateStatus(meal.Status)
                                    </span>
                                </td>
                                <td>
                                    <div class="btn-list flex-nowrap justify-content-end">
                                        <a asp-action="Details" asp-route-id="@meal.Id" class="btn btn-sm btn-indigo">Zarządzaj</a>
                                        <a asp-action="Edit" asp-route-id="@meal.Id" class="btn btn-sm btn-outline-secondary">Edytuj</a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>