# ─────────────────────────────────────────────────────────────
#  .env.example — Szablon zmiennych środowiskowych
#  Skopiuj do .env i uzupełnij wartości: cp .env.example .env
#  NIGDY nie commituj .env do repozytorium!
# ─────────────────────────────────────────────────────────────

# Klucz JWT — minimum 32 znaki. Wygeneruj np. przez:
#   PowerShell: [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Max 256 }) -as [byte[]])
#   Bash:       openssl rand -base64 32
JWT_SECRET=

# Stripe (tryb testowy) — https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET=sk_test_...
STRIPE_PUBLISHABLE=pk_test_...

# OpenAI — https://platform.openai.com/api-keys
OPENAI_KEY=sk-...

# Opcjonalne — nadpisuje connection string z appsettings.json
# CONNECTION_STRING=Data Source=kuchniaucygana.db
